+    // ---- compact pills, VPN switch and weather (HeaderExtras) ---------------------------------------
+
+    /** This build's header keys, read from the theme next to Config. */
+    private HeaderExtras extras;
+    /** compact_pills, except with top_menu, whose lone gear stays as it is. */
+    private boolean compactPills;
+    /** compact_pills: each pill's label, shown only while the pill has focus. */
+    private final Map<TextView, CharSequence> pillLabels = new HashMap<>();
+
+    /** compact_pills: a round icon that opens out to {@code pill}'s label (or its description) while focused. */
+    private void makeCompact(TextView pill) {
+        CharSequence label = pill.getText();
+        pillLabels.put(pill, label != null && label.length() > 0 ? label : pill.getContentDescription());
+        View.OnFocusChangeListener previous = pill.getOnFocusChangeListener();
+        pill.setOnFocusChangeListener((v, focused) -> {
+            if (previous != null) previous.onFocusChange(v, focused);
+            showPillLabel(pill, focused, true);
+        });
+        showPillLabel(pill, pill.isFocused(), false);
+    }
+
+    /** compact_pills: the pill's label changed (network name, VPN state): keep it for focus, shown only while focused. */
+    private void setCompactLabel(TextView pill, CharSequence label) {
+        pillLabels.put(pill, label);
+        showPillLabel(pill, pill.isFocused(), false);
+    }
+
+    private void showPillLabel(TextView pill, boolean open, boolean animate) {
+        CharSequence label = pillLabels.get(pill);
+        if (label == null || label.length() == 0) open = false;
+        if (animate && animations && !reducedMotion && pill.getParent() instanceof ViewGroup) {
+            // The row is aligned to the right edge, so an opening pill grows to the left and its neighbours slide.
+            TransitionManager.beginDelayedTransition((ViewGroup) pill.getParent(), new ChangeBounds()
+                    .setDuration(200).setInterpolator(new PathInterpolator(0.2f, 0f, 0f, 1f)));
+        }
+        ViewGroup.LayoutParams lp = pill.getLayoutParams();
+        if (open) {
+            pill.setText(label);
+            pill.setContentDescription(null);
+            pill.setPaddingRelative(Math.round(16 * density), 0, Math.round(20 * density), 0);
+            pill.setCompoundDrawablePadding(Math.round(9 * density));
+            lp.width = ViewGroup.LayoutParams.WRAP_CONTENT;
+        } else {
+            pill.setContentDescription(label);
+            pill.setText(null);
+            int pad = Math.round(10 * density);
+            pill.setPaddingRelative(pad, 0, pad, 0);
+            pill.setCompoundDrawablePadding(0);
+            lp.width = Math.round(42 * density);
+        }
+        pill.setLayoutParams(lp);
+    }
+
+    /** How long a VPN switch may take before the pill gives up and opens the VPN app instead. */
+    private static final long VPN_TOGGLE_WAIT_MS = 6000;
+    /** The pill state when the switch was asked for; still the same after the wait means the app did not act. */
+    private int vpnToggleFrom;
+    private final Runnable vpnToggleCheck = () -> {
+        // No permission, its remote control switched off, no server chosen yet, or Android kept it from starting in
+        // the background: the app is where the VPN can be switched, so open it while Home is still in front.
+        if (vpnPillState == vpnToggleFrom && hasWindowFocus()) openVpnPill();
+    };
+
+    /** vpn_toggle: asks vpn_app to switch its VPN. False when the app has no way to be asked, so the caller opens it. */
+    private boolean toggleVpn() {
+        boolean up = vpnPillState == VpnBadge.PILL_UP;
+        if (!VpnControl.send(this, vpnApp, !up, extras.vpnTunnel)) return false;
+        Toast.makeText(this, up ? R.string.vpn_switching_off : R.string.vpn_switching_on, Toast.LENGTH_SHORT).show();
+        vpnToggleFrom = vpnPillState;
+        handler.removeCallbacks(vpnToggleCheck);
+        handler.postDelayed(vpnToggleCheck, VPN_TOGGLE_WAIT_MS);
+        return true;
+    }
+
+    private static final String WEATHER_PREFS = "weather";
+    /** A new reading every half hour; a failed one is tried again after five minutes. */
+    private static final long WEATHER_EVERY_MS = 30 * 60_000L, WEATHER_RETRY_MS = 5 * 60_000L;
+    /** A reading older than this is not shown at all: better no weather than yesterday's. */
+    private static final long WEATHER_KEEP_MS = 6 * 60 * 60_000L;
+    private TextView weatherView;
+    private ExecutorService weatherExecutor;
+    /** elapsedRealtime when the next fetch is due; 0 fetches at the first chance. */
+    private long weatherDueAt;
+    private boolean weatherFetching;
+
+    /** The last reading, kept across restarts, so the line is there at once instead of after the first fetch. */
+    private void showCachedWeather() {
+        SharedPreferences prefs = getSharedPreferences(WEATHER_PREFS, MODE_PRIVATE);
+        String body = prefs.getString("body", null);
+        if (body != null) showWeather(body, prefs.getLong("at", 0));
+    }
+
+    private void refreshWeatherIfDue() {
+        long now = SystemClock.elapsedRealtime();
+        if (weatherFetching || now < weatherDueAt) return;
+        weatherFetching = true;
+        if (weatherExecutor == null) weatherExecutor = Executors.newSingleThreadExecutor();
+        double lat = extras.weatherLat, lon = extras.weatherLon;
+        weatherExecutor.execute(() -> {
+            String body;
+            try {
+                body = Weather.fetch(lat, lon);
+                Weather.parse(body);   // only a reading that parses replaces the cached one
+            } catch (IOException | JSONException | RuntimeException e) {
+                Log.w("Weather", "no reading: " + e.getMessage());
+                body = null;
+            }
+            String reading = body;
+            handler.post(() -> {
+                weatherFetching = false;
+                weatherDueAt = SystemClock.elapsedRealtime() + (reading != null ? WEATHER_EVERY_MS : WEATHER_RETRY_MS);
+                if (reading == null || isDestroyed()) {
+                    if (!isDestroyed()) showCachedWeather();   // hides a cached reading that has grown too old
+                    return;
+                }
+                long at = System.currentTimeMillis();
+                getSharedPreferences(WEATHER_PREFS, MODE_PRIVATE).edit()
+                        .putString("body", reading).putLong("at", at).apply();
+                showWeather(reading, at);
+            });
+        });
+    }
+
+    /**
+     * The weather block: the icon and "+7°", and under them "ПЕРЕМЕННАЯ ОБЛАЧНОСТЬ · МОСКВА". The Hebrew layout has no
+     * block, only the one line, which then holds all of it with the temperature in white and a little larger.
+     */
+    private void showWeather(String body, long at) {
+        TextView now = findViewById(R.id.weatherNow);
+        View shown = now != null ? (View) now.getParent() : weatherView;
+        Weather w;
+        try {
+            w = Weather.parse(body);
+        } catch (JSONException e) {
+            shown.setVisibility(View.GONE);
+            return;
+        }
+        if (Math.abs(System.currentTimeMillis() - at) > WEATHER_KEEP_MS) {
+            shown.setVisibility(View.GONE);
+            return;
+        }
+        String temperature = Weather.temperature(w.temperature);
+        String conditions = getString(w.label());
+        if (!extras.weatherCity.isEmpty()) conditions += "  ·  " + extras.weatherCity;
+        conditions = conditions.toUpperCase(Locale.getDefault());
+        Drawable icon = getDrawable(w.icon());
+        if (icon != null) {
+            int size = Math.round((now != null ? 28 : 22) * density);
+            icon.setBounds(0, 0, size, size);
+        }
+        if (now != null) {
+            now.setText(temperature);
+            now.setCompoundDrawablesRelative(icon, null, null, null);
+            weatherView.setText(conditions);
+        } else {
+            SpannableString text = new SpannableString(temperature + "  " + conditions);
+            text.setSpan(new ForegroundColorSpan(0xFFFFFFFF), 0, temperature.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            text.setSpan(new RelativeSizeSpan(1.25f), 0, temperature.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            weatherView.setText(text);
