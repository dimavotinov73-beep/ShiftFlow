diff --git a/launcher/app/src/test/java/com/gathin/tvhome/HeaderExtrasTest.java b/launcher/app/src/test/java/com/gathin/tvhome/HeaderExtrasTest.java
new file mode 100644
index 0000000..015ebb5
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/HeaderExtrasTest.java
@@ -0,0 +1,53 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.junit.Test;
+
+public class HeaderExtrasTest {
+
+    @Test
+    public void noThemeKeepsEverythingOff() {
+        HeaderExtras e = HeaderExtras.from(null);
+        assertFalse(e.compactPills);
+        assertFalse(e.vpnToggle);
+        assertFalse(e.weather());
+        assertEquals("", e.vpnTunnel);
+        assertEquals("", e.weatherCity);
+    }
+
+    @Test
+    public void readsEveryKey() throws JSONException {
+        HeaderExtras e = HeaderExtras.from(new JSONObject("{\"compact_pills\":true,\"vpn_toggle\":true,"
+                + "\"vpn_tunnel\":\" home \",\"weather_lat\":55.7558,\"weather_lon\":37.6173,\"weather_city\":\"Москва\"}"));
+        assertTrue(e.compactPills);
+        assertTrue(e.vpnToggle);
+        assertEquals("home", e.vpnTunnel);
+        assertTrue(e.weather());
+        assertEquals(55.7558, e.weatherLat, 1e-9);
+        assertEquals(37.6173, e.weatherLon, 1e-9);
+        assertEquals("Москва", e.weatherCity);
+    }
+
+    @Test
+    public void wrongTypesAreIgnored() throws JSONException {
+        HeaderExtras e = HeaderExtras.from(new JSONObject("{\"compact_pills\":\"yes\",\"vpn_toggle\":1,"
+                + "\"weather_lat\":\"55.7\",\"weather_lon\":37.6}"));
+        assertFalse(e.compactPills);
+        assertFalse(e.vpnToggle);
+        assertFalse(e.weather());
+    }
+
+    @Test
+    public void bothCoordinatesInRangeOrNoWeather() throws JSONException {
+        assertFalse(HeaderExtras.from(new JSONObject("{\"weather_lat\":95,\"weather_lon\":37.6}")).weather());
+        assertFalse(HeaderExtras.from(new JSONObject("{\"weather_lat\":55.7,\"weather_lon\":-181}")).weather());
+        assertFalse(HeaderExtras.from(new JSONObject("{\"weather_lat\":55.7}")).weather());
+        assertTrue(HeaderExtras.from(new JSONObject("{\"weather_lat\":-33.9,\"weather_lon\":-180}")).weather());
+        assertTrue(HeaderExtras.from(new JSONObject("{\"weather_lat\":0,\"weather_lon\":0}")).weather());
+    }
+}
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/WeatherTest.java b/launcher/app/src/test/java/com/gathin/tvhome/WeatherTest.java
new file mode 100644
index 0000000..1947aac
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/WeatherTest.java
@@ -0,0 +1,70 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONException;
+import org.junit.Test;
+
+public class WeatherTest {
+
+    /** Trimmed from a real api.open-meteo.com answer for Moscow. */
+    private static final String BODY = "{\"latitude\":55.75,\"longitude\":37.625,\"current_units\":{\"temperature_2m\":\"°C\"},"
+            + "\"current\":{\"time\":\"2026-10-26T23:15\",\"interval\":900,\"temperature_2m\":6.6,\"weather_code\":3,\"is_day\":0}}";
+
+    @Test
+    public void parsesTheCurrentReading() throws JSONException {
+        Weather w = Weather.parse(BODY);
+        assertEquals(6.6, w.temperature, 1e-9);
+        assertEquals(Weather.Kind.CLOUDY, w.kind);
+        assertFalse(w.day);
+        assertEquals(R.drawable.ic_wx_cloudy, w.icon());
+        assertEquals(R.string.weather_cloudy, w.label());
+    }
+
+    @Test
+    public void clearNightShowsTheMoon() throws JSONException {
+        Weather w = Weather.parse(BODY.replace("\"weather_code\":3", "\"weather_code\":0"));
+        assertEquals(R.drawable.ic_wx_night, w.icon());
+        Weather day = Weather.parse(BODY.replace("\"weather_code\":3", "\"weather_code\":1").replace("\"is_day\":0", "\"is_day\":1"));
+        assertEquals(R.drawable.ic_wx_partly, day.icon());
+    }
+
+    @Test(expected = JSONException.class)
+    public void anErrorAnswerIsNoReading() throws JSONException {
+        Weather.parse("{\"error\":true,\"reason\":\"Latitude must be in range of -90 to 90°.\"}");
+    }
+
+    @Test
+    public void wmoCodes() {
+        assertEquals(Weather.Kind.CLEAR, Weather.kind(0));
+        assertEquals(Weather.Kind.PARTLY, Weather.kind(2));
+        assertEquals(Weather.Kind.CLOUDY, Weather.kind(3));
+        assertEquals(Weather.Kind.FOG, Weather.kind(48));
+        assertEquals(Weather.Kind.DRIZZLE, Weather.kind(55));
+        assertEquals(Weather.Kind.RAIN, Weather.kind(65));
+        assertEquals(Weather.Kind.RAIN, Weather.kind(81));
+        assertEquals(Weather.Kind.SNOW, Weather.kind(75));
+        assertEquals(Weather.Kind.SNOW, Weather.kind(86));
+        assertEquals(Weather.Kind.STORM, Weather.kind(99));
+        assertEquals(Weather.Kind.CLOUDY, Weather.kind(42));   // not a code Open-Meteo sends
+    }
+
+    @Test
+    public void temperatureSigns() {
+        assertEquals("+7°", Weather.temperature(6.6));
+        assertEquals("−3°", Weather.temperature(-2.6));
+        assertEquals("−2°", Weather.temperature(-2.5));   // Math.round goes up at .5
+        assertEquals("0°", Weather.temperature(-0.4));
+        assertEquals("0°", Weather.temperature(0.4));
+        assertEquals("+12°", Weather.temperature(12.49));
+    }
+
+    @Test
+    public void urlCarriesThePlace() {
+        String url = Weather.url(55.7558, 37.6173);
+        assertTrue(url.startsWith("https://api.open-meteo.com/v1/forecast?latitude=55.7558&longitude=37.6173"));
+        assertTrue(url.contains("current=temperature_2m,weather_code,is_day"));
+    }
+}
