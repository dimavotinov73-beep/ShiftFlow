diff --git a/launcher/app/src/main/java/com/gathin/tvhome/HeaderExtras.java b/launcher/app/src/main/java/com/gathin/tvhome/HeaderExtras.java
new file mode 100644
index 0000000..702e6a4
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/HeaderExtras.java
@@ -0,0 +1,69 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+
+import org.json.JSONObject;
+
+import java.io.File;
+
+/**
+ * The header keys this build adds on top of {@link Config}, read from the same theme config.json (Config.load keeps a
+ * copy of it in the app's files): compact pills, the VPN pill's on/off switch and the weather line. Every key is
+ * optional; absent or malformed, its feature stays off and Home looks as it did without it.
+ */
+final class HeaderExtras {
+
+    /** compact_pills: the top pills are round icons and open out to their label while focused. */
+    final boolean compactPills;
+    /** vpn_toggle: OK on the VPN pill switches the VPN through vpn_app's control intent, where the app has one. */
+    final boolean vpnToggle;
+    /** vpn_tunnel: the WireGuard tunnel that vpn_toggle switches; other apps ignore it. */
+    final String vpnTunnel;
+    /** weather_lat, weather_lon: the place the weather line is for; NaN while either is missing keeps the line off. */
+    final double weatherLat, weatherLon;
+    /** weather_city: the place's name after the conditions; empty shows none. */
+    final String weatherCity;
+
+    private HeaderExtras(boolean compactPills, boolean vpnToggle, String vpnTunnel, double weatherLat, double weatherLon,
+                         String weatherCity) {
+        this.compactPills = compactPills;
+        this.vpnToggle = vpnToggle;
+        this.vpnTunnel = vpnTunnel;
+        this.weatherLat = weatherLat;
+        this.weatherLon = weatherLon;
+        this.weatherCity = weatherCity;
+    }
+
+    /** After Config.load, which leaves the theme's config.json in the app's files (or removes it with the theme). */
+    static HeaderExtras load(Context ctx) {
+        return from(Config.read(new File(ctx.getFilesDir(), Config.FILE_NAME)));
+    }
+
+    static HeaderExtras from(JSONObject json) {
+        if (json == null) return new HeaderExtras(false, false, "", Double.NaN, Double.NaN, "");
+        double lat = coordinate(json.opt("weather_lat"), 90);
+        double lon = coordinate(json.opt("weather_lon"), 180);
+        boolean place = !Double.isNaN(lat) && !Double.isNaN(lon);
+        return new HeaderExtras(
+                json.opt("compact_pills") instanceof Boolean && json.optBoolean("compact_pills"),
+                json.opt("vpn_toggle") instanceof Boolean && json.optBoolean("vpn_toggle"),
+                text(json.opt("vpn_tunnel")),
+                place ? lat : Double.NaN,
+                place ? lon : Double.NaN,
+                text(json.opt("weather_city")));
+    }
+
+    boolean weather() {
+        return !Double.isNaN(weatherLat);
+    }
+
+    private static double coordinate(Object v, double limit) {
+        if (!(v instanceof Number)) return Double.NaN;
+        double d = ((Number) v).doubleValue();
+        return Double.isNaN(d) || Math.abs(d) > limit ? Double.NaN : d;
+    }
+
+    private static String text(Object v) {
+        return v instanceof String ? ((String) v).trim() : "";
+    }
+}
