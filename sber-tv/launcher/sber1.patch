diff --git a/launcher/app/src/main/java/com/gathin/tvhome/VpnControl.java b/launcher/app/src/main/java/com/gathin/tvhome/VpnControl.java
new file mode 100644
index 0000000..4ec05c4
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/VpnControl.java
@@ -0,0 +1,84 @@
+package com.gathin.tvhome;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ActivityInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.os.Bundle;
+import android.util.Log;
+
+import java.util.List;
+
+/**
+ * vpn_toggle: switches the VPN on or off through the VPN app's own control intent. Android gives no app a way to
+ * switch another app's VPN, so this only works for apps that accept such a command:
+ * <ul>
+ *   <li>WireGuard: SET_TUNNEL_UP / SET_TUNNEL_DOWN for a named tunnel (vpn_tunnel). Needs its CONTROL_TUNNELS
+ *       permission granted to this app (pm grant) and "Allow remote control apps" on in WireGuard's settings.</li>
+ *   <li>v2rayNG, and forks that kept its Tasker plugin receiver: a Locale FIRE_SETTING broadcast with an on/off switch
+ *       and "Default", the server selected in the app.</li>
+ * </ul>
+ * Any other app gets nothing sent; the caller opens it instead.
+ */
+final class VpnControl {
+
+    private static final String TAG = "VpnControl";
+
+    static final String WIREGUARD = "com.wireguard.android";
+    static final String WIREGUARD_PERMISSION = WIREGUARD + ".permission.CONTROL_TUNNELS";
+    static final String FIRE_SETTING = "com.twofortyfouram.locale.intent.action.FIRE_SETTING";
+    private static final String EXTRA_BUNDLE = "com.twofortyfouram.locale.intent.extra.BUNDLE";
+
+    private VpnControl() {
+    }
+
+    /**
+     * Asks {@code pkg} to bring its VPN up or down. True when a command went out; whether the app took it shows
+     * only in the VPN network coming or going, which the caller watches.
+     */
+    static boolean send(Context ctx, String pkg, boolean up, String tunnel) {
+        if (pkg == null || pkg.isEmpty()) return false;
+        try {
+            if (WIREGUARD.equals(pkg)) {
+                if (tunnel.isEmpty() || ctx.checkSelfPermission(WIREGUARD_PERMISSION) != PackageManager.PERMISSION_GRANTED) {
+                    return false;
+                }
+                ctx.sendBroadcast(new Intent(WIREGUARD + (up ? ".action.SET_TUNNEL_UP" : ".action.SET_TUNNEL_DOWN"))
+                        .setPackage(WIREGUARD)
+                        .putExtra("tunnel", tunnel));
+                return true;
+            }
+            ComponentName receiver = taskerReceiver(ctx, pkg);
+            if (receiver == null) return false;
+            Bundle settings = new Bundle();
+            settings.putBoolean("tasker_extra_bundle_switch", up);
+            settings.putString("tasker_extra_bundle_guid", "Default");
+            ctx.sendBroadcast(new Intent(FIRE_SETTING).setComponent(receiver).putExtra(EXTRA_BUNDLE, settings));
+            return true;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "could not ask " + pkg + " to switch its VPN: " + e.getMessage());
+            return false;
+        }
+    }
+
+    /** True when {@link #send} has a way to reach {@code pkg}, so the pill can say "press to switch" or not. */
+    static boolean supported(Context ctx, String pkg, String tunnel) {
+        if (pkg == null || pkg.isEmpty()) return false;
+        if (WIREGUARD.equals(pkg)) {
+            return !tunnel.isEmpty() && ctx.checkSelfPermission(WIREGUARD_PERMISSION) == PackageManager.PERMISSION_GRANTED;
+        }
+        return taskerReceiver(ctx, pkg) != null;
+    }
+
+    private static ComponentName taskerReceiver(Context ctx, String pkg) {
+        List<ResolveInfo> found = ctx.getPackageManager().queryBroadcastReceivers(
+                new Intent(FIRE_SETTING).setPackage(pkg), 0);
+        for (ResolveInfo r : found) {
+            ActivityInfo info = r.activityInfo;
+            if (info != null && info.exported) return new ComponentName(info.packageName, info.name);
+        }
+        return null;
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/Weather.java b/launcher/app/src/main/java/com/gathin/tvhome/Weather.java
new file mode 100644
index 0000000..1941457
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/Weather.java
@@ -0,0 +1,113 @@
+package com.gathin.tvhome;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.util.Locale;
+
+/**
+ * The weather line's data: the current temperature and conditions from Open-Meteo, which needs no key and no
+ * account. {@link #fetch} does network I/O and must run off the main thread; the rest is plain parsing.
+ */
+final class Weather {
+
+    /** What the icon and the word show, from the WMO weather code Open-Meteo reports. */
+    enum Kind { CLEAR, PARTLY, CLOUDY, FOG, DRIZZLE, RAIN, SNOW, STORM }
+
+    final double temperature;
+    final Kind kind;
+    /** Daylight at the place: a clear night shows the moon instead of the sun. */
+    final boolean day;
+
+    Weather(double temperature, Kind kind, boolean day) {
+        this.temperature = temperature;
+        this.kind = kind;
+        this.day = day;
+    }
+
+    static String url(double lat, double lon) {
+        return String.format(Locale.US, "https://api.open-meteo.com/v1/forecast?latitude=%.4f&longitude=%.4f"
+                + "&current=temperature_2m,weather_code,is_day&timezone=auto", lat, lon);
+    }
+
+    static Weather parse(String body) throws JSONException {
+        JSONObject current = new JSONObject(body).getJSONObject("current");
+        double t = current.getDouble("temperature_2m");
+        if (Double.isNaN(t) || Double.isInfinite(t)) throw new JSONException("temperature_2m is not a number");
+        return new Weather(t, kind(current.getInt("weather_code")), current.optInt("is_day", 1) == 1);
+    }
+
+    /** WMO 4677 codes as Open-Meteo documents them; anything unknown reads as cloudy rather than as nothing. */
+    static Kind kind(int code) {
+        if (code == 0) return Kind.CLEAR;
+        if (code == 1 || code == 2) return Kind.PARTLY;
+        if (code == 45 || code == 48) return Kind.FOG;
+        if (code >= 51 && code <= 57) return Kind.DRIZZLE;
+        if ((code >= 61 && code <= 67) || (code >= 80 && code <= 82)) return Kind.RAIN;
+        if ((code >= 71 && code <= 77) || code == 85 || code == 86) return Kind.SNOW;
+        if (code >= 95 && code <= 99) return Kind.STORM;
+        return Kind.CLOUDY;
+    }
+
+    /** "+7°", "−3°" with a true minus sign, "0°" without a sign; rounded to whole degrees. */
+    static String temperature(double celsius) {
+        long t = Math.round(celsius);
+        if (t == 0) return "0°";
+        return (t > 0 ? "+" : "−") + Math.abs(t) + "°";
+    }
+
+    int icon() {
+        switch (kind) {
+            case CLEAR: return day ? R.drawable.ic_wx_clear : R.drawable.ic_wx_night;
+            case PARTLY: return day ? R.drawable.ic_wx_partly : R.drawable.ic_wx_night_partly;
+            case FOG: return R.drawable.ic_wx_fog;
+            case DRIZZLE:
+            case RAIN: return R.drawable.ic_wx_rain;
+            case SNOW: return R.drawable.ic_wx_snow;
+            case STORM: return R.drawable.ic_wx_storm;
+            default: return R.drawable.ic_wx_cloudy;
+        }
+    }
+
+    int label() {
+        switch (kind) {
+            case CLEAR: return R.string.weather_clear;
+            case PARTLY: return R.string.weather_partly;
+            case FOG: return R.string.weather_fog;
+            case DRIZZLE: return R.string.weather_drizzle;
+            case RAIN: return R.string.weather_rain;
+            case SNOW: return R.string.weather_snow;
+            case STORM: return R.string.weather_storm;
+            default: return R.string.weather_cloudy;
+        }
+    }
+
+    /** The raw response, for {@link #parse} and for the cache that shows the last reading after a restart. */
+    static String fetch(double lat, double lon) throws IOException {
+        HttpURLConnection c = (HttpURLConnection) new URL(url(lat, lon)).openConnection();
+        c.setConnectTimeout(10_000);
+        c.setReadTimeout(10_000);
+        c.setRequestProperty("User-Agent", "CleanYourTV-launcher");
+        try {
+            if (c.getResponseCode() != 200) throw new IOException("HTTP " + c.getResponseCode());
+            try (InputStream in = c.getInputStream()) {
+                ByteArrayOutputStream out = new ByteArrayOutputStream();
+                byte[] buf = new byte[4096];
+                int n;
+                while ((n = in.read(buf)) > 0) {
+                    out.write(buf, 0, n);
+                    if (out.size() > 64 * 1024) throw new IOException("response larger than 64 KB");
+                }
+                return new String(out.toByteArray(), StandardCharsets.UTF_8);
+            }
+        } finally {
+            c.disconnect();
+        }
+    }
+}
