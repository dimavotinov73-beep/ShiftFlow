diff --git a/launcher/app/build.gradle b/launcher/app/build.gradle
index 3ceec7b4..c8935f5a 100644
--- a/launcher/app/build.gradle
+++ b/launcher/app/build.gradle
@@ -11,8 +11,8 @@ android {
         applicationId providers.gradleProperty('launcherApplicationId').getOrElse('com.gathin.tvhome')
         minSdk 26
         targetSdk 34
-        versionCode 9
-        versionName '3.0'
+        versionCode 16
+        versionName '3.0-sber7'
     }
 
     buildTypes {
@@ -30,7 +30,8 @@ android {
         resources {
             // Kotlin metadata pulled in by AndroidX's dependencies. This launcher is plain Java and never reads it;
             // leaving it out saves about 14 KB of every install.
-            excludes += ['kotlin/**', 'META-INF/*.version', 'META-INF/*.kotlin_module', 'DebugProbesKt.bin']
+            // kotlin/*.kotlin_builtins stay: the Anthropic SDK (Jarvis) reads them through Kotlin reflection at run time.
+            excludes += ['META-INF/*.version', 'META-INF/*.kotlin_module', 'DebugProbesKt.bin']
         }
     }
 
@@ -43,6 +44,13 @@ android {
 dependencies {
     implementation 'androidx.recyclerview:recyclerview:1.3.2'
     implementation 'androidx.dynamicanimation:dynamicanimation:1.0.0'
+    // The QR code in Launcher settings that takes the phone to PhoneLink's page (encoder only; R8 drops the rest).
+    implementation 'com.google.zxing:core:3.5.3'
+    // Jarvis, the voice assistant on the remote's assistant button: Claude through the official Java SDK. R8 keeps what it
+    // needs with the rules the SDK ships in its jar (META-INF/proguard).
+    implementation 'com.anthropic:anthropic-java:3.3.0'
     // Test only (never in the APK): plain JVM tests for the module card validators, src/test.
     testImplementation 'junit:junit:4.13.2'
+    // The real org.json for HeaderExtrasTest and WeatherTest: android.jar's is a stub in JVM tests.
+    testImplementation 'org.json:json:20240303'
 }
diff --git a/launcher/app/proguard-rules.pro b/launcher/app/proguard-rules.pro
index 7bb3d36e..0b1faec2 100644
--- a/launcher/app/proguard-rules.pro
+++ b/launcher/app/proguard-rules.pro
@@ -2,3 +2,8 @@
 # AndroidX code, not from renaming, and readable stack traces matter more in a sideloaded app
 # where crash reports arrive as screenshots.
 -dontobfuscate
+
+# The Anthropic SDK (Jarvis) pulls in the OpenTelemetry API, whose classes carry AutoValue's compile-time-only
+# annotation; nothing reads it at run time.
+-dontwarn com.google.auto.value.AutoValue
+-dontwarn com.google.auto.value.AutoValue$CopyAnnotations
diff --git a/launcher/app/src/main/AndroidManifest.xml b/launcher/app/src/main/AndroidManifest.xml
index 701b5feb..b062ee66 100644
--- a/launcher/app/src/main/AndroidManifest.xml
+++ b/launcher/app/src/main/AndroidManifest.xml
@@ -21,6 +21,16 @@
     <!-- YaOS (Yandex TV OS): HDMI, AV and the tuner all play in com.yandex.tv.live, whose activities require
          this permission (protection level normal, so it is granted at install). Ignored on other TVs. -->
     <uses-permission android:name="yandex.tv.permission.ACCESS_TV_SOURCE" />
+    <!-- The weather line (weather_lat / weather_lon in a theme): one small request to api.open-meteo.com every half
+         hour, and only while a theme turns the line on. -->
+    <uses-permission android:name="android.permission.INTERNET" />
+    <!-- Jarvis, the voice assistant on the remote's assistant button: the microphone, only while his overlay is
+         listening (protection level dangerous, granted with pm grant by sber-tv.sh jarvis). -->
+    <uses-permission android:name="android.permission.RECORD_AUDIO" />
+    <!-- Not every TV has a microphone; without one Jarvis says so and the rest of the launcher is unchanged. -->
+    <uses-feature android:name="android.hardware.microphone" android:required="false" />
+    <!-- vpn_toggle with WireGuard: its tunnel switch requires this (protection level dangerous, granted with pm grant). -->
+    <uses-permission android:name="com.wireguard.android.permission.CONTROL_TUNNELS" />
 
     <!-- Android 11+ package visibility: lets the launcher list the TV apps it shows as tiles, and the
          apps that declare a module card (docs/specs/card.md). -->
@@ -68,6 +78,15 @@
         <!-- Coocaa OS sources for the Inputs menu (coocaa_sources); see CoocaaSources. -->
         <provider android:authorities="com.skyworth.tv.provider" />
         <provider android:authorities="com.skyworth.tv.sdk.provider" />
+        <!-- vpn_toggle: VPN apps with a Locale/Tasker plugin receiver (v2rayNG and its forks), and WireGuard. -->
+        <intent>
+            <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
+        </intent>
+        <package android:name="com.wireguard.android" />
+        <!-- vpn_pill without a vpn_app: the VPN apps installed (VpnControl.firstVpnApp). -->
+        <intent>
+            <action android:name="android.net.VpnService" />
+        </intent>
     </queries>
 
     <application
@@ -99,6 +118,19 @@
             </intent-filter>
         </activity>
 
+        <!-- Jarvis over whatever is playing; its own task, so the app behind stays put. Started by the remote's assistant
+             button (InputKeyService, same app) and by sber-tv.sh's voice check over adb, which holds
+             WRITE_SECURE_SETTINGS; other apps cannot start it. No screenOrientation: a translucent activity may not
+             request one on Android 8.0. -->
+        <activity
+            android:name=".JarvisActivity"
+            android:exported="true"
+            android:permission="android.permission.WRITE_SECURE_SETTINGS"
+            android:launchMode="singleTask"
+            android:taskAffinity=""
+            android:excludeFromRecents="true"
+            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
+
         <activity
             android:name=".LauncherSettingsActivity"
             android:exported="false"
