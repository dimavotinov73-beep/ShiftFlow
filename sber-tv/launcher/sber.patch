index 00000000..ad78816f
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/WallpaperTone.java
@@ -0,0 +1,147 @@
+package com.gathin.tvhome;
+
+/**
+ * Sber edition: the colours of the clock, the date and the weather, picked from the part of the wallpaper behind
+ * them, as a phone's lock screen does. Over a light picture (a misty sky) the text is dark, in the picture's own hue;
+ * over a dark one it is light, faintly tinted the same way, with a soft shadow that keeps white text readable where
+ * the picture is only middling. Plain Java on ARGB pixels, so it is worked out off the main thread with the decode.
+ */
+final class WallpaperTone {
+
+    /** The header's colours for one picture, all ARGB. */
+    static final class Tone {
+        /** The big clock: a little translucent, so the picture shows through it as on the lock screen. */
+        final int clock;
+        /** The date and the temperature. */
+        final int primary;
+        /** The greeting and the weather's conditions line. */
+        final int secondary;
+        /** The picture behind the header is light: the text is dark (and the pills take dark glass). */
+        final boolean light;
+        /** Shadow under the text, 0 for none; the radius goes with it. */
+        final int shadow;
+        final float shadowRadiusDp;
+
+        Tone(int clock, int primary, int secondary, boolean light, int shadow, float shadowRadiusDp) {
+            this.clock = clock;
+            this.primary = primary;
+            this.secondary = secondary;
+            this.light = light;
+            this.shadow = shadow;
+            this.shadowRadiusDp = shadowRadiusDp;
+        }
+    }
+
+    /** No picture (plain black), or nothing to read: white text, as before. */
+    static final Tone DEFAULT = new Tone(0xF2FFFFFF, 0xEBFFFFFF, 0xB3FFFFFF, false, 0, 0f);
+
+    /** Lightness (CIE L*, 0 to 100) above which the text turns dark. */
+    static final float LIGHT_ABOVE = 64f;
+    /** Below LIGHT_ABOVE but above this, white text needs a stronger shadow to stand off the picture. */
+    static final float MIDDLING_ABOVE = 48f;
+
+    private WallpaperTone() {
+    }
+
+    /**
+     * The tone for the pixels behind the header (ARGB, any order). Mostly light pixels make dark ink; a few bright
+     * clouds in a dark picture do not, since the lightness is the mean of all of them.
+     */
+    static Tone of(int[] pixels) {
+        if (pixels == null || pixels.length == 0) return DEFAULT;
+        double y = 0, r = 0, g = 0, b = 0;
+        int n = 0;
+        for (int p : pixels) {
+            if ((p >>> 24) < 128) continue;   // transparent: not part of the picture
+            int pr = (p >> 16) & 0xFF, pg = (p >> 8) & 0xFF, pb = p & 0xFF;
+            y += 0.2126 * linear(pr) + 0.7152 * linear(pg) + 0.0722 * linear(pb);
+            r += pr;
+            g += pg;
+            b += pb;
+            n++;
+        }
+        if (n == 0) return DEFAULT;
+        float lightness = lightness(y / n);
+        float[] hsl = hsl((int) Math.round(r / n), (int) Math.round(g / n), (int) Math.round(b / n));
+        float hue = hsl[0], saturation = hsl[1];
+        if (lightness > LIGHT_ABOVE) {
+            // Dark ink in the picture's hue: a deep slate under a grey-blue sky, a deep brown over sand.
+            float s = Math.min(saturation, 0.5f) * 0.75f;
+            int ink = rgb(hue, s, 0.2f);
+            return new Tone(alpha(ink, 0.80f), alpha(ink, 0.88f), alpha(rgb(hue, s, 0.26f), 0.76f), true, 0, 0f);
+        }
+        // Light text, tinted just enough to belong to the picture.
+        float s = Math.min(saturation, 0.4f) * 0.55f;
+        int paper = rgb(hue, s, 0.96f);
+        boolean middling = lightness > MIDDLING_ABOVE;
+        int shadow = middling ? 0x66000000 : 0x33000000;
+        return new Tone(alpha(paper, 0.95f), alpha(paper, 0.93f), alpha(paper, 0.74f), false, shadow, middling ? 14f : 10f);
+    }
+
+    /**
+     * The pixels of a region given as shares of a width × height picture (left, top, right, bottom in 0..1),
+     * row by row; an empty array when the region holds no pixel.
+     */
+    static int[] region(int[] pixels, int width, int height, float left, float top, float right, float bottom) {
+        int x0 = Math.max(0, Math.round(left * width)), x1 = Math.min(width, Math.round(right * width));
+        int y0 = Math.max(0, Math.round(top * height)), y1 = Math.min(height, Math.round(bottom * height));
+        if (x1 <= x0 || y1 <= y0) return new int[0];
+        int[] out = new int[(x1 - x0) * (y1 - y0)];
+        int i = 0;
+        for (int y = y0; y < y1; y++) {
+            for (int x = x0; x < x1; x++) out[i++] = pixels[y * width + x];
+        }
+        return out;
+    }
+
+    /** CIE L* (0 to 100) of a relative luminance. */
+    static float lightness(double luminance) {
+        double f = luminance > 216.0 / 24389.0 ? Math.cbrt(luminance) : (24389.0 / 27.0 * luminance + 16) / 116.0;
+        return (float) (116 * f - 16);
+    }
+
+    /** An sRGB channel (0 to 255) as linear light (0 to 1). */
+    private static double linear(int channel) {
+        double c = channel / 255.0;
+        return c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
+    }
+
+    /** {hue 0..360, saturation 0..1, lightness 0..1} of an sRGB colour. */
+    static float[] hsl(int r, int g, int b) {
+        float rf = r / 255f, gf = g / 255f, bf = b / 255f;
+        float max = Math.max(rf, Math.max(gf, bf)), min = Math.min(rf, Math.min(gf, bf));
+        float l = (max + min) / 2f, d = max - min;
+        if (d == 0f) return new float[]{0f, 0f, l};
+        float s = d / (1f - Math.abs(2f * l - 1f));
+        float h;
+        if (max == rf) h = ((gf - bf) / d) % 6f;
+        else if (max == gf) h = (bf - rf) / d + 2f;
+        else h = (rf - gf) / d + 4f;
+        h *= 60f;
+        if (h < 0) h += 360f;
+        return new float[]{h, Math.min(1f, s), l};
+    }
+
+    /** An opaque sRGB colour from hue (0..360), saturation and lightness (0..1). */
+    static int rgb(float h, float s, float l) {
+        float c = (1f - Math.abs(2f * l - 1f)) * s;
+        float x = c * (1f - Math.abs((h / 60f) % 2f - 1f));
+        float m = l - c / 2f;
+        float r, g, b;
+        if (h < 60) { r = c; g = x; b = 0; }
+        else if (h < 120) { r = x; g = c; b = 0; }
+        else if (h < 180) { r = 0; g = c; b = x; }
+        else if (h < 240) { r = 0; g = x; b = c; }
+        else if (h < 300) { r = x; g = 0; b = c; }
+        else { r = c; g = 0; b = x; }
+        return 0xFF000000 | channel(r + m) << 16 | channel(g + m) << 8 | channel(b + m);
+    }
+
+    private static int channel(float v) {
+        return Math.max(0, Math.min(255, Math.round(v * 255f)));
+    }
+
+    private static int alpha(int rgb, float alpha) {
+        return Math.round(alpha * 255f) << 24 | (rgb & 0xFFFFFF);
+    }
+}
