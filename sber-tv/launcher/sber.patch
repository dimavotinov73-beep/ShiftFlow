+    // ---- layers and their motion ----------------------------------------------------------------------
+
+    private interface Painter {
+        /** Paints a layer of lw x lh for a screen of sw x sh (both in the layer's own pixels). */
+        void paint(Canvas c, int lw, int lh, int sw, int sh);
+    }
+
+    private interface Bounds {
+        Rect at(int sw, int sh);
+    }
+
+    private static final class Layer {
+        final Painter painter;
+        final Bounds bounds;
+        final float resolution;
+        final List<Motion> motions = new ArrayList<>();
+
+        Layer(Painter painter, Bounds bounds, float resolution) {
+            this.painter = painter;
+            this.bounds = bounds;
+            this.resolution = resolution;
+        }
+
+        Rect bounds(int sw, int sh) {
+            return bounds.at(sw, sh);
+        }
+
+        Layer move(Motion m) {
+            motions.add(m);
+            return this;
+        }
+    }
+
+    private static final Bounds SCREEN = (sw, sh) -> new Rect(0, 0, sw, sh);
+
+    /** A screen and a half wide: the layer slides along a full screen width and starts over seamlessly. */
+    private static final Bounds STRIP = (sw, sh) -> new Rect(0, 0, sw * 2, sh);
+
+    /** One property going back and forth (or round and round), in screen widths and heights for moves. */
+    private static final class Motion {
+        final Property<View, Float> property;
+        final float from, to;
+        final long ms;
+        final boolean loop;
+        final boolean screenX, screenY;
+
+        private Motion(Property<View, Float> property, float from, float to, long ms, boolean loop, boolean screenX, boolean screenY) {
+            this.property = property;
+            this.from = from;
+            this.to = to;
+            this.ms = ms;
+            this.loop = loop;
+            this.screenX = screenX;
+            this.screenY = screenY;
+        }
+
+        static Motion swayX(float from, float to, long ms) {
+            return new Motion(View.TRANSLATION_X, from, to, ms, false, true, false);
+        }
+
+        static Motion swayY(float from, float to, long ms) {
+            return new Motion(View.TRANSLATION_Y, from, to, ms, false, false, true);
+        }
+
+        /** Slides one screen width left and starts over: for STRIP layers painted twice over. */
+        static Motion slide(long ms) {
+            return new Motion(View.TRANSLATION_X, 0f, -1f, ms, true, true, false);
+        }
+
+        static Motion fade(float from, float to, long ms) {
+            return new Motion(View.ALPHA, from, to, ms, false, false, false);
+        }
+
+        static Motion breathe(float from, float to, long ms) {
+            return new Motion(SCALE, from, to, ms, false, false, false);
+        }
+
+        static Motion spin(long ms) {
+            return new Motion(View.ROTATION, 0f, 360f, ms, true, false, false);
+        }
+
+        Animator animator(View view, int sw, int sh) {
+            float k = screenX ? sw : screenY ? sh : 1f;
+            ObjectAnimator a = ObjectAnimator.ofFloat(view, property, from * k, to * k);
+            a.setDuration(ms);
+            a.setRepeatCount(ValueAnimator.INFINITE);
+            a.setRepeatMode(loop ? ValueAnimator.RESTART : ValueAnimator.REVERSE);
+            a.setInterpolator(loop ? new LinearInterpolator() : new AccelerateDecelerateInterpolator());
+            return a;
+        }
+    }
+
+    private static final Property<View, Float> SCALE = new Property<View, Float>(Float.class, "scale") {
+        @Override
+        public Float get(View v) {
+            return v.getScaleX();
+        }
+
+        @Override
+        public void set(View v, Float value) {
+            v.setScaleX(value);
+            v.setScaleY(value);
+        }
+    };
