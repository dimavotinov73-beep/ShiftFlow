+        }
+        for (int i = 0; target == null && i < rows.getChildCount(); i++) {
+            if (rows.getChildAt(i).isFocusable()) target = rows.getChildAt(i);
+        }
+        if (target != null) {
+            View t = target;
+            t.post(t::requestFocus);
+        }
+    }
