@@ -0,0 +1,307 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Path;
+import android.graphics.Rect;
+import android.graphics.drawable.BitmapDrawable;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.LayerDrawable;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.animation.DecelerateInterpolator;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.PopupWindow;
+import android.widget.TextView;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Sber edition: the header's control centre, as on a phone. A sheet of frosted glass (the wallpaper behind it,
+ * blurred) that drops from the top-right button: its title, capsules two by two (Wi-Fi, VPN, Bluetooth, the input,
+ * the screensaver), each with a round icon that takes a colour while its thing is on, and under them wide buttons
+ * (Launcher settings, the TV's settings, power). The focused one turns white and grows a little, with room round it
+ * so nothing cuts it. OK runs it and closes the sheet; Back closes it.
+ */
+final class ControlCenter {
+
+    private static final class Item {
+        final int icon;
+        final String title, subtitle;
+        /** The icon's circle while on (blue for Wi-Fi, green for the VPN); 0 when off or never coloured. */
+        final int accent;
+        final Runnable action;
+
+        Item(int icon, String title, String subtitle, int accent, Runnable action) {
+            this.icon = icon;
+            this.title = title;
+            this.subtitle = subtitle;
+            this.accent = accent;
+            this.action = action;
+        }
+    }
+
+    private final Activity activity;
+    private final boolean animated;
+    private final float density;
+    private final List<Item> tiles = new ArrayList<>();
+    private final List<Item> buttons = new ArrayList<>();
+
+    ControlCenter(Activity activity, boolean animated) {
+        this.activity = activity;
+        this.animated = animated;
+        density = activity.getResources().getDisplayMetrics().density;
+    }
+
+    /** A capsule: icon, title and a line of state under it. */
+    ControlCenter tile(int icon, String title, String subtitle, int accent, Runnable action) {
+        tiles.add(new Item(icon, title, subtitle, accent, action));
+        return this;
+    }
+
+    /** A square button in the bottom row: an icon, its name only for accessibility. */
+    ControlCenter button(int icon, String label, Runnable action) {
+        buttons.add(new Item(icon, label, null, 0, action));
+        return this;
+    }
+
+    /**
+     * Drops the sheet from under the anchor, right-aligned with it, and focuses the first capsule. frost is the
+     * wallpaper's blurred copy (WallpaperPlayer.frosted, for the whole screen): the part under the sheet becomes its
+     * glass. Null leaves it dark.
+     */
+    PopupWindow show(View anchor, Bitmap frost) {
+        LinearLayout sheet = new LinearLayout(activity);
+        sheet.setOrientation(LinearLayout.VERTICAL);
+        sheet.setPadding(dp(18), dp(16), dp(18), dp(18));
+        sheet.setClipChildren(false);
+        sheet.setClipToPadding(false);
+        int width = dp(480);
+        PopupWindow popup = new PopupWindow(sheet, width, ViewGroup.LayoutParams.WRAP_CONTENT, true);
+        popup.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));   // Back closes it
+        popup.setOutsideTouchable(true);
+        popup.setAnimationStyle(0);
+
+        TextView heading = text(activity.getString(R.string.control_center), 17, 0xFFFFFFFF, R.string.font_semibold);
+        heading.setPadding(dp(4), 0, 0, dp(14));
+        sheet.addView(heading, new LinearLayout.LayoutParams(-1, -2));
+        View first = null;
+        for (int i = 0; i < tiles.size(); i += 2) {
+            LinearLayout line = new LinearLayout(activity);
+            line.setOrientation(LinearLayout.HORIZONTAL);
+            line.setClipChildren(false);   // a focused capsule grows past its line
+            for (int j = i; j < Math.min(i + 2, tiles.size()); j++) {
+                View capsule = capsule(tiles.get(j), popup);
+                if (first == null) first = capsule;
+                LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, dp(68), 1);
+                if (j > i) lp.leftMargin = dp(12);
+                line.addView(capsule, lp);
+            }
+            if (tiles.size() % 2 == 1 && i == tiles.size() - 1) line.addView(new View(activity), new LinearLayout.LayoutParams(0, dp(68), 1));
+            LinearLayout.LayoutParams lineLp = new LinearLayout.LayoutParams(-1, -2);
+            if (i > 0) lineLp.topMargin = dp(12);
+            sheet.addView(line, lineLp);
+        }
+        if (!buttons.isEmpty()) {
+            LinearLayout row = new LinearLayout(activity);
+            row.setOrientation(LinearLayout.HORIZONTAL);
+            row.setClipChildren(false);
+            for (int i = 0; i < buttons.size(); i++) {
+                View square = square(buttons.get(i), popup);
+                if (first == null) first = square;
+                LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, dp(64), 1);
+                if (i > 0) lp.leftMargin = dp(12);
+                row.addView(square, lp);
+            }
+            LinearLayout.LayoutParams rowLp = new LinearLayout.LayoutParams(-1, -2);
+            rowLp.topMargin = dp(16);
+            sheet.addView(row, rowLp);
+        }
+
+        sheet.setBackground(glass(anchor, sheet, width, frost));
+        sheet.setElevation(dp(18));
+        sheet.setAlpha(0f);
+        sheet.setPivotX(width);
+        sheet.setPivotY(0f);
+        sheet.setScaleX(0.94f);
+        sheet.setScaleY(0.94f);
+        popup.showAsDropDown(anchor, 0, dp(12), Gravity.END);
+        sheet.animate().alpha(1f).scaleX(1f).scaleY(1f).setDuration(animated ? 200 : 0)
+                .setInterpolator(new DecelerateInterpolator(1.6f)).start();
+        if (first != null) first.requestFocus();
+        return popup;
+    }
+
+    /**
+     * The sheet's glass: the blurred wallpaper just under where it drops (the anchor's right edge, under it), darkened
+     * so white reads on it, with a hairline rim; plain dark glass without a wallpaper.
+     */
+    private Drawable glass(View anchor, View sheet, int width, Bitmap frost) {
+        float radius = dp(28);
+        GradientDrawable tint = new GradientDrawable(GradientDrawable.Orientation.TOP_BOTTOM,
+                new int[]{frost != null ? 0xA6202024 : 0xF22A2A30, frost != null ? 0xBF141418 : 0xF51A1A1E});
+        tint.setCornerRadius(radius);
+        tint.setStroke(dp(1), 0x33FFFFFF);
+        if (frost == null) return tint;
+        sheet.measure(View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY), View.MeasureSpec.UNSPECIFIED);
+        int[] at = new int[2];
+        anchor.getLocationOnScreen(at);
+        View screen = anchor.getRootView();
+        float sx = frost.getWidth() / (float) Math.max(1, screen.getWidth());
+        float sy = frost.getHeight() / (float) Math.max(1, screen.getHeight());
+        int left = at[0] + anchor.getWidth() - width, top = at[1] + anchor.getHeight() + dp(12);
+        Rect part = new Rect(Math.round(left * sx), Math.round(top * sy), Math.round((left + width) * sx),
+                Math.round((top + sheet.getMeasuredHeight()) * sy));
+        if (!part.intersect(0, 0, frost.getWidth(), frost.getHeight()) || part.width() < 2 || part.height() < 2) return tint;
+        BitmapDrawable under = new BitmapDrawable(activity.getResources(),
+                Bitmap.createBitmap(frost, part.left, part.top, part.width(), part.height()));
+        under.setFilterBitmap(true);
+        return new RoundedLayers(new Drawable[]{under, tint}, radius);
+    }
+
+    /** Layers clipped to a rounded rectangle, so the blurred picture has the sheet's corners too. */
+    private static final class RoundedLayers extends LayerDrawable {
+        private final Path corners = new Path();
+        private final float radius;
+
+        RoundedLayers(Drawable[] layers, float radius) {
+            super(layers);
+            this.radius = radius;
+        }
+
+        @Override
+        public void draw(Canvas c) {
+            Rect b = getBounds();
+            corners.reset();
+            corners.addRoundRect(b.left, b.top, b.right, b.bottom, radius, radius, Path.Direction.CW);
+            c.save();
+            c.clipPath(corners);
+            super.draw(c);
+            c.restore();
+        }
+    }
+
+    private View capsule(Item item, PopupWindow popup) {
+        LinearLayout capsule = new LinearLayout(activity);
+        capsule.setOrientation(LinearLayout.HORIZONTAL);
+        capsule.setGravity(Gravity.CENTER_VERTICAL);
+        capsule.setPadding(dp(12), 0, dp(14), 0);
+        GradientDrawable fill = new GradientDrawable();
+        fill.setCornerRadius(dp(34));
+        fill.setColor(REST);
+        fill.setStroke(dp(1), 0x14FFFFFF);
+        capsule.setBackground(fill);
+        focusable(capsule);
+        FrameLayout circle = new FrameLayout(activity);
+        GradientDrawable disc = new GradientDrawable();
+        disc.setShape(GradientDrawable.OVAL);
+        disc.setColor(item.accent != 0 ? item.accent : 0x33FFFFFF);
+        circle.setBackground(disc);
+        ImageView glyph = new ImageView(activity);
+        glyph.setImageResource(item.icon);
+        glyph.setColorFilter(0xFFFFFFFF);
+        circle.addView(glyph, new FrameLayout.LayoutParams(dp(22), dp(22), Gravity.CENTER));
+        capsule.addView(circle, new LinearLayout.LayoutParams(dp(44), dp(44)));
+        LinearLayout texts = new LinearLayout(activity);
+        texts.setOrientation(LinearLayout.VERTICAL);
+        TextView title = text(item.title, 16, 0xFFFFFFFF, R.string.font_medium);
+        TextView subtitle = text(item.subtitle == null ? "" : item.subtitle, 13, 0x99FFFFFF, R.string.font_regular);
+        texts.addView(title);
+        LinearLayout.LayoutParams sp = new LinearLayout.LayoutParams(-2, -2);
+        sp.topMargin = dp(3);
+        texts.addView(subtitle, sp);
+        LinearLayout.LayoutParams tp = new LinearLayout.LayoutParams(0, -2, 1);
+        tp.leftMargin = dp(12);
+        capsule.addView(texts, tp);
+        capsule.setOnFocusChangeListener((v, focused) -> {
+            fill.setColor(focused ? 0xFFFFFFFF : REST);
+            fill.setStroke(dp(1), focused ? 0x00FFFFFF : 0x14FFFFFF);
+            title.setTextColor(focused ? 0xFF1C1C1E : 0xFFFFFFFF);
+            subtitle.setTextColor(focused ? 0xFF6E6E73 : 0x99FFFFFF);
+            if (item.accent == 0) disc.setColor(focused ? 0x1F000000 : 0x33FFFFFF);
+            glyph.setColorFilter(focused && item.accent == 0 ? 0xFF1C1C1E : 0xFFFFFFFF);
+            lift(v, focused);
+        });
+        capsule.setOnClickListener(v -> run(popup, item));
+        capsule.setContentDescription(item.title);
+        return capsule;
+    }
+
+    private View square(Item item, PopupWindow popup) {
+        LinearLayout square = new LinearLayout(activity);
+        square.setOrientation(LinearLayout.HORIZONTAL);
+        square.setGravity(Gravity.CENTER);
+        square.setPadding(dp(10), 0, dp(10), 0);
+        GradientDrawable fill = new GradientDrawable();
+        fill.setCornerRadius(dp(22));
+        fill.setColor(REST);
+        fill.setStroke(dp(1), 0x14FFFFFF);
+        square.setBackground(fill);
+        focusable(square);
+        ImageView glyph = new ImageView(activity);
+        glyph.setImageResource(item.icon);
+        glyph.setColorFilter(0xFFFFFFFF);
+        square.addView(glyph, new LinearLayout.LayoutParams(dp(22), dp(22)));
+        TextView name = text(item.title, 14, 0xE6FFFFFF, R.string.font_medium);
+        LinearLayout.LayoutParams np = new LinearLayout.LayoutParams(-2, -2);
+        np.leftMargin = dp(8);
+        square.addView(name, np);
+        square.setOnFocusChangeListener((v, focused) -> {
+            fill.setColor(focused ? 0xFFFFFFFF : REST);
+            fill.setStroke(dp(1), focused ? 0x00FFFFFF : 0x14FFFFFF);
+            glyph.setColorFilter(focused ? 0xFF1C1C1E : 0xFFFFFFFF);
+            name.setTextColor(focused ? 0xFF1C1C1E : 0xE6FFFFFF);
+            lift(v, focused);
+        });
+        square.setOnClickListener(v -> run(popup, item));
+        square.setContentDescription(item.title);
+        return square;
+    }
+
+    /** A capsule or button at rest: frosted, a little lighter than the sheet. */
+    private static final int REST = 0x2BFFFFFF;
+
+    private void focusable(View view) {
+        view.setFocusable(true);
+        view.setFocusableInTouchMode(false);
+        view.setClickable(true);
+    }
+
+    /** The focused one grows a little and rises on a shadow; its line and the sheet leave room for it. */
+    private void lift(View view, boolean focused) {
+        float s = focused && animated ? 1.03f : 1f;
+        view.animate().scaleX(s).scaleY(s).translationZ(focused ? dp(8) : 0).setDuration(animated ? 150 : 0).start();
+    }
+
+    /** Closes the sheet first, so what the action opens (a popup of its own, an app) comes up over Home. */
+    private static void run(PopupWindow popup, Item item) {
+        popup.dismiss();
+        item.action.run();
+    }
+
+    private TextView text(String value, int sp, int color, int fontRes) {
+        TextView t = new TextView(activity);
+        t.setText(value);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        t.setSingleLine(true);
+        t.setEllipsize(TextUtils.TruncateAt.END);
+        t.setIncludeFontPadding(false);
+        t.setTypeface(UiFont.get(activity, fontRes));
+        return t;
+    }
+
+    private int dp(int value) {
+        return Math.round(value * density);
+    }
+}
