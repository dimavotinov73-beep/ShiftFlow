@@ -0,0 +1,67 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONObject;
+
+import java.io.File;
+
+/**
+ * Jarvis's settings. The keys come from jarvis.json next to the theme, which {@code sber-tv.sh jarvis} writes through
+ * ThemeProvider: {"anthropic_key": "sk-ant-...", "yandex_key": "AQVN..."}. A theme push leaves the file alone. The voice
+ * and its effect are chosen on the TV (Launcher settings) and kept in the app's own preferences.
+ */
+final class JarvisConfig {
+
+    static final String FILE_NAME = "jarvis.json";
+    static final String PREFS = "jarvis";
+
+    /** SpeechKit voices that suit a calm male assistant: voice, role ("" for none), label resource. */
+    static final String[][] VOICES = {
+            {"kirill", "strict"}, {"kirill", "neutral"}, {"alexander", "neutral"}, {"anton", "neutral"},
+            {"ermil", "neutral"}, {"filipp", ""}, {"zahar", "neutral"},
+    };
+    static final int[] VOICE_NAMES = {
+            R.string.jarvis_voice_kirill_strict, R.string.jarvis_voice_kirill, R.string.jarvis_voice_alexander,
+            R.string.jarvis_voice_anton, R.string.jarvis_voice_ermil, R.string.jarvis_voice_filipp,
+            R.string.jarvis_voice_zahar,
+    };
+
+    final String anthropicKey;
+    final String yandexKey;
+    final String voice;
+    final String role;
+    /** The light metallic room on the voice, as in the films; off plays SpeechKit's voice as it comes. */
+    final boolean effect;
+
+    JarvisConfig(String anthropicKey, String yandexKey, String voice, String role, boolean effect) {
+        this.anthropicKey = anthropicKey;
+        this.yandexKey = yandexKey;
+        this.voice = voice;
+        this.role = role;
+        this.effect = effect;
+    }
+
+    static JarvisConfig load(Context ctx) {
+        File dir = Config.dir(ctx);
+        return from(dir == null ? null : Config.read(new File(dir, FILE_NAME)), ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE));
+    }
+
+    static JarvisConfig from(JSONObject json, SharedPreferences prefs) {
+        String anthropic = json == null ? "" : json.optString("anthropic_key", "").trim();
+        String yandex = json == null ? "" : json.optString("yandex_key", "").trim();
+        return new JarvisConfig(anthropic, yandex, prefs.getString("voice", "kirill"), prefs.getString("role", "strict"),
+                prefs.getBoolean("effect", true));
+    }
+
+    boolean ready() {
+        return !anthropicKey.isEmpty() && !yandexKey.isEmpty();
+    }
+
+    /** The VOICES row of the chosen voice, or -1 for one set some other way. */
+    int voiceIndex() {
+        for (int i = 0; i < VOICES.length; i++) if (VOICES[i][0].equals(voice) && VOICES[i][1].equals(role)) return i;
+        return -1;
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/JarvisMic.java b/launcher/app/src/main/java/com/gathin/tvhome/JarvisMic.java
new file mode 100644
index 0000000..cadb28e
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/JarvisMic.java
@@ -0,0 +1,194 @@
+package com.gathin.tvhome;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.media.AudioDeviceInfo;
+import android.media.AudioFormat;
+import android.media.AudioManager;
+import android.media.AudioRecord;
+import android.media.MediaRecorder;
+import android.util.Log;
+
+import java.io.ByteArrayOutputStream;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * One spoken phrase from the microphone: 16 kHz mono PCM, from just before the voice starts to a short pause after it
+ * (Vad decides), for SpeechKit. Blocks: run it off the main thread. The remote's own microphone is used when the
+ * firmware lets other apps record from it; a TV without one needs a USB or Bluetooth microphone.
+ */
+final class JarvisMic {
+
+    private static final String TAG = "Jarvis";
+    static final int FRAME_MS = 20;
+    private static final int FRAME = SpeechKit.STT_RATE * FRAME_MS / 1000;   // samples
+    /** Kept from before the voice crossed the threshold, so the first syllable is not cut. */
+    private static final int PREROLL_FRAMES = 15;
+
+    interface Levels {
+        /** 0..1, about fifty times a second, on the recording thread. */
+        void level(float level);
+    }
+
+    /** What was heard: the phrase (empty when nobody spoke) and how loud the room got at most (0..32767). */
+    static final class Heard {
+        final byte[] pcm;
+        final double peak;
+        final String error;
+
+        Heard(byte[] pcm, double peak, String error) {
+            this.pcm = pcm;
+            this.peak = peak;
+            this.error = error;
+        }
+
+        boolean speech() {
+            return pcm.length > 0;
+        }
+    }
+
+    private volatile boolean stopped, finishEarly;
+
+    /** Stops listening and keeps what was said so far (the assistant button pressed again). */
+    void finish() {
+        finishEarly = true;
+    }
+
+    /** Stops listening and drops it all (Back). */
+    void cancel() {
+        stopped = true;
+    }
+
+    @SuppressLint("MissingPermission")   // checked by the caller; without it AudioRecord fails to initialise
+    Heard listen(Levels levels) {
+        AudioRecord record = open(MediaRecorder.AudioSource.VOICE_RECOGNITION);
+        if (record == null) record = open(MediaRecorder.AudioSource.MIC);
+        if (record == null) return new Heard(new byte[0], 0, "no microphone");
+        Vad vad = new Vad();
+        ByteArrayOutputStream phrase = new ByteArrayOutputStream();
+        ArrayDeque<byte[]> preroll = new ArrayDeque<>();
+        short[] samples = new short[FRAME];
+        double peak = 0;
+        try {
+            record.startRecording();
+            while (!stopped) {
+                int n = 0;
+                while (n < FRAME) {
+                    int r = record.read(samples, n, FRAME - n);
+                    if (r <= 0) return new Heard(new byte[0], peak, "read " + r);
+                    n += r;
+                }
+                double rms = rms(samples);
+                peak = Math.max(peak, rms);
+                if (levels != null) levels.level((float) Math.min(1.0, rms / 6000.0));
+                byte[] frame = bytes(samples);
+                int state = vad.feed(rms);
+                if (state == Vad.WAITING) {
+                    preroll.addLast(frame);
+                    if (preroll.size() > PREROLL_FRAMES) preroll.removeFirst();
+                } else {
+                    while (!preroll.isEmpty()) phrase.write(preroll.removeFirst(), 0, frame.length);
+                    phrase.write(frame, 0, frame.length);
+                }
+                if (finishEarly) return new Heard(vad.heardVoice() ? phrase.toByteArray() : new byte[0], peak, null);
+                if (state == Vad.DONE) return new Heard(phrase.toByteArray(), peak, null);
+                if (state == Vad.TIMEOUT) return new Heard(new byte[0], peak, null);
+            }
+            return new Heard(new byte[0], peak, null);
+        } finally {
+            try {
+                record.stop();
+            } catch (IllegalStateException ignored) {
+                // never started
+            }
+            record.release();
+        }
+    }
+
+    @SuppressLint("MissingPermission")
+    private static AudioRecord open(int source) {
+        int min = AudioRecord.getMinBufferSize(SpeechKit.STT_RATE, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT);
+        if (min <= 0) return null;
+        try {
+            AudioRecord r = new AudioRecord(source, SpeechKit.STT_RATE, AudioFormat.CHANNEL_IN_MONO,
+                    AudioFormat.ENCODING_PCM_16BIT, Math.max(min, FRAME * 2 * 10));
+            if (r.getState() == AudioRecord.STATE_INITIALIZED) return r;
+            r.release();
+        } catch (IllegalArgumentException | SecurityException | UnsupportedOperationException e) {
+            Log.w(TAG, "microphone source " + source + ": " + e.getMessage());
+        }
+        return null;
+    }
+
+    /** The TV's microphones as Android lists them, for the "nobody heard" message and the log. */
+    static List<String> inputs(Context ctx) {
+        List<String> names = new ArrayList<>();
+        AudioManager am = ctx.getSystemService(AudioManager.class);
+        if (am == null) return names;
+        for (AudioDeviceInfo d : am.getDevices(AudioManager.GET_DEVICES_INPUTS)) {
+            names.add(d.getProductName() + " (" + d.getType() + ")");
+        }
+        return names;
+    }
+
+    static double rms(short[] s) {
+        double sum = 0;
+        for (short v : s) sum += (double) v * v;
+        return Math.sqrt(sum / s.length);
+    }
+
+    private static byte[] bytes(short[] s) {
+        byte[] b = new byte[s.length * 2];
+        for (int i = 0; i < s.length; i++) {
+            b[2 * i] = (byte) s[i];
+            b[2 * i + 1] = (byte) (s[i] >> 8);
+        }
+        return b;
+    }
+
+    /**
+     * Voice activity by loudness, one frame (FRAME_MS) at a time. The first frames measure the room; a phrase starts
+     * when several frames in a row are clearly louder, and ends after a pause. A quiet room never starts one.
+     */
+    static final class Vad {
+        static final int WAITING = 0, SPEAKING = 1, DONE = 2, TIMEOUT = 3;
+        private static final int CALIBRATE = 10;               // 200 ms of room noise
+        private static final int START_FRAMES = 3;             // 60 ms above the threshold starts a phrase
+        private static final int END_FRAMES = 45;              // 900 ms of quiet ends it
+        private static final int MAX_WAIT = 7_000 / FRAME_MS;  // nobody spoke for 7 s
+        private static final int MAX_PHRASE = 15_000 / FRAME_MS;
+        private static final double MIN_THRESHOLD = 350;
+
+        private int frames, loudRun, quietRun, phraseFrames;
+        private double noise;
+        private boolean speaking;
+
+        int feed(double rms) {
+            frames++;
+            if (frames <= CALIBRATE) {
+                noise += rms / CALIBRATE;
+                return WAITING;
+            }
+            double threshold = Math.max(MIN_THRESHOLD, noise * 2.5);
+            if (!speaking) {
+                loudRun = rms > threshold ? loudRun + 1 : 0;
+                if (loudRun >= START_FRAMES) {
+                    speaking = true;
+                    quietRun = 0;
+                    return SPEAKING;
+                }
+                return frames > MAX_WAIT ? TIMEOUT : WAITING;
+            }
+            phraseFrames++;
+            quietRun = rms < threshold * 0.7 ? quietRun + 1 : 0;
+            if (quietRun >= END_FRAMES || phraseFrames >= MAX_PHRASE) return DONE;
+            return SPEAKING;
+        }
+
+        boolean heardVoice() {
+            return speaking;
+        }
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/JarvisSpeech.java b/launcher/app/src/main/java/com/gathin/tvhome/JarvisSpeech.java
new file mode 100644
index 0000000..301edcc
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/JarvisSpeech.java
@@ -0,0 +1,39 @@
+package com.gathin.tvhome;
+
+import java.util.regex.Pattern;
+
+/** A reply made fit to be read aloud: no links, markup or emoji, and not much longer than a few sentences. */
+final class JarvisSpeech {
+
+    private static final Pattern URL = Pattern.compile("https?://\\S+|www\\.\\S+");
+    private static final Pattern MARKDOWN_LINK = Pattern.compile("\\[([^\\]]*)\\]\\([^)]*\\)");
+    private static final Pattern MARKUP = Pattern.compile("[*_`#>|~]+");
+    private static final Pattern LIST_MARK = Pattern.compile("(?m)^\\s*(?:[-•–]|\\d+[.)])\\s+");
+    private static final Pattern SPACE = Pattern.compile("\\s+");
+    /** Enough for a full answer at the speed a person listens; longer text is cut at a sentence end. */
+    static final int MAX_CHARS = 600;
+
+    private JarvisSpeech() {
+    }
+
+    static String clean(String text) {
+        if (text == null) return "";
+        String s = MARKDOWN_LINK.matcher(text).replaceAll("$1");
+        s = URL.matcher(s).replaceAll("");
+        s = LIST_MARK.matcher(s).replaceAll("");
+        s = MARKUP.matcher(s).replaceAll("");
+        StringBuilder plain = new StringBuilder();
+        for (int i = 0; i < s.length(); ) {
+            int cp = s.codePointAt(i);
+            // Emoji and other pictographs are dropped; letters, digits and punctuation of any script stay.
+            if (Character.getType(cp) != Character.OTHER_SYMBOL && Character.getType(cp) != Character.SURROGATE) {
+                plain.appendCodePoint(cp);
+            }
+            i += Character.charCount(cp);
+        }
+        s = SPACE.matcher(plain).replaceAll(" ").replace(" ,", ",").replace(" .", ".").trim();
+        if (s.length() <= MAX_CHARS) return s;
+        int cut = Math.max(s.lastIndexOf(". ", MAX_CHARS), Math.max(s.lastIndexOf("! ", MAX_CHARS), s.lastIndexOf("? ", MAX_CHARS)));
+        return cut > MAX_CHARS / 3 ? s.substring(0, cut + 1) : s.substring(0, MAX_CHARS).trim() + "…";
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/JarvisTools.java b/launcher/app/src/main/java/com/gathin/tvhome/JarvisTools.java
new file mode 100644
index 0000000..6b58666
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/JarvisTools.java
@@ -0,0 +1,245 @@
+package com.gathin.tvhome;
+
+import android.app.SearchManager;
+import android.content.ActivityNotFoundException;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.media.AudioManager;
+import android.net.ConnectivityManager;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+
+import java.net.URLEncoder;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * The TV end of Jarvis's tools (JarvisBrain.TOOLS). Each call runs on the main thread, as starting activities and the
+ * audio service expect (the weather, a network call, stays on the caller's thread), and answers with one short sentence
+ * for Claude to relay.
+ */
+final class JarvisTools implements JarvisBrain.Tools {
+
+    private final Context ctx;
+    private final String vpnApp;
+    private final String vpnTunnel;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    /** An app was opened: once Jarvis has answered, his overlay steps aside. */
+    volatile boolean openedApp;
+
+    JarvisTools(Context ctx, String vpnApp, String vpnTunnel) {
+        this.ctx = ctx.getApplicationContext();
+        this.vpnApp = vpnApp;
+        this.vpnTunnel = vpnTunnel;
+    }
+
+    @Override
+    public String run(String name, Map<String, Object> input) throws Exception {
+        // The weather is a network call: it stays on the caller's (background) thread.
+        if ("get_weather".equals(name)) return weather();
+        AtomicReference<Object> out = new AtomicReference<>();
+        CountDownLatch done = new CountDownLatch(1);
+        main.post(() -> {
+            try {
+                out.set(runHere(name, input));
+            } catch (Exception e) {
+                out.set(e);
+            }
+            done.countDown();
+        });
+        if (!done.await(10, TimeUnit.SECONDS)) throw new Exception("телевизор не ответил");
+        if (out.get() instanceof Exception) throw (Exception) out.get();
+        return (String) out.get();
+    }
+
+    private String runHere(String name, Map<String, Object> in) throws Exception {
+        switch (name) {
+            case "open_app":
+                return openApp(str(in, "name"));
+            case "search_in_app":
+                return searchInApp(str(in, "app"), str(in, "query"));
+            case "set_volume":
+                return volume(str(in, "action"), in.get("level"));
+            case "vpn":
+                return vpn(str(in, "action"));
+            case "tv_action":
+                return tvAction(str(in, "action"));
+            default:
+                throw new Exception("нет такого инструмента: " + name);
+        }
+    }
+
+    // ---- apps ----------------------------------------------------------------------------------------
+
+    /** Label to launch component of every app with a TV or phone entry, TV entries first; this launcher left out. */
+    Map<String, ComponentName> apps() {
+        Map<String, ComponentName> found = new LinkedHashMap<>();
+        PackageManager pm = ctx.getPackageManager();
+        for (String category : new String[]{Intent.CATEGORY_LEANBACK_LAUNCHER, Intent.CATEGORY_LAUNCHER}) {
+            for (ResolveInfo r : pm.queryIntentActivities(new Intent(Intent.ACTION_MAIN).addCategory(category), 0)) {
+                if (r.activityInfo == null || r.activityInfo.packageName.equals(ctx.getPackageName())) continue;
+                String label = String.valueOf(r.loadLabel(pm)).trim();
+                boolean seen = false;
+                for (ComponentName c : found.values()) seen |= c.getPackageName().equals(r.activityInfo.packageName);
+                if (!seen && !label.isEmpty() && !found.containsKey(label)) {
+                    found.put(label, new ComponentName(r.activityInfo.packageName, r.activityInfo.name));
+                }
+            }
+        }
+        return found;
+    }
+
+    private String openApp(String name) throws Exception {
+        Map<String, ComponentName> apps = apps();
+        String label = AppMatch.best(name, apps.keySet());
+        if (label == null) throw new Exception("приложения «" + name + "» нет на телевизоре");
+        launch(apps.get(label));
+        return "Открыто приложение " + label + ".";
+    }
+
+    private String searchInApp(String appName, String query) throws Exception {
+        Map<String, ComponentName> apps = apps();
+        String label = AppMatch.best(appName, apps.keySet());
+        if (label == null) throw new Exception("приложения «" + appName + "» нет на телевизоре");
+        String pkg = apps.get(label).getPackageName();
+        PackageManager pm = ctx.getPackageManager();
+        Intent search = new Intent(Intent.ACTION_SEARCH).setPackage(pkg).putExtra(SearchManager.QUERY, query);
+        if (pm.resolveActivity(search, 0) != null && start(search)) {
+            openedApp = true;
+            return "В " + label + " открыт поиск: " + query + ".";
+        }
+        if (pkg.contains("youtube") || pkg.contains("smarttube")) {
+            Intent view = new Intent(Intent.ACTION_VIEW,
+                    Uri.parse("https://www.youtube.com/results?search_query=" + URLEncoder.encode(query, "UTF-8"))).setPackage(pkg);
+            if (pm.resolveActivity(view, 0) != null && start(view)) {
+                openedApp = true;
+                return "В " + label + " открыт поиск: " + query + ".";
+            }
+        }
+        launch(apps.get(label));
+        return "Приложение " + label + " открыто, но искать в нём само оно не позволяет: пусть пользователь найдёт «"
+                + query + "» сам.";
+    }
+
+    private void launch(ComponentName c) throws Exception {
+        Intent i = new Intent(Intent.ACTION_MAIN).setComponent(c);
+        if (!start(i)) throw new Exception("приложение не запустилось");
+        openedApp = true;
+    }
+
+    private boolean start(Intent i) {
+        try {
+            ctx.startActivity(i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED));
+            return true;
+        } catch (ActivityNotFoundException | SecurityException e) {
+            return false;
+        }
+    }
+
+    // ---- volume, VPN, TV ----------------------------------------------------------------------------------
+
+    private String volume(String action, Object level) throws Exception {
+        AudioManager am = ctx.getSystemService(AudioManager.class);
+        if (am == null) throw new Exception("звук недоступен");
+        int stream = AudioManager.STREAM_MUSIC, flags = AudioManager.FLAG_SHOW_UI;
+        int max = am.getStreamMaxVolume(stream);
+        switch (action) {
+            case "up":
+            case "down":
+                int step = Math.max(1, Math.round(max * 0.1f));
+                int now = am.getStreamVolume(stream) + ("up".equals(action) ? step : -step);
+                am.setStreamVolume(stream, Math.max(0, Math.min(max, now)), flags);
+                break;
+            case "set":
+                int percent = level instanceof Number ? ((Number) level).intValue() : 30;
+                am.setStreamVolume(stream, Math.round(max * Math.max(0, Math.min(100, percent)) / 100f), flags);
+                break;
+            case "mute":
+                am.adjustStreamVolume(stream, AudioManager.ADJUST_MUTE, flags);
+                return "Звук выключен.";
+            case "unmute":
+                am.adjustStreamVolume(stream, AudioManager.ADJUST_UNMUTE, flags);
+                break;
+            default:
+                throw new Exception("непонятное действие " + action);
+        }
+        return "Громкость " + Math.round(100f * am.getStreamVolume(stream) / Math.max(1, max)) + "%.";
+    }
+
+    static boolean vpnUp(Context ctx) {
+        ConnectivityManager cm = ctx.getSystemService(ConnectivityManager.class);
+        if (cm == null) return false;
+        for (Network n : cm.getAllNetworks()) {
+            NetworkCapabilities caps = cm.getNetworkCapabilities(n);
+            if (caps != null && caps.hasTransport(NetworkCapabilities.TRANSPORT_VPN)) return true;
+        }
+        return false;
+    }
+
+    private String vpn(String action) throws Exception {
+        boolean up = vpnUp(ctx);
+        if ("status".equals(action)) return up ? "VPN включён." : "VPN выключен.";
+        boolean want = "on".equals(action);
+        if (want == up) return want ? "VPN уже включён." : "VPN уже выключен.";
+        if (vpnApp.isEmpty()) throw new Exception("на телевизоре нет VPN-приложения");
+        if (!VpnControl.send(ctx, vpnApp, want, vpnTunnel)) throw new Exception("VPN-приложение не принимает команды");
+        return want ? "Команда на включение VPN отправлена." : "Команда на выключение VPN отправлена.";
+    }
+
+    private String tvAction(String action) throws Exception {
+        switch (action) {
+            case "home":
+                start(new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME).setPackage(ctx.getPackageName()));
+                openedApp = true;
+                return "Открыт главный экран.";
+            case "settings":
+                if (!start(SystemSettings.intent(ctx, Settings.ACTION_SETTINGS))) throw new Exception("настройки не открылись");
+                openedApp = true;
+                return "Открыты настройки.";
+            case "wifi":
+                if (!start(SystemSettings.intent(ctx, Settings.ACTION_WIFI_SETTINGS))) throw new Exception("настройки не открылись");
+                openedApp = true;
+                return "Открыты настройки Wi-Fi.";
+            case "inputs":
+            case "screensaver":
+                RemoteKeys.launch(ctx, "inputs".equals(action) ? RemoteKeys.INPUTS : "screensaver");
+                openedApp = true;
+                return "inputs".equals(action) ? "Открыт выбор источника." : "Заставка запущена.";
+            default:
+                throw new Exception("непонятное действие " + action);
+        }
+    }
+
+    private String weather() throws Exception {
+        HeaderExtras place = HeaderExtras.load(ctx);
+        if (!place.weather()) throw new Exception("место для погоды не выбрано: его задают в настройках лаунчера");
+        Weather w = Weather.parse(Weather.fetch(place.weatherLat, place.weatherLon));
+        String where = place.weatherCity.isEmpty() ? "дома" : place.weatherCity;
+        return String.format(Locale.ROOT, "%s: %s, %s.", where, Weather.temperature(w.temperature),
+                ctx.getString(w.label()).toLowerCase(new Locale("ru")));
+    }
+
+    private static String str(Map<String, Object> in, String key) {
+        Object v = in.get(key);
+        return v == null ? "" : String.valueOf(v).trim();
+    }
+
+    /** App labels for the system prompt, at most this many. */
+    List<String> labels(int max) {
+        List<String> out = new ArrayList<>(apps().keySet());
+        return out.size() > max ? out.subList(0, max) : out;
+    }
+}
