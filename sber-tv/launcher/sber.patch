+            text.setSpan(new RelativeSizeSpan(1.25f), 0, temperature.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            weatherView.setText(text);
+            weatherView.setCompoundDrawablesRelative(icon, null, null, null);
+        }
+        shown.setVisibility(View.VISIBLE);
+    }
