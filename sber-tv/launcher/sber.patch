+    /** The wallpaper grid counts tiles, the list pages count rows; the phone page has nothing to come back to. */
+    private void rememberFocus(Page page) {
+        if (rows != null) page.focus = gridPage ? focusedTile() : focusedRow();
+    }
+
+    private int focusedRow() {
+        View focus = getCurrentFocus();
+        if (rows == null || focus == null) return 0;
+        for (int i = 0; i < rows.getChildCount(); i++) {
+            View child = rows.getChildAt(i);
+            if (child == focus || child instanceof ViewGroup && focus.getParent() == child) return i;
+        }
+        return 0;
+    }
