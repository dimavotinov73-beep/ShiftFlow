@@ -0,0 +1,245 @@
+package com.gathin.tvhome;
+
+import android.app.SearchManager;
+import android.content.ActivityNotFoundException;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.media.AudioManager;
+import android.net.ConnectivityManager;
+import android.net.Network;
+import android.net.NetworkCapabilities;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+
+import java.net.URLEncoder;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicReference;
+
+/**
+ * The TV end of Jarvis's tools (JarvisBrain.TOOLS). Each call runs on the main thread, as starting activities and the
+ * audio service expect (the weather, a network call, stays on the caller's thread), and answers with one short sentence
+ * for Claude to relay.
+ */
+final class JarvisTools implements JarvisBrain.Tools {
+
+    private final Context ctx;
+    private final String vpnApp;
+    private final String vpnTunnel;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    /** An app was opened: once Jarvis has answered, his overlay steps aside. */
+    volatile boolean openedApp;
+
+    JarvisTools(Context ctx, String vpnApp, String vpnTunnel) {
+        this.ctx = ctx.getApplicationContext();
+        this.vpnApp = vpnApp;
+        this.vpnTunnel = vpnTunnel;
+    }
+
+    @Override
+    public String run(String name, Map<String, Object> input) throws Exception {
+        // The weather is a network call: it stays on the caller's (background) thread.
+        if ("get_weather".equals(name)) return weather();
+        AtomicReference<Object> out = new AtomicReference<>();
+        CountDownLatch done = new CountDownLatch(1);
+        main.post(() -> {
+            try {
+                out.set(runHere(name, input));
+            } catch (Exception e) {
+                out.set(e);
+            }
+            done.countDown();
+        });
+        if (!done.await(10, TimeUnit.SECONDS)) throw new Exception("телевизор не ответил");
+        if (out.get() instanceof Exception) throw (Exception) out.get();
+        return (String) out.get();
+    }
+
+    private String runHere(String name, Map<String, Object> in) throws Exception {
+        switch (name) {
+            case "open_app":
+                return openApp(str(in, "name"));
+            case "search_in_app":
+                return searchInApp(str(in, "app"), str(in, "query"));
+            case "set_volume":
+                return volume(str(in, "action"), in.get("level"));
+            case "vpn":
+                return vpn(str(in, "action"));
+            case "tv_action":
+                return tvAction(str(in, "action"));
+            default:
+                throw new Exception("нет такого инструмента: " + name);
+        }
+    }
+
+    // ---- apps ----------------------------------------------------------------------------------------
+
+    /** Label to launch component of every app with a TV or phone entry, TV entries first; this launcher left out. */
+    Map<String, ComponentName> apps() {
+        Map<String, ComponentName> found = new LinkedHashMap<>();
+        PackageManager pm = ctx.getPackageManager();
+        for (String category : new String[]{Intent.CATEGORY_LEANBACK_LAUNCHER, Intent.CATEGORY_LAUNCHER}) {
+            for (ResolveInfo r : pm.queryIntentActivities(new Intent(Intent.ACTION_MAIN).addCategory(category), 0)) {
+                if (r.activityInfo == null || r.activityInfo.packageName.equals(ctx.getPackageName())) continue;
+                String label = String.valueOf(r.loadLabel(pm)).trim();
+                boolean seen = false;
+                for (ComponentName c : found.values()) seen |= c.getPackageName().equals(r.activityInfo.packageName);
+                if (!seen && !label.isEmpty() && !found.containsKey(label)) {
+                    found.put(label, new ComponentName(r.activityInfo.packageName, r.activityInfo.name));
+                }
+            }
+        }
+        return found;
+    }
+
+    private String openApp(String name) throws Exception {
+        Map<String, ComponentName> apps = apps();
+        String label = AppMatch.best(name, apps.keySet());
+        if (label == null) throw new Exception("приложения «" + name + "» нет на телевизоре");
+        launch(apps.get(label));
+        return "Открыто приложение " + label + ".";
+    }
+
+    private String searchInApp(String appName, String query) throws Exception {
+        Map<String, ComponentName> apps = apps();
+        String label = AppMatch.best(appName, apps.keySet());
+        if (label == null) throw new Exception("приложения «" + appName + "» нет на телевизоре");
+        String pkg = apps.get(label).getPackageName();
+        PackageManager pm = ctx.getPackageManager();
+        Intent search = new Intent(Intent.ACTION_SEARCH).setPackage(pkg).putExtra(SearchManager.QUERY, query);
+        if (pm.resolveActivity(search, 0) != null && start(search)) {
+            openedApp = true;
+            return "В " + label + " открыт поиск: " + query + ".";
+        }
+        if (pkg.contains("youtube") || pkg.contains("smarttube")) {
+            Intent view = new Intent(Intent.ACTION_VIEW,
+                    Uri.parse("https://www.youtube.com/results?search_query=" + URLEncoder.encode(query, "UTF-8"))).setPackage(pkg);
+            if (pm.resolveActivity(view, 0) != null && start(view)) {
+                openedApp = true;
+                return "В " + label + " открыт поиск: " + query + ".";
+            }
+        }
+        launch(apps.get(label));
+        return "Приложение " + label + " открыто, но искать в нём само оно не позволяет: пусть пользователь найдёт «"
+                + query + "» сам.";
+    }
+
+    private void launch(ComponentName c) throws Exception {
+        Intent i = new Intent(Intent.ACTION_MAIN).setComponent(c);
+        if (!start(i)) throw new Exception("приложение не запустилось");
+        openedApp = true;
+    }
+
+    private boolean start(Intent i) {
+        try {
+            ctx.startActivity(i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_RESET_TASK_IF_NEEDED));
+            return true;
+        } catch (ActivityNotFoundException | SecurityException e) {
+            return false;
+        }
+    }
+
+    // ---- volume, VPN, TV ----------------------------------------------------------------------------------
+
+    private String volume(String action, Object level) throws Exception {
+        AudioManager am = ctx.getSystemService(AudioManager.class);
+        if (am == null) throw new Exception("звук недоступен");
+        int stream = AudioManager.STREAM_MUSIC, flags = AudioManager.FLAG_SHOW_UI;
+        int max = am.getStreamMaxVolume(stream);
+        switch (action) {
+            case "up":
+            case "down":
+                int step = Math.max(1, Math.round(max * 0.1f));
+                int now = am.getStreamVolume(stream) + ("up".equals(action) ? step : -step);
+                am.setStreamVolume(stream, Math.max(0, Math.min(max, now)), flags);
+                break;
+            case "set":
+                int percent = level instanceof Number ? ((Number) level).intValue() : 30;
+                am.setStreamVolume(stream, Math.round(max * Math.max(0, Math.min(100, percent)) / 100f), flags);
+                break;
+            case "mute":
+                am.adjustStreamVolume(stream, AudioManager.ADJUST_MUTE, flags);
+                return "Звук выключен.";
+            case "unmute":
+                am.adjustStreamVolume(stream, AudioManager.ADJUST_UNMUTE, flags);
+                break;
+            default:
+                throw new Exception("непонятное действие " + action);
+        }
+        return "Громкость " + Math.round(100f * am.getStreamVolume(stream) / Math.max(1, max)) + "%.";
+    }
+
+    static boolean vpnUp(Context ctx) {
+        ConnectivityManager cm = ctx.getSystemService(ConnectivityManager.class);
+        if (cm == null) return false;
+        for (Network n : cm.getAllNetworks()) {
+            NetworkCapabilities caps = cm.getNetworkCapabilities(n);
+            if (caps != null && caps.hasTransport(NetworkCapabilities.TRANSPORT_VPN)) return true;
+        }
+        return false;
+    }
+
+    private String vpn(String action) throws Exception {
+        boolean up = vpnUp(ctx);
+        if ("status".equals(action)) return up ? "VPN включён." : "VPN выключен.";
+        boolean want = "on".equals(action);
+        if (want == up) return want ? "VPN уже включён." : "VPN уже выключен.";
+        if (vpnApp.isEmpty()) throw new Exception("на телевизоре нет VPN-приложения");
+        if (!VpnControl.send(ctx, vpnApp, want, vpnTunnel)) throw new Exception("VPN-приложение не принимает команды");
+        return want ? "Команда на включение VPN отправлена." : "Команда на выключение VPN отправлена.";
+    }
+
+    private String tvAction(String action) throws Exception {
+        switch (action) {
+            case "home":
+                start(new Intent(Intent.ACTION_MAIN).addCategory(Intent.CATEGORY_HOME).setPackage(ctx.getPackageName()));
+                openedApp = true;
+                return "Открыт главный экран.";
+            case "settings":
+                if (!start(SystemSettings.intent(ctx, Settings.ACTION_SETTINGS))) throw new Exception("настройки не открылись");
+                openedApp = true;
+                return "Открыты настройки.";
+            case "wifi":
+                if (!start(SystemSettings.intent(ctx, Settings.ACTION_WIFI_SETTINGS))) throw new Exception("настройки не открылись");
+                openedApp = true;
+                return "Открыты настройки Wi-Fi.";
+            case "inputs":
+            case "screensaver":
+                RemoteKeys.launch(ctx, "inputs".equals(action) ? RemoteKeys.INPUTS : "screensaver");
+                openedApp = true;
+                return "inputs".equals(action) ? "Открыт выбор источника." : "Заставка запущена.";
+            default:
+                throw new Exception("непонятное действие " + action);
+        }
+    }
+
+    private String weather() throws Exception {
+        HeaderExtras place = HeaderExtras.load(ctx);
+        if (!place.weather()) throw new Exception("место для погоды не выбрано: его задают в настройках лаунчера");
+        Weather w = Weather.parse(Weather.fetch(place.weatherLat, place.weatherLon));
+        String where = place.weatherCity.isEmpty() ? "дома" : place.weatherCity;
+        return String.format(Locale.ROOT, "%s: %s, %s.", where, Weather.temperature(w.temperature),
+                ctx.getString(w.label()).toLowerCase(new Locale("ru")));
+    }
+
+    private static String str(Map<String, Object> in, String key) {
+        Object v = in.get(key);
+        return v == null ? "" : String.valueOf(v).trim();
+    }
+
+    /** App labels for the system prompt, at most this many. */
+    List<String> labels(int max) {
+        List<String> out = new ArrayList<>(apps().keySet());
+        return out.size() > max ? out.subList(0, max) : out;
+    }
+}
