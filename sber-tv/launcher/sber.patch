+        top.setGravity(Gravity.CENTER_VERTICAL);
+        place = text(ctx, 16, 0xFFFFFFFF, R.string.font_semibold);
+        top.addView(place, new LayoutParams(0, LayoutParams.WRAP_CONTENT, 1));
+        icon = new ImageView(ctx);
+        top.addView(icon, new LayoutParams(dp(30), dp(30)));
+        addView(top, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT));
+
+        LinearLayout middle = new LinearLayout(ctx);
+        middle.setGravity(Gravity.BOTTOM);
+        temperature = text(ctx, 44, 0xFFFFFFFF, R.string.font_light);
+        middle.addView(temperature, new LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT));
+        LinearLayout side = new LinearLayout(ctx);
+        side.setOrientation(VERTICAL);
+        side.setGravity(Gravity.END);
+        conditions = text(ctx, 15, 0xFFFFFFFF, R.string.font_medium);
+        conditions.setGravity(Gravity.END);
+        range = text(ctx, 14, 0xD9FFFFFF, R.string.font_regular);
+        range.setGravity(Gravity.END);
+        side.addView(conditions, new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT));
+        LayoutParams rp = new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT);
+        rp.topMargin = dp(4);
+        side.addView(range, rp);
+        LayoutParams sp = new LayoutParams(0, LayoutParams.WRAP_CONTENT, 1);
+        sp.leftMargin = dp(12);
+        sp.bottomMargin = dp(8);
+        middle.addView(side, sp);
+        LayoutParams mp = new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT);
+        mp.topMargin = dp(2);
+        addView(middle, mp);
+
+        hours = new LinearLayout(ctx);
+        hours.setOrientation(HORIZONTAL);
+        LayoutParams hp = new LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.WRAP_CONTENT);
+        hp.topMargin = dp(10);
+        addView(hours, hp);
+    }
+
+    /** Fills the card from a reading; the hours row goes when the reading has no forecast (an older cached one). */
+    void show(Weather now, Weather.Forecast forecast, String city) {
+        place.setText(city.isEmpty() ? getContext().getString(R.string.weather_label) : city);
+        temperature.setText(Weather.temperature(now.temperature));
+        conditions.setText(now.label());
+        icon.setImageDrawable(getContext().getDrawable(now.icon()));
+        card.setColors(sky(now));
+        if (forecast == null) {
+            range.setVisibility(GONE);
+            hours.setVisibility(GONE);
+        } else {
+            range.setText(getContext().getString(R.string.weather_range,
+                    Weather.temperature(forecast.max), Weather.temperature(forecast.min)));
+            range.setVisibility(VISIBLE);
+            hours.removeAllViews();
+            for (Weather.Hour h : forecast.hours) hours.addView(hour(h), new LayoutParams(0, LayoutParams.WRAP_CONTENT, 1));
+            hours.setVisibility(forecast.hours.isEmpty() ? GONE : VISIBLE);
+        }
+        setContentDescription(place.getText() + ", " + temperature.getText() + ", " + conditions.getText());
+    }
+
+    private View hour(Weather.Hour h) {
+        LinearLayout col = new LinearLayout(getContext());
+        col.setOrientation(VERTICAL);
+        col.setGravity(Gravity.CENTER_HORIZONTAL);
+        TextView time = text(getContext(), 13, 0xCCFFFFFF, R.string.font_medium);
+        time.setText(h.time);
+        col.addView(time);
+        ImageView glyph = new ImageView(getContext());
+        Drawable d = getContext().getDrawable(h.weather.icon());
+        glyph.setImageDrawable(d);
+        LayoutParams gp = new LayoutParams(dp(22), dp(22));
+        gp.topMargin = dp(5);
+        gp.bottomMargin = dp(5);
+        col.addView(glyph, gp);
+        TextView t = text(getContext(), 14, 0xFFFFFFFF, R.string.font_medium);
+        t.setText(Weather.temperature(h.weather.temperature));
+        col.addView(t);
+        return col;
+    }
+
+    /** The card's colours, top-left to bottom-right, from the sky the reading describes. */
+    static int[] sky(Weather w) {
+        if (!w.day) return new int[]{0xFF22305A, 0xFF0E1630};
+        switch (w.kind) {
+            case CLEAR: return new int[]{0xFF4FA0F0, 0xFF2D6CD0};
+            case PARTLY: return new int[]{0xFF5B92D6, 0xFF3A6AAE};
+            case FOG:
+            case CLOUDY: return new int[]{0xFF8291A5, 0xFF56657A};
+            case SNOW: return new int[]{0xFF94A8BF, 0xFF627790};
+            default: return new int[]{0xFF63748C, 0xFF3A475B};   // rain, drizzle, storm
+        }
+    }
+
+    private TextView text(Context ctx, int sp, int colour, int font) {
+        TextView t = new TextView(ctx);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(colour);
+        t.setSingleLine(true);
+        t.setEllipsize(TextUtils.TruncateAt.END);
+        t.setIncludeFontPadding(false);
+        t.setTypeface(UiFont.get(ctx, font));
+        return t;
+    }
+
+    private int dp(int value) {
+        return Math.round(value * density);
+    }
+}
