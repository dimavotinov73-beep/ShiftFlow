+    private void focusRestored() {
+        Page top = pages.peek();
+        int index = top == null ? 0 : top.focus;
+        View target = null;
+        for (int i = Math.min(index, rows.getChildCount() - 1); i >= 0 && target == null; i--) {
+            View child = rows.getChildAt(i);
+            if (child.isFocusable()) target = child;
+        }
+        for (int i = 0; target == null && i < rows.getChildCount(); i++) {
+            if (rows.getChildAt(i).isFocusable()) target = rows.getChildAt(i);
+        }
+        if (target != null) {
+            View t = target;
+            t.post(t::requestFocus);
+        }
+    }
