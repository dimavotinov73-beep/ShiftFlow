@@ -0,0 +1,39 @@
+package com.gathin.tvhome;
+
+import java.util.regex.Pattern;
+
+/** A reply made fit to be read aloud: no links, markup or emoji, and not much longer than a few sentences. */
+final class JarvisSpeech {
+
+    private static final Pattern URL = Pattern.compile("https?://\\S+|www\\.\\S+");
+    private static final Pattern MARKDOWN_LINK = Pattern.compile("\\[([^\\]]*)\\]\\([^)]*\\)");
+    private static final Pattern MARKUP = Pattern.compile("[*_`#>|~]+");
+    private static final Pattern LIST_MARK = Pattern.compile("(?m)^\\s*(?:[-•–]|\\d+[.)])\\s+");
+    private static final Pattern SPACE = Pattern.compile("\\s+");
+    /** Enough for a full answer at the speed a person listens; longer text is cut at a sentence end. */
+    static final int MAX_CHARS = 600;
+
+    private JarvisSpeech() {
+    }
+
+    static String clean(String text) {
+        if (text == null) return "";
+        String s = MARKDOWN_LINK.matcher(text).replaceAll("$1");
+        s = URL.matcher(s).replaceAll("");
+        s = LIST_MARK.matcher(s).replaceAll("");
+        s = MARKUP.matcher(s).replaceAll("");
+        StringBuilder plain = new StringBuilder();
+        for (int i = 0; i < s.length(); ) {
+            int cp = s.codePointAt(i);
+            // Emoji and other pictographs are dropped; letters, digits and punctuation of any script stay.
+            if (Character.getType(cp) != Character.OTHER_SYMBOL && Character.getType(cp) != Character.SURROGATE) {
+                plain.appendCodePoint(cp);
+            }
+            i += Character.charCount(cp);
+        }
+        s = SPACE.matcher(plain).replaceAll(" ").replace(" ,", ",").replace(" .", ".").trim();
+        if (s.length() <= MAX_CHARS) return s;
+        int cut = Math.max(s.lastIndexOf(". ", MAX_CHARS), Math.max(s.lastIndexOf("! ", MAX_CHARS), s.lastIndexOf("? ", MAX_CHARS)));
+        return cut > MAX_CHARS / 3 ? s.substring(0, cut + 1) : s.substring(0, MAX_CHARS).trim() + "…";
+    }
+}
