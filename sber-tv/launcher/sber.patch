diff --git a/launcher/app/src/main/res/drawable/pill_bg_on_light.xml b/launcher/app/src/main/res/drawable/pill_bg_on_light.xml
new file mode 100644
index 00000000..14e59caf
--- /dev/null
+++ b/launcher/app/src/main/res/drawable/pill_bg_on_light.xml
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Sber edition: pill_bg over a light wallpaper (WallpaperTone): the same states in dark glass, so the white icons
+     stay readable over a misty sky; focus is still solid white. -->
+<selector xmlns:android="http://schemas.android.com/apk/res/android">
+    <item android:state_focused="true">
+        <shape android:shape="rectangle">
+            <solid android:color="#F5FFFFFF" />
+            <corners android:radius="21dp" />
+        </shape>
+    </item>
+    <item android:state_activated="true">
+        <shape android:shape="rectangle">
+            <solid android:color="#996EC1FF" />
+            <stroke android:width="1.5dp" android:color="#FF6EC1FF" />
+            <corners android:radius="21dp" />
+        </shape>
+    </item>
+    <item android:state_selected="true">
+        <shape android:shape="rectangle">
+            <gradient android:angle="270" android:startColor="#991C1C1E" android:endColor="#801C1C1E" />
+            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
+            <corners android:radius="21dp" />
+        </shape>
+    </item>
+    <item>
+        <shape android:shape="rectangle">
+            <gradient android:angle="270" android:startColor="#661C1C1E" android:endColor="#4D1C1C1E" />
+            <stroke android:width="1dp" android:color="#29FFFFFF" />
+            <corners android:radius="21dp" />
+        </shape>
+    </item>
+</selector>
