+        View focus = getCurrentFocus();
+        boolean inPane = focus != null && !inside(focus, sidebar) || paneFocus;
+        if (inPane && pages.size() > 1) {
+            stopLink();
+            pages.pop();
+            run(pages.peek().build);
+        } else if (inPane) {
