+    @Override
+    public boolean dispatchKeyEvent(KeyEvent event) {
+        if (event.getAction() == KeyEvent.ACTION_DOWN) {
+            View focus = getCurrentFocus();
+            int key = event.getKeyCode();
+            if (focus != null && inside(focus, sidebar)) {
+                int index = sidebar.indexOfChild(focus);
+                if (key == KeyEvent.KEYCODE_DPAD_RIGHT) {
+                    enterPane();
+                    return true;
+                }
+                // The list's ends and its left side lead nowhere: focus stays in the sidebar.
+                if (key == KeyEvent.KEYCODE_DPAD_LEFT || key == KeyEvent.KEYCODE_DPAD_UP && index <= 0
+                        || key == KeyEvent.KEYCODE_DPAD_DOWN && index >= sidebar.getChildCount() - 1) return true;
+            } else if (focus != null && key == KeyEvent.KEYCODE_DPAD_LEFT && inside(focus, stage)
+                    && FocusFinder.getInstance().findNextFocus(stage, focus, View.FOCUS_LEFT) == null) {
+                focusSidebar();
+                return true;
+            }
+        }
+        return super.dispatchKeyEvent(event);
+    }
