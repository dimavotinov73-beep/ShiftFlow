@@ -0,0 +1,161 @@
+package com.gathin.tvhome;
+
+import android.media.AudioAttributes;
+import android.media.AudioFormat;
+import android.media.AudioTrack;
+
+/**
+ * Plays Jarvis's speech and his activation chime: 16-bit mono PCM at SpeechKit.TTS_RATE through one AudioTrack on a
+ * thread of its own, so a reply finishes even after the activity has closed (an app it opened is in front by then).
+ * One sound at a time: a new one stops the last.
+ */
+final class JarvisVoice {
+
+    interface Listener {
+        /** 0..1 while playing, about fifty times a second, on the playback thread. */
+        void level(float level);
+
+        /** Finished or stopped, on the playback thread. */
+        void done();
+    }
+
+    /** One sound being played; its own stop flag, so a slow one never plays on after the next has started. */
+    private static final class Playback {
+        volatile boolean stop;
+        Thread thread;
+    }
+
+    private static Playback current;
+
+    private JarvisVoice() {
+    }
+
+    static synchronized void play(byte[] pcm, boolean effect, Listener listener) {
+        stop();
+        short[] samples = samples(pcm);
+        if (effect) samples = room(samples, SpeechKit.TTS_RATE);
+        short[] sound = samples;
+        Playback p = new Playback();
+        p.thread = new Thread(() -> run(sound, p, listener), "jarvis-voice");
+        current = p;
+        p.thread.start();
+    }
+
+    /** The activation sound: two soft rising tones, a little under a third of a second. */
+    static void chime(Listener listener) {
+        int rate = SpeechKit.TTS_RATE;
+        short[] a = tone(rate, 880, 0.09), b = tone(rate, 1318.5, 0.14);
+        short[] both = new short[a.length + b.length];
+        System.arraycopy(a, 0, both, 0, a.length);
+        System.arraycopy(b, 0, both, a.length, b.length);
+        byte[] pcm = new byte[both.length * 2];
+        for (int i = 0; i < both.length; i++) {
+            pcm[2 * i] = (byte) both[i];
+            pcm[2 * i + 1] = (byte) (both[i] >> 8);
+        }
+        play(pcm, false, listener);
+    }
+
+    static synchronized void stop() {
+        Playback p = current;
+        current = null;
+        if (p == null) return;
+        p.stop = true;
+        try {
+            p.thread.join(300);
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        }
+    }
+
+    private static void run(short[] sound, Playback p, Listener listener) {
+        int rate = SpeechKit.TTS_RATE;
+        int min = AudioTrack.getMinBufferSize(rate, AudioFormat.CHANNEL_OUT_MONO, AudioFormat.ENCODING_PCM_16BIT);
+        AudioTrack track = new AudioTrack.Builder()
+                .setAudioAttributes(new AudioAttributes.Builder()
+                        .setUsage(AudioAttributes.USAGE_ASSISTANT)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH).build())
+                .setAudioFormat(new AudioFormat.Builder().setSampleRate(rate)
+                        .setEncoding(AudioFormat.ENCODING_PCM_16BIT).setChannelMask(AudioFormat.CHANNEL_OUT_MONO).build())
+                .setBufferSizeInBytes(Math.max(min, rate / 5 * 2))
+                .setTransferMode(AudioTrack.MODE_STREAM)
+                .build();
+        int chunk = rate / 50;   // 20 ms
+        try {
+            track.play();
+            for (int pos = 0; pos < sound.length && !p.stop; pos += chunk) {
+                int n = Math.min(chunk, sound.length - pos);
+                double sum = 0;
+                for (int i = pos; i < pos + n; i++) sum += (double) sound[i] * sound[i];
+                if (listener != null) listener.level((float) Math.min(1.0, Math.sqrt(sum / n) / 8000.0));
+                track.write(sound, pos, n);
+            }
+            if (!p.stop) {
+                // Let the last buffer play out before the track goes.
+                try {
+                    Thread.sleep(Math.max(0, track.getBufferSizeInFrames() * 1000L / rate));
+                } catch (InterruptedException ignored) {
+                    Thread.currentThread().interrupt();
+                }
+            }
+        } catch (IllegalStateException ignored) {
+            // the audio output went away (TV switched source); nothing to play to
+        } finally {
+            try {
+                track.stop();
+            } catch (IllegalStateException ignored) {
+                // never started
+            }
+            track.release();
+            if (listener != null) listener.done();
+        }
+    }
+
+    static short[] samples(byte[] pcm) {
+        short[] s = new short[pcm.length / 2];
+        for (int i = 0; i < s.length; i++) s[i] = (short) ((pcm[2 * i] & 0xFF) | (pcm[2 * i + 1] << 8));
+        return s;
+    }
+
+    /**
+     * The voice "through the suit": a gentle high-pass (thinner, like a small speaker) and two very short echoes that
+     * give it a faint metallic ring, then normalised so it is as loud as it came. Subtle on purpose: words stay clear.
+     */
+    static short[] room(short[] in, int rate) {
+        int d1 = rate * 7 / 1000, d2 = rate * 13 / 1000;
+        double[] y = new double[in.length];
+        // First-order high-pass at about 120 Hz.
+        double rc = 1.0 / (2 * Math.PI * 120), dt = 1.0 / rate, a = rc / (rc + dt);
+        double prevX = 0, prevY = 0, peakIn = 1, peakOut = 1;
+        double[] hp = new double[in.length];
+        for (int i = 0; i < in.length; i++) {
+            double x = in[i];
+            prevY = a * (prevY + x - prevX);
+            prevX = x;
+            hp[i] = prevY;
+            peakIn = Math.max(peakIn, Math.abs(x));
+        }
+        for (int i = 0; i < in.length; i++) {
+            double v = 0.86 * hp[i];
+            if (i >= d1) v += 0.24 * hp[i - d1];
+            if (i >= d2) v += 0.14 * hp[i - d2];
+            y[i] = v;
+            peakOut = Math.max(peakOut, Math.abs(v));
+        }
+        double gain = Math.min(32000.0, peakIn) / peakOut;
+        short[] out = new short[in.length];
+        for (int i = 0; i < in.length; i++) out[i] = (short) Math.max(-32768, Math.min(32767, Math.round(y[i] * gain)));
+        return out;
+    }
+
+    private static short[] tone(int rate, double hz, double seconds) {
+        int n = (int) (rate * seconds);
+        short[] s = new short[n];
+        for (int i = 0; i < n; i++) {
+            double t = (double) i / n;
+            double envelope = Math.min(1.0, t * 12) * Math.pow(1 - t, 1.6);   // quick rise, soft fade
+            s[i] = (short) (Math.sin(2 * Math.PI * hz * i / rate) * envelope * 6500);
+        }
+        return s;
+    }
+}
