@@ -0,0 +1,49 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.io.File;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+public class StockWallpapersTest {
+
+    @Test
+    public void theCategoryComesFromTheName() {
+        assertEquals("1-iphone", StockWallpapers.category("stock-1-iphone-1-graphite.jpg"));
+        assertEquals("2-mountains", StockWallpapers.category("stock-2-mountains-3-matterhorn.jpg"));
+        assertEquals("5-space", StockWallpapers.category("stock-5-space-2-aurora-cities.jpg"));
+        assertNull(StockWallpapers.category("phone-20261026-101500-1.jpg"));
+        assertNull(StockWallpapers.category("stock-01-graphite-teal.jpg"));   // an earlier set's name
+        assertNull(StockWallpapers.category("photo-01.jpg"));
+    }
+
+    @Test
+    public void onlyWhatEarlierThemesPushedIsLegacy() {
+        for (String name : new String[]{"scene-02-lake.jpg", "nature-03-x.jpg", "sweden-01-y.jpg", "daytime-2-evening.jpg",
+                "view-07-peak-at-dusk.jpg", "aurora.jpg", "dark-glass.jpg", "autumn-lake.jpg"}) {
+            assertTrue(name, StockWallpapers.legacy(name));
+        }
+        // The owner's own pictures stay: from the phone over QR, and from look's "own photos".
+        assertFalse(StockWallpapers.legacy("phone-20261026-101500-1.jpg"));
+        assertFalse(StockWallpapers.legacy("photo-01.jpg"));
+        assertFalse(StockWallpapers.legacy("stock-1-iphone-1-graphite.jpg"));
+    }
+
+    @Test
+    public void theGridShowsTheStockSetFirstThenThePhonesPhotos() {
+        List<File> images = new ArrayList<>(Arrays.asList(new File("photo-01.jpg"), new File("phone-2.jpg"),
+                new File("stock-2-mountains-1-norway-fjord.jpg"), new File("stock-1-iphone-1-graphite.jpg")));
+        StockWallpapers.sort(images);
+        assertEquals("stock-1-iphone-1-graphite.jpg", images.get(0).getName());
+        assertEquals("stock-2-mountains-1-norway-fjord.jpg", images.get(1).getName());
+        assertEquals("phone-2.jpg", images.get(2).getName());
+        assertEquals("photo-01.jpg", images.get(3).getName());
+    }
+}
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/WallpaperToneTest.java b/launcher/app/src/test/java/com/gathin/tvhome/WallpaperToneTest.java
new file mode 100644
index 00000000..e8e67493
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/WallpaperToneTest.java
@@ -0,0 +1,112 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import java.util.Arrays;
+
+public class WallpaperToneTest {
+
+    private static int[] filled(int argb, int count) {
+        int[] pixels = new int[count];
+        Arrays.fill(pixels, argb);
+        return pixels;
+    }
+
+    private static float lightness(int argb) {
+        float[] hsl = WallpaperTone.hsl((argb >> 16) & 0xFF, (argb >> 8) & 0xFF, argb & 0xFF);
+        return hsl[2];
+    }
+
+    @Test
+    public void aMistySkyGetsDarkInk() {
+        WallpaperTone.Tone tone = WallpaperTone.of(filled(0xFFDCE3EA, 100));
+        assertTrue(tone.light);
+        assertTrue(lightness(tone.clock) < 0.3f);
+        assertTrue(lightness(tone.primary) < 0.3f);
+        assertEquals("no shadow under dark ink", 0, tone.shadow);
+        // The clock is a little see-through, as on a phone's lock screen.
+        assertTrue((tone.clock >>> 24) < 0xFF);
+    }
+
+    @Test
+    public void theInkTakesThePicturesHue() {
+        // A light blue sky: the ink is a deep blue, not a neutral grey.
+        WallpaperTone.Tone tone = WallpaperTone.of(filled(0xFF9FC3F0, 100));
+        assertTrue(tone.light);
+        int ink = tone.primary;
+        int r = (ink >> 16) & 0xFF, b = ink & 0xFF;
+        assertTrue("bluish: r=" + r + " b=" + b, b > r);
+    }
+
+    @Test
+    public void aDarkPictureGetsLightTextWithASoftShadow() {
+        WallpaperTone.Tone tone = WallpaperTone.of(filled(0xFF101418, 100));
+        assertFalse(tone.light);
+        assertTrue(lightness(tone.clock) > 0.9f);
+        assertTrue(tone.shadow != 0);
+    }
+
+    @Test
+    public void aMiddlingPictureGetsAStrongerShadow() {
+        WallpaperTone.Tone dark = WallpaperTone.of(filled(0xFF101418, 100));
+        WallpaperTone.Tone middling = WallpaperTone.of(filled(0xFF8A8A8A, 100));
+        assertFalse(middling.light);
+        assertTrue(middling.shadowRadiusDp > dark.shadowRadiusDp);
+        assertTrue((middling.shadow >>> 24) > (dark.shadow >>> 24));
+    }
+
+    @Test
+    public void aFewBrightCloudsInADarkPictureDoNotTurnTheTextDark() {
+        int[] pixels = filled(0xFF14181C, 100);
+        for (int i = 0; i < 10; i++) pixels[i] = 0xFFFFFFFF;
+        assertFalse(WallpaperTone.of(pixels).light);
+    }
+
+    @Test
+    public void nothingToReadKeepsWhiteText() {
+        assertSame(WallpaperTone.DEFAULT, WallpaperTone.of(new int[0]));
+        assertSame(WallpaperTone.DEFAULT, WallpaperTone.of(null));
+        assertSame(WallpaperTone.DEFAULT, WallpaperTone.of(filled(0x00FFFFFF, 10)));   // all transparent
+    }
+
+    @Test
+    public void theRegionIsTakenRowByRow() {
+        // 4 x 2 picture, values are their index.
+        int[] pixels = {0, 1, 2, 3, 4, 5, 6, 7};
+        assertArrayEquals(new int[]{0, 1, 4, 5}, WallpaperTone.region(pixels, 4, 2, 0f, 0f, 0.5f, 1f));
+        assertArrayEquals(new int[]{2, 3}, WallpaperTone.region(pixels, 4, 2, 0.5f, 0f, 1f, 0.5f));
+        assertEquals(0, WallpaperTone.region(pixels, 4, 2, 0.5f, 0.5f, 0.5f, 1f).length);
+    }
+
+    @Test
+    public void hslRoundTrips() {
+        for (int rgb : new int[]{0xFF336699, 0xFFFF0000, 0xFF00FF00, 0xFF808080, 0xFFFFC93C}) {
+            float[] hsl = WallpaperTone.hsl((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, rgb & 0xFF);
+            int back = WallpaperTone.rgb(hsl[0], hsl[1], hsl[2]);
+            for (int shift : new int[]{16, 8, 0}) {
+                assertEquals(Integer.toHexString(rgb), (rgb >> shift) & 0xFF, (back >> shift) & 0xFF, 1);
+            }
+        }
+    }
+
+    @Test
+    public void frostAveragesNeighboursAndKeepsAFlatPicture() {
+        int[] flat = filled(0xFF336699, 64);
+        Frost.blur(flat, 8, 8, 2, 3);
+        for (int p : flat) assertEquals(0xFF336699, p);
+        // One white pixel in black spreads out and fades.
+        int[] dot = filled(0xFF000000, 81);
+        dot[40] = 0xFFFFFFFF;
+        Frost.blur(dot, 9, 9, 1, 1);
+        int centre = dot[40] & 0xFF, beside = dot[41] & 0xFF, far = dot[0] & 0xFF;
+        assertTrue(centre > 0 && centre < 255);
+        assertEquals(centre, beside);
+        assertEquals(0, far);
+    }
+}
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/WeatherTest.java b/launcher/app/src/test/java/com/gathin/tvhome/WeatherTest.java
new file mode 100644
index 00000000..59e97bcb
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/WeatherTest.java
@@ -0,0 +1,95 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONException;
+import org.junit.Test;
+
+public class WeatherTest {
+
+    /** Trimmed from a real api.open-meteo.com answer for Moscow. */
+    private static final String BODY = "{\"latitude\":55.75,\"longitude\":37.625,\"current_units\":{\"temperature_2m\":\"°C\"},"
+            + "\"current\":{\"time\":\"2026-10-26T23:15\",\"interval\":900,\"temperature_2m\":6.6,\"weather_code\":3,\"is_day\":0}}";
+
+    @Test
+    public void parsesTheCurrentReading() throws JSONException {
+        Weather w = Weather.parse(BODY);
+        assertEquals(6.6, w.temperature, 1e-9);
+        assertEquals(Weather.Kind.CLOUDY, w.kind);
+        assertFalse(w.day);
+        assertEquals(R.drawable.ic_wx_cloudy, w.icon());
+        assertEquals(R.string.weather_cloudy, w.label());
+    }
+
+    @Test
+    public void clearNightShowsTheMoon() throws JSONException {
+        Weather w = Weather.parse(BODY.replace("\"weather_code\":3", "\"weather_code\":0"));
+        assertEquals(R.drawable.ic_wx_night, w.icon());
+        Weather day = Weather.parse(BODY.replace("\"weather_code\":3", "\"weather_code\":1").replace("\"is_day\":0", "\"is_day\":1"));
+        assertEquals(R.drawable.ic_wx_partly, day.icon());
+    }
+
+    /** The widget's day range and the next hours, from the hourly and daily blocks of the same answer. */
+    @Test
+    public void forecastTakesTheHoursAfterNow() {
+        String body = "{\"current\":{\"time\":\"2026-11-10T15:30\",\"temperature_2m\":4.2,\"weather_code\":3,\"is_day\":1},"
+                + "\"hourly\":{\"time\":[\"2026-11-10T14:00\",\"2026-11-10T15:00\",\"2026-11-10T16:00\",\"2026-11-10T17:00\","
+                + "\"2026-11-10T18:00\"],\"temperature_2m\":[4.0,4.2,3.6,2.9,2.1],\"weather_code\":[3,3,1,0,61],"
+                + "\"is_day\":[1,1,1,0,0]},"
+                + "\"daily\":{\"temperature_2m_max\":[6.8],\"temperature_2m_min\":[-0.4]}}";
+        Weather.Forecast f = Weather.forecast(body, 2);
+        assertEquals(6.8, f.max, 1e-9);
+        assertEquals(-0.4, f.min, 1e-9);
+        assertEquals(2, f.hours.size());
+        assertEquals("16:00", f.hours.get(0).time);
+        assertEquals(3.6, f.hours.get(0).weather.temperature, 1e-9);
+        assertEquals("17:00", f.hours.get(1).time);
+        assertEquals(Weather.Kind.CLEAR, f.hours.get(1).weather.kind);
+        assertFalse(f.hours.get(1).weather.day);
+        assertEquals(3, Weather.forecast(body, 10).hours.size());
+    }
+
+    @Test
+    public void anAnswerWithoutTheDailyBlockHasNoForecast() {
+        assertEquals(null, Weather.forecast(BODY, 5));
+    }
+
+    @Test(expected = JSONException.class)
+    public void anErrorAnswerIsNoReading() throws JSONException {
+        Weather.parse("{\"error\":true,\"reason\":\"Latitude must be in range of -90 to 90°.\"}");
+    }
+
+    @Test
+    public void wmoCodes() {
+        assertEquals(Weather.Kind.CLEAR, Weather.kind(0));
+        assertEquals(Weather.Kind.PARTLY, Weather.kind(2));
+        assertEquals(Weather.Kind.CLOUDY, Weather.kind(3));
+        assertEquals(Weather.Kind.FOG, Weather.kind(48));
+        assertEquals(Weather.Kind.DRIZZLE, Weather.kind(55));
+        assertEquals(Weather.Kind.RAIN, Weather.kind(65));
+        assertEquals(Weather.Kind.RAIN, Weather.kind(81));
+        assertEquals(Weather.Kind.SNOW, Weather.kind(75));
+        assertEquals(Weather.Kind.SNOW, Weather.kind(86));
+        assertEquals(Weather.Kind.STORM, Weather.kind(99));
+        assertEquals(Weather.Kind.CLOUDY, Weather.kind(42));   // not a code Open-Meteo sends
+    }
+
+    @Test
+    public void temperatureSigns() {
+        assertEquals("+7°", Weather.temperature(6.6));
+        assertEquals("−3°", Weather.temperature(-2.6));
+        assertEquals("−2°", Weather.temperature(-2.5));   // Math.round goes up at .5
+        assertEquals("0°", Weather.temperature(-0.4));
+        assertEquals("0°", Weather.temperature(0.4));
+        assertEquals("+12°", Weather.temperature(12.49));
+    }
+
+    @Test
+    public void urlCarriesThePlace() {
+        String url = Weather.url(55.7558, 37.6173);
+        assertTrue(url.startsWith("https://api.open-meteo.com/v1/forecast?latitude=55.7558&longitude=37.6173"));
+        assertTrue(url.contains("current=temperature_2m,weather_code,is_day"));
+    }
+}
