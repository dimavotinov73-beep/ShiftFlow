+++ b/launcher/app/src/main/res/drawable/pill_bg.xml
@@ -14,6 +14,15 @@
             <corners android:radius="21dp" />
         </shape>
     </item>
+    <!-- Lit glass: the Wi-Fi pill while connected, the VPN pill while the VPN is up (state_selected). Brighter
+         frost and a white rim, so "on" reads at a glance without a colour; focus is still the solid white above. -->
+    <item android:state_selected="true">
+        <shape android:shape="rectangle">
+            <gradient android:angle="270" android:startColor="#7AFFFFFF" android:endColor="#4DFFFFFF" />
+            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
+            <corners android:radius="21dp" />
+        </shape>
+    </item>
     <item>
         <shape android:shape="rectangle">
             <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#14FFFFFF" />
