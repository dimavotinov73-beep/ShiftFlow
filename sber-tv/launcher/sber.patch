@@ -0,0 +1,324 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.graphics.Canvas;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.media.ExifInterface;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.BufferedInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.Inet4Address;
+import java.net.InetAddress;
+import java.net.NetworkInterface;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.text.SimpleDateFormat;
+import java.util.Collections;
+import java.util.Date;
+import java.util.Locale;
+
+/**
+ * A small web page on the TV for the phone next to it, reached by the QR code in Launcher settings: the owner picks
+ * photos there and they become wallpapers, or types a town and the weather follows it. It runs only while that
+ * screen is open, answers only under a random path that the QR code carries, and takes a picture or a place, nothing
+ * else. One connection at a time on one thread: a phone sends its photos one after another anyway.
+ */
+final class PhoneLink {
+
+    interface Listener {
+        /** A photo arrived and is saved in the wallpaper collection (main thread). */
+        void onPhoto(File saved);
+        /** A photo arrived but could not be read as a picture (main thread). */
+        void onPhotoRefused();
+        /** The phone picked a place for the weather (main thread). */
+        void onPlace(double lat, double lon, String name);
+    }
+
+    private static final String TAG = "PhoneLink";
+    /** A phone photo before the page shrinks it can be large; anything bigger is not a photo. */
+    private static final int MAX_BODY = 40 * 1024 * 1024;
+    private static final int FIRST_PORT = 8090, LAST_PORT = 8099;
+    /** The saved wallpaper: the screen's size, cropped to fill it, as WallpaperPlayer shows it. */
+    private static final int WIDTH = 1920, HEIGHT = 1080;
+
+    private final Context ctx;
+    private final File folder;
+    private final Listener listener;
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final String token;
+    private volatile ServerSocket server;
+    private int saved;
+
+    PhoneLink(Context ctx, File folder, Listener listener) {
+        this.ctx = ctx.getApplicationContext();
+        this.folder = folder;
+        this.listener = listener;
+        token = randomToken();
+    }
+
+    /** Starts listening and returns the address for the QR code, or null without a local network address. */
+    String start() {
+        String host = localAddress();
+        if (host == null || folder == null) return null;
+        for (int port = FIRST_PORT; port <= LAST_PORT; port++) {
+            try {
+                ServerSocket socket = new ServerSocket(port);
+                server = socket;
+                Thread thread = new Thread(() -> serve(socket), "phone-link");
+                thread.setDaemon(true);
+                thread.start();
+                return "http://" + host + ":" + port + "/" + token;
+            } catch (IOException taken) {
+                // the next port
+            }
+        }
+        return null;
+    }
+
+    void stop() {
+        ServerSocket socket = server;
+        server = null;
+        if (socket != null) {
+            try {
+                socket.close();
+            } catch (IOException ignored) {
+            }
+        }
+    }
+
+    private void serve(ServerSocket socket) {
+        while (server == socket) {
+            try (Socket client = socket.accept()) {
+                client.setSoTimeout(30_000);
+                handle(client);
+            } catch (IOException | RuntimeException e) {
+                if (server == socket) Log.w(TAG, "request failed: " + e.getMessage());
+            }
+        }
+    }
+
+    private void handle(Socket client) throws IOException {
+        InputStream in = new BufferedInputStream(client.getInputStream());
+        OutputStream out = client.getOutputStream();
+        String head = readHead(in);
+        if (head == null) return;
+        String[] lines = head.split("\r\n");
+        String[] request = lines[0].split(" ");
+        if (request.length < 2) {
+            reply(out, 400, "text/plain", "bad request");
+            return;
+        }
+        String method = request[0], path = request[1];
+        long length = 0;
+        for (String line : lines) {
+            int colon = line.indexOf(':');
+            if (colon > 0 && line.substring(0, colon).trim().equalsIgnoreCase("Content-Length")) {
+                try {
+                    length = Long.parseLong(line.substring(colon + 1).trim());
+                } catch (NumberFormatException e) {
+                    length = -1;
+                }
+            }
+        }
+        String base = "/" + token;
+        if ("GET".equals(method) && (path.equals(base) || path.equals(base + "/"))) {
+            reply(out, 200, "text/html; charset=utf-8", page());
+        } else if ("POST".equals(method) && path.equals(base + "/photo")) {
+            if (length <= 0 || length > MAX_BODY) {
+                reply(out, 413, "text/plain", "too large");
+                return;
+            }
+            File temp = new File(ctx.getCacheDir(), "phone-upload.tmp");
+            copy(in, temp, length);
+            File picture = savePicture(temp);
+            temp.delete();
+            if (picture == null) {
+                main.post(listener::onPhotoRefused);
+                reply(out, 415, "text/plain", "not a picture");
+            } else {
+                main.post(() -> listener.onPhoto(picture));
+                reply(out, 200, "text/plain", "ok");
+            }
+        } else if ("POST".equals(method) && path.equals(base + "/place")) {
+            if (length <= 0 || length > 4096) {
+                reply(out, 413, "text/plain", "too large");
+                return;
+            }
+            byte[] body = readBody(in, (int) length);
+            try {
+                JSONObject place = new JSONObject(new String(body, StandardCharsets.UTF_8));
+                double lat = place.getDouble("lat"), lon = place.getDouble("lon");
+                String name = place.optString("name", "").trim();
+                if (Math.abs(lat) > 90 || Math.abs(lon) > 180 || name.length() > 80) throw new JSONException("range");
+                main.post(() -> listener.onPlace(lat, lon, name));
+                reply(out, 200, "text/plain", "ok");
+            } catch (JSONException e) {
+                reply(out, 400, "text/plain", "bad place");
+            }
+        } else {
+            reply(out, 404, "text/plain", "not found");
+        }
+    }
+
+    /** The request line and headers, up to the blank line; null for a connection that sent nothing usable. */
+    private static String readHead(InputStream in) throws IOException {
+        ByteArrayOutputStream head = new ByteArrayOutputStream();
+        int matched = 0, b;
+        byte[] end = {'\r', '\n', '\r', '\n'};
+        while ((b = in.read()) >= 0) {
+            head.write(b);
+            matched = b == end[matched] ? matched + 1 : b == '\r' ? 1 : 0;
+            if (matched == 4) return head.toString("ISO-8859-1");
+            if (head.size() > 16 * 1024) return null;
+        }
+        return null;
+    }
+
+    private static byte[] readBody(InputStream in, int length) throws IOException {
+        byte[] body = new byte[length];
+        int n = 0, r;
+        while (n < length && (r = in.read(body, n, length - n)) > 0) n += r;
+        if (n < length) throw new IOException("body cut short");
+        return body;
+    }
+
+    private static void copy(InputStream in, File to, long length) throws IOException {
+        try (OutputStream out = new FileOutputStream(to)) {
+            byte[] buf = new byte[64 * 1024];
+            long left = length;
+            while (left > 0) {
+                int r = in.read(buf, 0, (int) Math.min(buf.length, left));
+                if (r < 0) throw new IOException("body cut short");
+                out.write(buf, 0, r);
+                left -= r;
+            }
+        }
+    }
+
+    private static void reply(OutputStream out, int status, String type, String body) throws IOException {
+        byte[] bytes = body.getBytes(StandardCharsets.UTF_8);
+        String head = "HTTP/1.1 " + status + (status == 200 ? " OK" : " Error") + "\r\n"
+                + "Content-Type: " + type + "\r\nContent-Length: " + bytes.length
+                + "\r\nCache-Control: no-store\r\nConnection: close\r\n\r\n";
+        out.write(head.getBytes(StandardCharsets.ISO_8859_1));
+        out.write(bytes);
+        out.flush();
+    }
+
+    /**
+     * The upload decoded at about screen size, turned upright by its EXIF tag, cropped to fill a 1920x1080 screen
+     * and saved as a JPEG in the collection under a name ThemeFiles accepts; null when it is not a picture.
+     */
+    private File savePicture(File upload) {
+        BitmapFactory.Options bounds = new BitmapFactory.Options();
+        bounds.inJustDecodeBounds = true;
+        BitmapFactory.decodeFile(upload.getPath(), bounds);
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null;
+        int rotation = 0;
+        try {
+            int o = new ExifInterface(upload.getPath()).getAttributeInt(ExifInterface.TAG_ORIENTATION,
+                    ExifInterface.ORIENTATION_NORMAL);
+            rotation = o == ExifInterface.ORIENTATION_ROTATE_90 ? 90 : o == ExifInterface.ORIENTATION_ROTATE_180 ? 180
+                    : o == ExifInterface.ORIENTATION_ROTATE_270 ? 270 : 0;
+        } catch (IOException ignored) {
+            // no EXIF: as it is
+        }
+        boolean turned = rotation == 90 || rotation == 270;
+        int w = turned ? bounds.outHeight : bounds.outWidth, h = turned ? bounds.outWidth : bounds.outHeight;
+        int sample = 1;
+        while (w / (sample * 2) >= WIDTH && h / (sample * 2) >= HEIGHT) sample *= 2;
+        BitmapFactory.Options options = new BitmapFactory.Options();
+        options.inSampleSize = sample;
+        Bitmap source;
+        try {
+            source = BitmapFactory.decodeFile(upload.getPath(), options);
+        } catch (OutOfMemoryError e) {
+            return null;
+        }
+        if (source == null) return null;
+        Bitmap screen = Bitmap.createBitmap(WIDTH, HEIGHT, Bitmap.Config.ARGB_8888);
+        Canvas canvas = new Canvas(screen);
+        Matrix m = new Matrix();
+        int sw = turned ? source.getHeight() : source.getWidth(), sh = turned ? source.getWidth() : source.getHeight();
+        float scale = Math.max((float) WIDTH / sw, (float) HEIGHT / sh);
+        m.postTranslate(-source.getWidth() / 2f, -source.getHeight() / 2f);
+        m.postRotate(rotation);
+        m.postScale(scale, scale);
+        m.postTranslate(WIDTH / 2f, HEIGHT / 2f);
+        canvas.drawBitmap(source, m, new Paint(Paint.FILTER_BITMAP_FLAG | Paint.ANTI_ALIAS_FLAG));
+        source.recycle();
+        if (!folder.isDirectory() && !folder.mkdirs()) {
+            screen.recycle();
+            return null;
+        }
+        String stamp = new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.ROOT).format(new Date());
+        File target = new File(folder, "phone-" + stamp + "-" + (++saved) + ".jpg");
+        try (OutputStream out = new FileOutputStream(target)) {
+            screen.compress(Bitmap.CompressFormat.JPEG, 88, out);
+        } catch (IOException e) {
+            target.delete();
+            return null;
+        } finally {
+            screen.recycle();
+        }
+        return target;
+    }
+
+    /**
+     * The TV's address on the home network: the first private IPv4 (192.168.x.x and the like) of an interface that is
+     * up, else any other IPv4 it has there. A VPN's tunnel never counts: the phone is not inside it.
+     */
+    static String localAddress() {
+        String other = null;
+        try {
+            for (NetworkInterface nif : Collections.list(NetworkInterface.getNetworkInterfaces())) {
+                if (!nif.isUp() || nif.isLoopback() || nif.isVirtual() || nif.isPointToPoint()
+                        || nif.getName().startsWith("tun")) continue;
+                for (InetAddress a : Collections.list(nif.getInetAddresses())) {
+                    if (!(a instanceof Inet4Address) || a.isLinkLocalAddress() || a.isLoopbackAddress()) continue;
+                    if (a.isSiteLocalAddress()) return a.getHostAddress();
+                    if (other == null) other = a.getHostAddress();
+                }
+            }
+        } catch (IOException | RuntimeException e) {
+            Log.w(TAG, "no network address: " + e.getMessage());
+        }
+        return other;
+    }
+
+    private static String randomToken() {
+        String letters = "abcdefghjkmnpqrstuvwxyz23456789";
+        SecureRandom random = new SecureRandom();
+        StringBuilder t = new StringBuilder();
+        for (int i = 0; i < 10; i++) t.append(letters.charAt(random.nextInt(letters.length())));
+        return t.toString();
+    }
+
+    private String page() {
+        try (InputStream in = ctx.getResources().openRawResource(R.raw.phone_link)) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[8192];
+            int n;
+            while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+            return out.toString("UTF-8");
+        } catch (IOException e) {
+            return "";
+        }
+    }
+}
