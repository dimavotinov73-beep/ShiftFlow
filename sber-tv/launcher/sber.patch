@@ -0,0 +1,46 @@
+package com.gathin.tvhome;
+
+/**
+ * Sber edition: frosted glass from the wallpaper for the Launchpad screen. The picture is first shrunk to a few dozen
+ * pixels (WallpaperPlayer does that with the decode), blurred here, and drawn stretched over the screen with
+ * filtering: a deep, soft blur for the cost of one tiny bitmap, on TVs whose Android has no blur effect.
+ */
+final class Frost {
+
+    private Frost() {
+    }
+
+    /** Box-blurs opaque ARGB pixels in place, across then down, {@code passes} times (three look Gaussian). */
+    static void blur(int[] pixels, int width, int height, int radius, int passes) {
+        if (radius <= 0 || width <= 0 || height <= 0 || pixels.length < width * height) return;
+        int[] scratch = new int[Math.max(width, height)];
+        for (int pass = 0; pass < passes; pass++) {
+            for (int y = 0; y < height; y++) line(pixels, y * width, 1, width, radius, scratch);
+            for (int x = 0; x < width; x++) line(pixels, x, width, height, radius, scratch);
+        }
+    }
+
+    /** One row or column: the mean of the 2 * radius + 1 pixels around each, the edge pixel repeated past the ends. */
+    private static void line(int[] px, int start, int step, int count, int radius, int[] out) {
+        int r = 0, g = 0, b = 0, window = 2 * radius + 1;
+        for (int i = -radius; i <= radius; i++) {
+            int p = px[start + clamp(i, count) * step];
+            r += (p >> 16) & 0xFF;
+            g += (p >> 8) & 0xFF;
+            b += p & 0xFF;
+        }
+        for (int i = 0; i < count; i++) {
+            out[i] = 0xFF000000 | (r / window) << 16 | (g / window) << 8 | (b / window);
+            int add = px[start + clamp(i + radius + 1, count) * step];
+            int drop = px[start + clamp(i - radius, count) * step];
+            r += ((add >> 16) & 0xFF) - ((drop >> 16) & 0xFF);
+            g += ((add >> 8) & 0xFF) - ((drop >> 8) & 0xFF);
+            b += (add & 0xFF) - (drop & 0xFF);
+        }
+        for (int i = 0; i < count; i++) px[start + i * step] = out[i];
+    }
+
+    private static int clamp(int i, int count) {
+        return i < 0 ? 0 : i >= count ? count - 1 : i;
+    }
+}
