+    // ---- painters -------------------------------------------------------------------------------------
+
+    private interface Tile {
+        void paint(Canvas c, int w, int h);
+    }
+
+    /** A STRIP layer: the same screen-wide picture twice side by side, so sliding one width along is seamless. */
+    private static void twice(Canvas c, int lw, int lh, Tile tile) {
+        int w = lw / 2;
+        tile.paint(c, w, lh);
+        c.save();
+        c.translate(w, 0);
+        tile.paint(c, w, lh);
+        c.restore();
+    }
+
+    private static void gradient(Canvas c, int w, int h, int[] colours, float[] stops) {
+        Paint p = new Paint();
+        p.setShader(new LinearGradient(0, 0, w * 0.15f, h, colours, stops, Shader.TileMode.CLAMP));
+        c.drawRect(0, 0, w, h, p);
+    }
+
+    /** Stars, more of them high up; sizes in pixels of a 1920-wide screen. */
+    private static void stars(Canvas c, int w, int h, int count, long seed, float maxY, float minR, float maxR, int minA, int maxA) {
+        Random r = new Random(seed);
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        float k = w / 1920f;
+        for (int i = 0; i < count; i++) {
+            float x = r.nextFloat() * w;
+            float y = (float) Math.pow(r.nextFloat(), 1.35) * maxY * h;
+            float radius = (minR + r.nextFloat() * (maxR - minR)) * 2f * k;
+            int a = minA + r.nextInt(Math.max(1, maxA - minA));
+            p.setColor(a << 24 | (r.nextFloat() < 0.15f ? 0xCFE2FF : r.nextFloat() < 0.1f ? 0xFFE8C8 : 0xFFFFFF));
+            c.drawCircle(x, y, Math.max(0.6f, radius), p);
+        }
+    }
+
+    /**
+     * An aurora's curtain: rays rising from a wavy lower edge, brightest at the edge and fading upwards, first soft
+     * (painted small and stretched), then a finer, fainter set over it for the rays' texture.
+     */
+    private static void curtain(Canvas c, int w, int h, int colour, float base, float amp, float waves, float phase,
+                                float height, float alpha, long seed) {
+        int sw = Math.max(2, w / 6), sh = Math.max(2, h / 6);
+        Bitmap soft = Bitmap.createBitmap(sw, sh, Bitmap.Config.ARGB_8888);
+        rays(new Canvas(soft), sw, sh, colour, base, amp, waves, phase, height, alpha, 1f, seed);
+        Paint filter = new Paint(Paint.FILTER_BITMAP_FLAG);
+        c.drawBitmap(soft, null, new Rect(0, 0, w, h), filter);
+        soft.recycle();
+        rays(c, w, h, colour, base, amp, waves, phase, height, alpha * 0.35f, Math.max(1.5f, w / 640f), seed + 1);
+    }
+
+    private static void rays(Canvas c, int w, int h, int colour, float base, float amp, float waves, float phase,
+                             float height, float alpha, float step, long seed) {
+        Random r = new Random(seed);
+        Paint p = new Paint();
+        p.setStrokeWidth(step * 1.3f);
+        int rgb = colour & 0xFFFFFF;
+        for (float x = 0; x < w; x += step) {
+            float t = x / w;
+            double a1 = 2 * Math.PI * (waves * t + phase), a2 = 2 * Math.PI * (3.3 * waves * t + 2 * phase);
+            float y0 = h * (base + amp * (float) Math.sin(a1) + 0.015f * (float) Math.sin(a2));
+            float len = h * height * (0.55f + 0.45f * (0.5f + 0.5f * (float) Math.sin(2 * Math.PI * (2.1 * t + phase * 1.7))))
+                    * (0.8f + 0.4f * r.nextFloat());
+            int a = Math.round(255 * alpha * (0.65f + 0.35f * r.nextFloat()));
+            p.setShader(new LinearGradient(x, y0, x, y0 - len, new int[]{a << 24 | rgb, (a / 3) << 24 | rgb, rgb},
+                    new float[]{0f, 0.3f, 1f}, Shader.TileMode.CLAMP));
+            c.drawLine(x, y0 + h * 0.012f, x, y0 - len, p);
+        }
+    }
+
+    /** Dark hills along the bottom with a few pines on them, in front of the sky. */
+    private static void hills(Canvas c, int w, int h, int colour, long seed) {
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        p.setColor(colour);
+        Path path = new Path();
+        path.moveTo(0, h);
+        path.lineTo(0, h * 0.86f);
+        path.cubicTo(w * 0.18f, h * 0.80f, w * 0.30f, h * 0.90f, w * 0.48f, h * 0.84f);
+        path.cubicTo(w * 0.64f, h * 0.78f, w * 0.80f, h * 0.88f, w, h * 0.82f);
+        path.lineTo(w, h);
+        path.close();
+        c.drawPath(path, p);
+        Random r = new Random(seed);
+        Path tree = new Path();
+        for (int i = 0; i < 46; i++) {
+            float x = r.nextFloat() * w;
+            float ground = h * (0.86f - 0.04f * (float) Math.sin(x / w * Math.PI * 2.1)) + h * 0.02f;
+            float th = h * (0.03f + r.nextFloat() * 0.06f), tw = th * 0.32f;
+            tree.reset();
+            tree.moveTo(x, ground - th);
+            tree.lineTo(x + tw, ground);
+            tree.lineTo(x - tw, ground);
+            tree.close();
+            c.drawPath(tree, p);
+        }
+    }
+
+    /** A matte sphere like the stock "iPhone" wallpapers': lit from the top left, a thin glowing rim behind it. */
+    private static Layer sphere(float cx, float cy, float r, int light, int dark, int rim) {
+        Bounds at = (sw, sh) -> {
+            float margin = 1.08f;
+            int size = Math.round(2 * r * sh * margin);
+            int x = Math.round(cx * sh - size / 2f), y = Math.round(cy * sh - size / 2f);
+            return new Rect(x, y, x + size, y + size);
+        };
+        return new Layer((c, lw, lh, sw, sh) -> {
+            float rad = lw / 2f / 1.08f, x = lw / 2f, y = lh / 2f;
+            Paint glow = new Paint(Paint.ANTI_ALIAS_FLAG);
+            glow.setStyle(Paint.Style.STROKE);
+            glow.setStrokeWidth(rad * 0.05f);
+            glow.setMaskFilter(new BlurMaskFilter(rad * 0.05f, BlurMaskFilter.Blur.NORMAL));
+            SweepGradient sweep = new SweepGradient(x, y, new int[]{0x00000000, rim & 0x99FFFFFF, 0x00000000, 0x00000000},
+                    new float[]{0f, 0.13f, 0.34f, 1f});
+            glow.setShader(sweep);
+            c.drawCircle(x, y, rad, glow);
+            Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+            fill.setShader(new RadialGradient(x - rad * 0.42f, y - rad * 0.5f, rad * 1.55f,
+                    new int[]{light, mix(light, dark, 0.55f), dark}, new float[]{0f, 0.42f, 1f}, Shader.TileMode.CLAMP));
+            c.drawCircle(x, y, rad, fill);
+            Paint edge = new Paint(Paint.ANTI_ALIAS_FLAG);
+            edge.setStyle(Paint.Style.STROKE);
+            edge.setStrokeWidth(Math.max(1f, rad * 0.008f));
+            edge.setShader(new SweepGradient(x, y, new int[]{0x00000000, rim, 0x00000000, 0x00000000},
+                    new float[]{0f, 0.12f, 0.3f, 1f}));
+            c.drawCircle(x, y, rad - edge.getStrokeWidth() / 2f, edge);
+        }, at, 0.5f);
+    }
+
+    /** Soft clouds of colour for deep space, drawn over a large square that turns slowly. */
+    private static void nebula(Canvas c, int w, int h) {
+        Random r = new Random(51);
+        int[] colours = {0x386A3DFF, 0x302B6BFF, 0x26FF4FA3, 0x2E2BC8FF, 0x246A3DFF, 0x20FF8A4F};
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        for (int i = 0; i < colours.length; i++) {
+            float x = w * (0.25f + 0.5f * r.nextFloat()), y = h * (0.25f + 0.5f * r.nextFloat());
+            float rad = Math.min(w, h) * (0.16f + 0.14f * r.nextFloat());
+            p.setShader(new RadialGradient(x, y, rad, new int[]{colours[i], colours[i] & 0x00FFFFFF}, null, Shader.TileMode.CLAMP));
+            c.drawCircle(x, y, rad, p);
+        }
+    }
+
+    /** The setting sun at the horizon: a warm glow and its disc. */
+    private static void sun(Canvas c, int w, int h) {
+        float x = w * 0.64f, y = h * 0.61f;
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        p.setShader(new RadialGradient(x, y, h * 0.42f, new int[]{0x99FFB070, 0x33FF7A50, 0x00FF7A50},
+                new float[]{0f, 0.4f, 1f}, Shader.TileMode.CLAMP));
+        c.drawCircle(x, y, h * 0.42f, p);
+        Paint disc = new Paint(Paint.ANTI_ALIAS_FLAG);
+        disc.setShader(new RadialGradient(x, y - h * 0.01f, h * 0.06f, new int[]{0xFFFFF0C8, 0xFFFFC27A},
+                null, Shader.TileMode.CLAMP));
+        c.drawCircle(x, y, h * 0.055f, disc);
+    }
+
+    /** The sun's road on the water: short bright dashes under it. */
+    private static void glitter(Canvas c, int w, int h) {
+        Random r = new Random(61);
+        Paint p = new Paint(Paint.ANTI_ALIAS_FLAG);
+        p.setStrokeCap(Paint.Cap.ROUND);
+        p.setStrokeWidth(Math.max(1f, h / 400f));
+        for (int i = 0; i < 70; i++) {
+            float t = r.nextFloat();
+            float y = h * (0.64f + 0.2f * t * t);
+            float spread = w * (0.02f + 0.1f * t);
+            float x = w * 0.64f + (r.nextFloat() - 0.5f) * 2 * spread;
+            float len = w * (0.008f + 0.02f * r.nextFloat()) * (0.5f + t);
+            p.setColor(Math.round(110 + 120 * (1 - t)) << 24 | 0xFFD3A0);
+            c.drawLine(x - len, y, x + len, y, p);
+        }
+    }
+
+    /** A band of sea: a gentle wave along its top (whole wavelengths across, so it tiles), lit along its crest. */
+    private static void wave(Canvas c, int w, int h, float top, float amp, int waves, int colour, int crest) {
+        Path path = new Path();
+        path.moveTo(0, h);
+        int steps = 120;
+        for (int i = 0; i <= steps; i++) {
+            float x = w * i / (float) steps;
+            path.lineTo(x, h * (top + amp * (float) Math.sin(2 * Math.PI * waves * i / steps)));
+        }
+        path.lineTo(w, h);
+        path.close();
+        Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        fill.setColor(colour);
+        c.drawPath(path, fill);
+        Paint line = new Paint(Paint.ANTI_ALIAS_FLAG);
+        line.setStyle(Paint.Style.STROKE);
+        line.setStrokeWidth(Math.max(1f, h / 360f));
+        line.setColor(crest);
+        Path ridge = new Path();
+        for (int i = 0; i <= steps; i++) {
+            float x = w * i / (float) steps;
+            float y = h * (top + amp * (float) Math.sin(2 * Math.PI * waves * i / steps));
+            if (i == 0) ridge.moveTo(x, y);
+            else ridge.lineTo(x, y);
+        }
+        c.drawPath(ridge, line);
+    }
+
+    private static int mix(int a, int b, float t) {
+        int r = Math.round(((a >> 16) & 0xFF) + (((b >> 16) & 0xFF) - ((a >> 16) & 0xFF)) * t);
+        int g = Math.round(((a >> 8) & 0xFF) + (((b >> 8) & 0xFF) - ((a >> 8) & 0xFF)) * t);
+        int bl = Math.round((a & 0xFF) + ((b & 0xFF) - (a & 0xFF)) * t);
+        return 0xFF000000 | r << 16 | g << 8 | bl;
