diff --git a/launcher/app/src/main/java/com/gathin/tvhome/TvChoices.java b/launcher/app/src/main/java/com/gathin/tvhome/TvChoices.java
new file mode 100644
index 0000000..11d0461
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/TvChoices.java
@@ -0,0 +1,86 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.Iterator;
+
+/**
+ * Theme keys changed on the TV itself, in Launcher settings: style, colours, language, weather place, wallpaper
+ * rotation. Kept as one JSON object in Launcher settings' preferences and laid over the theme's config.json wherever
+ * that is read (Config.load, HeaderExtras), so any theme key can be set here without a new field in Config. A theme
+ * pushed from the phone replaces them, like the other on-TV choices (Config.syncThemeChoices clears {@link #KEY}).
+ * JSONObject.NULL as a value removes the theme's key instead of setting it (the weather switched off, say).
+ */
+final class TvChoices {
+
+    static final String KEY = "tv_overrides";
+
+    private TvChoices() {
+    }
+
+    static JSONObject load(Context ctx) {
+        return parse(prefs(ctx).getString(KEY, null));
+    }
+
+    static JSONObject parse(String text) {
+        if (text == null || text.isEmpty()) return new JSONObject();
+        try {
+            return new JSONObject(text);
+        } catch (JSONException e) {
+            return new JSONObject();
+        }
+    }
+
+    /** Sets the keys (null as a value: back to the theme's own) and counts a settings change, so Home rebuilds. */
+    static void put(Context ctx, Object... keysAndValues) {
+        JSONObject choices = load(ctx);
+        try {
+            for (int i = 0; i + 1 < keysAndValues.length; i += 2) {
+                String key = (String) keysAndValues[i];
+                Object value = keysAndValues[i + 1];
+                if (value == null) choices.remove(key);
+                else choices.put(key, value);
+            }
+        } catch (JSONException e) {
+            return;   // a NaN or infinite number: nothing a settings row writes
+        }
+        SharedPreferences prefs = prefs(ctx);
+        prefs.edit().putString(KEY, choices.toString())
+                .putLong(Config.SETTINGS_REVISION_KEY, prefs.getLong(Config.SETTINGS_REVISION_KEY, 0) + 1).apply();
+    }
+
+    /** The value chosen on the TV for key, or null when the theme decides. */
+    static Object get(Context ctx, String key) {
+        return load(ctx).opt(key);
+    }
+
+    /** theme with the choices laid over it, as a new object; the theme alone when there are none. */
+    static JSONObject apply(JSONObject theme, JSONObject choices) {
+        if (choices == null || choices.length() == 0) return theme;
+        JSONObject merged;
+        try {
+            merged = theme == null ? new JSONObject() : new JSONObject(theme.toString());
+            for (Iterator<String> keys = choices.keys(); keys.hasNext(); ) {
+                String key = keys.next();
+                Object value = choices.get(key);
+                if (value == JSONObject.NULL) merged.remove(key);
+                else merged.put(key, value);
+            }
+        } catch (JSONException e) {
+            return theme;
+        }
+        return merged;
+    }
+
+    static JSONObject apply(Context ctx, JSONObject theme) {
+        return apply(theme, load(ctx));
+    }
+
+    private static SharedPreferences prefs(Context ctx) {
+        return ctx.getSharedPreferences(Config.SETTINGS_NAME, Context.MODE_PRIVATE);
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/VpnControl.java b/launcher/app/src/main/java/com/gathin/tvhome/VpnControl.java
