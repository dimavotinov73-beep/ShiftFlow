index 0000000..cadb28e
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/JarvisMic.java
@@ -0,0 +1,194 @@
+package com.gathin.tvhome;
+
+import android.annotation.SuppressLint;
+import android.content.Context;
+import android.media.AudioDeviceInfo;
+import android.media.AudioFormat;
+import android.media.AudioManager;
+import android.media.AudioRecord;
+import android.media.MediaRecorder;
+import android.util.Log;
+
+import java.io.ByteArrayOutputStream;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * One spoken phrase from the microphone: 16 kHz mono PCM, from just before the voice starts to a short pause after it
+ * (Vad decides), for SpeechKit. Blocks: run it off the main thread. The remote's own microphone is used when the
+ * firmware lets other apps record from it; a TV without one needs a USB or Bluetooth microphone.
+ */
+final class JarvisMic {
+
+    private static final String TAG = "Jarvis";
+    static final int FRAME_MS = 20;
+    private static final int FRAME = SpeechKit.STT_RATE * FRAME_MS / 1000;   // samples
+    /** Kept from before the voice crossed the threshold, so the first syllable is not cut. */
+    private static final int PREROLL_FRAMES = 15;
+
+    interface Levels {
+        /** 0..1, about fifty times a second, on the recording thread. */
+        void level(float level);
+    }
+
+    /** What was heard: the phrase (empty when nobody spoke) and how loud the room got at most (0..32767). */
+    static final class Heard {
+        final byte[] pcm;
+        final double peak;
+        final String error;
+
+        Heard(byte[] pcm, double peak, String error) {
+            this.pcm = pcm;
+            this.peak = peak;
+            this.error = error;
+        }
+
+        boolean speech() {
+            return pcm.length > 0;
+        }
+    }
+
+    private volatile boolean stopped, finishEarly;
+
+    /** Stops listening and keeps what was said so far (the assistant button pressed again). */
+    void finish() {
+        finishEarly = true;
+    }
+
+    /** Stops listening and drops it all (Back). */
+    void cancel() {
+        stopped = true;
+    }
+
+    @SuppressLint("MissingPermission")   // checked by the caller; without it AudioRecord fails to initialise
+    Heard listen(Levels levels) {
+        AudioRecord record = open(MediaRecorder.AudioSource.VOICE_RECOGNITION);
+        if (record == null) record = open(MediaRecorder.AudioSource.MIC);
+        if (record == null) return new Heard(new byte[0], 0, "no microphone");
+        Vad vad = new Vad();
+        ByteArrayOutputStream phrase = new ByteArrayOutputStream();
+        ArrayDeque<byte[]> preroll = new ArrayDeque<>();
+        short[] samples = new short[FRAME];
+        double peak = 0;
+        try {
+            record.startRecording();
+            while (!stopped) {
+                int n = 0;
+                while (n < FRAME) {
+                    int r = record.read(samples, n, FRAME - n);
+                    if (r <= 0) return new Heard(new byte[0], peak, "read " + r);
+                    n += r;
+                }
+                double rms = rms(samples);
+                peak = Math.max(peak, rms);
+                if (levels != null) levels.level((float) Math.min(1.0, rms / 6000.0));
+                byte[] frame = bytes(samples);
+                int state = vad.feed(rms);
+                if (state == Vad.WAITING) {
+                    preroll.addLast(frame);
+                    if (preroll.size() > PREROLL_FRAMES) preroll.removeFirst();
+                } else {
+                    while (!preroll.isEmpty()) phrase.write(preroll.removeFirst(), 0, frame.length);
+                    phrase.write(frame, 0, frame.length);
+                }
+                if (finishEarly) return new Heard(vad.heardVoice() ? phrase.toByteArray() : new byte[0], peak, null);
+                if (state == Vad.DONE) return new Heard(phrase.toByteArray(), peak, null);
+                if (state == Vad.TIMEOUT) return new Heard(new byte[0], peak, null);
+            }
+            return new Heard(new byte[0], peak, null);
+        } finally {
+            try {
+                record.stop();
+            } catch (IllegalStateException ignored) {
+                // never started
+            }
+            record.release();
+        }
+    }
+
+    @SuppressLint("MissingPermission")
+    private static AudioRecord open(int source) {
+        int min = AudioRecord.getMinBufferSize(SpeechKit.STT_RATE, AudioFormat.CHANNEL_IN_MONO, AudioFormat.ENCODING_PCM_16BIT);
+        if (min <= 0) return null;
+        try {
+            AudioRecord r = new AudioRecord(source, SpeechKit.STT_RATE, AudioFormat.CHANNEL_IN_MONO,
+                    AudioFormat.ENCODING_PCM_16BIT, Math.max(min, FRAME * 2 * 10));
+            if (r.getState() == AudioRecord.STATE_INITIALIZED) return r;
+            r.release();
+        } catch (IllegalArgumentException | SecurityException | UnsupportedOperationException e) {
+            Log.w(TAG, "microphone source " + source + ": " + e.getMessage());
+        }
+        return null;
+    }
+
+    /** The TV's microphones as Android lists them, for the "nobody heard" message and the log. */
+    static List<String> inputs(Context ctx) {
+        List<String> names = new ArrayList<>();
+        AudioManager am = ctx.getSystemService(AudioManager.class);
+        if (am == null) return names;
+        for (AudioDeviceInfo d : am.getDevices(AudioManager.GET_DEVICES_INPUTS)) {
+            names.add(d.getProductName() + " (" + d.getType() + ")");
+        }
+        return names;
+    }
+
+    static double rms(short[] s) {
+        double sum = 0;
+        for (short v : s) sum += (double) v * v;
+        return Math.sqrt(sum / s.length);
+    }
+
+    private static byte[] bytes(short[] s) {
+        byte[] b = new byte[s.length * 2];
+        for (int i = 0; i < s.length; i++) {
+            b[2 * i] = (byte) s[i];
+            b[2 * i + 1] = (byte) (s[i] >> 8);
+        }
+        return b;
+    }
+
+    /**
+     * Voice activity by loudness, one frame (FRAME_MS) at a time. The first frames measure the room; a phrase starts
+     * when several frames in a row are clearly louder, and ends after a pause. A quiet room never starts one.
+     */
+    static final class Vad {
+        static final int WAITING = 0, SPEAKING = 1, DONE = 2, TIMEOUT = 3;
+        private static final int CALIBRATE = 10;               // 200 ms of room noise
+        private static final int START_FRAMES = 3;             // 60 ms above the threshold starts a phrase
+        private static final int END_FRAMES = 45;              // 900 ms of quiet ends it
+        private static final int MAX_WAIT = 7_000 / FRAME_MS;  // nobody spoke for 7 s
+        private static final int MAX_PHRASE = 15_000 / FRAME_MS;
+        private static final double MIN_THRESHOLD = 350;
+
+        private int frames, loudRun, quietRun, phraseFrames;
+        private double noise;
+        private boolean speaking;
+
+        int feed(double rms) {
+            frames++;
+            if (frames <= CALIBRATE) {
+                noise += rms / CALIBRATE;
+                return WAITING;
+            }
+            double threshold = Math.max(MIN_THRESHOLD, noise * 2.5);
+            if (!speaking) {
+                loudRun = rms > threshold ? loudRun + 1 : 0;
+                if (loudRun >= START_FRAMES) {
+                    speaking = true;
+                    quietRun = 0;
+                    return SPEAKING;
+                }
+                return frames > MAX_WAIT ? TIMEOUT : WAITING;
+            }
+            phraseFrames++;
+            quietRun = rms < threshold * 0.7 ? quietRun + 1 : 0;
+            if (quietRun >= END_FRAMES || phraseFrames >= MAX_PHRASE) return DONE;
+            return SPEAKING;
+        }
+
+        boolean heardVoice() {
+            return speaking;
+        }
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/JarvisSpeech.java b/launcher/app/src/main/java/com/gathin/tvhome/JarvisSpeech.java
