+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import org.json.JSONObject;
+
+import java.io.File;
+
+/**
+ * Jarvis's settings. The keys come from jarvis.json next to the theme, which {@code sber-tv.sh jarvis} writes through
+ * ThemeProvider: {"anthropic_key": "sk-ant-...", "yandex_key": "AQVN..."}. A theme push leaves the file alone. The voice
+ * and its effect are chosen on the TV (Launcher settings) and kept in the app's own preferences.
+ */
+final class JarvisConfig {
+
+    static final String FILE_NAME = "jarvis.json";
+    static final String PREFS = "jarvis";
+
+    /** SpeechKit voices that suit a calm male assistant: voice, role ("" for none), label resource. */
+    static final String[][] VOICES = {
+            {"kirill", "strict"}, {"kirill", "neutral"}, {"alexander", "neutral"}, {"anton", "neutral"},
+            {"ermil", "neutral"}, {"filipp", ""}, {"zahar", "neutral"},
+    };
+    static final int[] VOICE_NAMES = {
+            R.string.jarvis_voice_kirill_strict, R.string.jarvis_voice_kirill, R.string.jarvis_voice_alexander,
+            R.string.jarvis_voice_anton, R.string.jarvis_voice_ermil, R.string.jarvis_voice_filipp,
+            R.string.jarvis_voice_zahar,
+    };
+
+    final String anthropicKey;
+    final String yandexKey;
+    final String voice;
+    final String role;
+    /** The light metallic room on the voice, as in the films; off plays SpeechKit's voice as it comes. */
+    final boolean effect;
+
+    JarvisConfig(String anthropicKey, String yandexKey, String voice, String role, boolean effect) {
+        this.anthropicKey = anthropicKey;
+        this.yandexKey = yandexKey;
+        this.voice = voice;
+        this.role = role;
+        this.effect = effect;
+    }
+
+    static JarvisConfig load(Context ctx) {
+        File dir = Config.dir(ctx);
+        return from(dir == null ? null : Config.read(new File(dir, FILE_NAME)), ctx.getSharedPreferences(PREFS, Context.MODE_PRIVATE));
+    }
+
+    static JarvisConfig from(JSONObject json, SharedPreferences prefs) {
+        String anthropic = json == null ? "" : json.optString("anthropic_key", "").trim();
+        String yandex = json == null ? "" : json.optString("yandex_key", "").trim();
+        return new JarvisConfig(anthropic, yandex, prefs.getString("voice", "kirill"), prefs.getString("role", "strict"),
+                prefs.getBoolean("effect", true));
+    }
+
+    boolean ready() {
+        return !anthropicKey.isEmpty() && !yandexKey.isEmpty();
+    }
+
+    /** The VOICES row of the chosen voice, or -1 for one set some other way. */
+    int voiceIndex() {
+        for (int i = 0; i < VOICES.length; i++) if (VOICES[i][0].equals(voice) && VOICES[i][1].equals(role)) return i;
+        return -1;
+    }
+}
