+package com.gathin.tvhome;
+
+import com.anthropic.client.AnthropicClient;
+import com.anthropic.client.okhttp.AnthropicOkHttpClient;
+import com.anthropic.core.JsonValue;
+import com.anthropic.errors.AnthropicException;
+import com.anthropic.errors.AnthropicInvalidDataException;
+import com.anthropic.errors.AnthropicIoException;
+import com.anthropic.errors.AnthropicServiceException;
+import com.anthropic.errors.PermissionDeniedException;
+import com.anthropic.errors.RateLimitException;
+import com.anthropic.errors.UnauthorizedException;
+import com.anthropic.models.messages.ContentBlock;
+import com.anthropic.models.messages.ContentBlockParam;
+import com.anthropic.models.messages.Message;
+import com.anthropic.models.messages.MessageCreateParams;
+import com.anthropic.models.messages.MessageParam;
+import com.anthropic.models.messages.OutputConfig;
+import com.anthropic.models.messages.StopReason;
+import com.anthropic.models.messages.Tool;
+import com.anthropic.models.messages.ToolResultBlockParam;
+import com.anthropic.models.messages.ToolUseBlock;
+import com.anthropic.models.messages.UserLocation;
+import com.anthropic.models.messages.WebSearchTool20260209;
+import com.fasterxml.jackson.core.type.TypeReference;
+
+import java.time.Duration;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Jarvis's mind: Claude with web search (run by Anthropic) and the TV's own tools (run here, by {@link Tools}), in one
+ * conversation that lasts while the owner keeps talking. The history is only ever appended to, as the API requires of
+ * a conversation with thinking; after a few minutes of silence, or a few questions, the next question starts a new one.
+ * Blocks on the network: call off the main thread.
+ */
+final class JarvisBrain {
+
+    static final String MODEL = "claude-opus-5-5";
+    /** A new conversation after this long without a question, or after this many questions in one. */
+    private static final long FORGET_AFTER_MS = 3 * 60_000L;
+    private static final int MAX_QUESTIONS = 6;
+    /** Rounds of tool calls (and resumed server-side searches) for one question. */
+    private static final int MAX_ROUNDS = 8;
+
+    /** The TV's side of the tools: runs one call and says what happened, in a sentence Claude can relay. */
+    interface Tools {
+        String run(String name, Map<String, Object> input) throws Exception;
+    }
+
+    /** Why a question got no answer, in words Jarvis can say. */
+    static final class Trouble extends Exception {
+        final Kind kind;
+
+        enum Kind { KEY, REGION, BUSY, NETWORK, OTHER }
+
+        Trouble(Kind kind, String message, Throwable cause) {
+            super(message, cause);
+            this.kind = kind;
+        }
+    }
+
+    private final AnthropicClient client;
+    private final List<MessageParam> history = new ArrayList<>();
+    private long lastAt;
+    private int questions;
+
+    JarvisBrain(String apiKey) {
+        this(AnthropicOkHttpClient.builder().apiKey(apiKey).timeout(Duration.ofSeconds(90)).maxRetries(1).build());
+    }
+
+    JarvisBrain(AnthropicClient client) {
+        this.client = client;
+    }
+
+    /** The reply to one spoken question; tools run as Claude asks for them. */
+    synchronized String ask(String question, String system, Tools tools) throws Trouble {
+        long now = System.currentTimeMillis();
+        if (now - lastAt > FORGET_AFTER_MS || questions >= MAX_QUESTIONS) forget();
+        lastAt = now;
+        questions++;
+        history.add(MessageParam.ofUser(question));
+        try {
+            for (int round = 0; round < MAX_ROUNDS; round++) {
+                Message reply = send(system);
+                StopReason stop = reply.stopReason().orElse(StopReason.END_TURN);
+                try {
+                    history.add(reply.toParam());
+                } catch (AnthropicInvalidDataException e) {
+                    // A block this SDK does not know (a newer API): the words can still be said, the turn not sent back.
+                    if (stop.equals(StopReason.TOOL_USE) || stop.equals(StopReason.PAUSE_TURN)) throw e;
+                    forget();
+                    return text(reply);
+                }
+                if (stop.equals(StopReason.REFUSAL)) return "";
+                if (stop.equals(StopReason.PAUSE_TURN)) continue;   // a long search: the API resumes from the history
+                if (!stop.equals(StopReason.TOOL_USE)) return text(reply);
+                List<ContentBlockParam> results = new ArrayList<>();
+                for (ContentBlock block : reply.content()) {
+                    if (!block.isToolUse()) continue;
+                    ToolUseBlock use = block.asToolUse();
+                    results.add(ContentBlockParam.ofToolResult(result(use, tools)));
+                }
+                history.add(MessageParam.ofUserOfContentBlockParams(results));
+            }
+            forget();   // ran out of rounds mid-task: the history ends on our turn, so the next question starts afresh
+            return "";
+        } catch (Trouble t) {
+            forget();   // the question went unanswered: start the next one afresh rather than after it
+            throw t;
+        } catch (AnthropicException e) {
+            // A reply the SDK could not read: never let it take the launcher down.
+            forget();
+            throw new Trouble(Trouble.Kind.OTHER, e.getMessage(), e);
+        }
+    }
+
+    private void forget() {
+        history.clear();
+        questions = 0;
+    }
+
+    private ToolResultBlockParam result(ToolUseBlock use, Tools tools) {
+        ToolResultBlockParam.Builder r = ToolResultBlockParam.builder().toolUseId(use.id());
+        try {
+            Map<String, Object> input = use._input().convert(new TypeReference<Map<String, Object>>() { });
+            return r.content(tools.run(use.name(), input == null ? Collections.emptyMap() : input)).build();
+        } catch (Exception e) {
+            return r.content("Не получилось: " + e.getMessage()).isError(true).build();
+        }
+    }
+
+    private Message send(String system) throws Trouble {
+        MessageCreateParams.Builder params = MessageCreateParams.builder()
+                .model(MODEL)
+                .maxTokens(16000L)
+                .system(system)
+                .messages(history)
+                // A spoken answer to an everyday question: low effort keeps the wait short.
+                .outputConfig(OutputConfig.builder().effort(OutputConfig.Effort.LOW).build())
+                // A declined request is retried on the model Anthropic recommends for it, server-side.
+                .putAdditionalHeader("anthropic-beta", "server-side-fallback-2026-07-01")
+                .putAdditionalBodyProperty("fallbacks", JsonValue.from("default"))
+                .addTool(WebSearchTool20260209.builder()
+                        .maxUses(3L)
+                        .userLocation(UserLocation.builder().country("RU").region("Московская область")
+                                .city("Москва").timezone("Europe/Moscow").build())
+                        .build());
+        for (Tool tool : TOOLS) params.addTool(tool);
+        try {
+            return client.messages().create(params.build());
+        } catch (UnauthorizedException e) {
+            throw new Trouble(Trouble.Kind.KEY, e.getMessage(), e);
+        } catch (PermissionDeniedException e) {
+            // Anthropic does not serve requests from Russia: the VPN is down, or routes this host around itself.
+            throw new Trouble(Trouble.Kind.REGION, e.getMessage(), e);
+        } catch (RateLimitException e) {
+            throw new Trouble(Trouble.Kind.BUSY, e.getMessage(), e);
+        } catch (AnthropicServiceException e) {
+            throw new Trouble(e.statusCode() >= 500 ? Trouble.Kind.BUSY : Trouble.Kind.OTHER, e.getMessage(), e);
+        } catch (AnthropicIoException e) {
+            throw new Trouble(Trouble.Kind.NETWORK, e.getMessage(), e);
+        }
+    }
+
+    /** The reply's words, in order; search results and thinking are not read out. */
+    static String text(Message reply) {
+        if (reply == null) return "";
+        StringBuilder out = new StringBuilder();
+        for (ContentBlock block : reply.content()) {
+            block.text().ifPresent(t -> out.append(t.text()));
+        }
+        return out.toString().trim();
+    }
+
+    // ---- the TV's tools ------------------------------------------------------------------------------
+
+    static final List<Tool> TOOLS = Arrays.asList(
+            tool("open_app", "Открывает приложение на телевизоре. Вызывай, когда просят открыть, запустить или "
+                            + "включить приложение или сервис (YouTube, Кинопоиск, браузер и т. п.). Название бери из "
+                            + "списка установленных приложений в системном сообщении.",
+                    props("name", prop("string", "Название приложения, как в списке установленных")), "name"),
+            tool("search_in_app", "Ищет фильм, сериал, видео или канал внутри приложения и открывает результаты. "
+                            + "Вызывай, когда просят найти или включить что-то конкретное в приложении "
+                            + "(например, «включи на YouTube обзор айфона»).",
+                    props("app", prop("string", "Название приложения из списка установленных"),
+                            "query", prop("string", "Что искать, коротко, как в строке поиска")), "app", "query"),
+            tool("set_volume", "Меняет громкость телевизора. Вызывай, когда просят сделать громче, тише, "
+                            + "выключить или вернуть звук, или поставить громкость на число.",
+                    props("action", enumProp("Что сделать", "up", "down", "set", "mute", "unmute"),
+                            "level", prop("integer", "Громкость в процентах 0–100, только для action=set")), "action"),
+            tool("vpn", "Включает или выключает VPN на телевизоре либо сообщает, включён ли он. Вызывай на просьбы "
+                            + "про VPN, защищённое соединение или обход блокировок.",
+                    props("action", enumProp("Что сделать", "on", "off", "status")), "action"),
+            tool("tv_action", "Действия с телевизором: home — главный экран, settings — настройки ТВ, "
+                            + "inputs — выбор источника (HDMI), wifi — настройки Wi-Fi, screensaver — заставка.",
+                    props("action", enumProp("Действие", "home", "settings", "inputs", "wifi", "screensaver")), "action"),
+            tool("get_weather", "Погода сейчас у пользователя дома. Для прогноза на часы или дни вперёд и для "
+                    + "других городов используй web_search.", props()));
+
+    private static Tool tool(String name, String description, Map<String, Object> properties, String... required) {
+        return Tool.builder()
+                .name(name)
+                .description(description)
+                .inputSchema(schema(properties, required))
+                .build();
+    }
+
+    private static Tool.InputSchema schema(Map<String, Object> properties, String... required) {
+        Tool.InputSchema.Properties.Builder p = Tool.InputSchema.Properties.builder();
+        for (Map.Entry<String, Object> e : properties.entrySet()) p.putAdditionalProperty(e.getKey(), JsonValue.from(e.getValue()));
+        Tool.InputSchema.Builder s = Tool.InputSchema.builder().properties(p.build());
+        if (required.length > 0) s.required(Arrays.asList(required));
+        return s.build();
+    }
+
+    private static Map<String, Object> props(Object... nameThenSchema) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        for (int i = 0; i + 1 < nameThenSchema.length; i += 2) m.put((String) nameThenSchema[i], nameThenSchema[i + 1]);
+        return m;
+    }
+
+    private static Map<String, Object> prop(String type, String description) {
+        Map<String, Object> m = new LinkedHashMap<>();
+        m.put("type", type);
+        m.put("description", description);
+        return m;
+    }
+
+    private static Map<String, Object> enumProp(String description, String... values) {
+        Map<String, Object> m = prop("string", description);
+        m.put("enum", Arrays.asList(values));
+        return m;
+    }
+}
