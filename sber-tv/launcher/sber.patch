+package com.gathin.tvhome;
+
+import android.Manifest;
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.graphics.drawable.GradientDrawable;
+import android.media.AudioAttributes;
+import android.media.AudioFocusRequest;
+import android.media.AudioManager;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.SystemClock;
+import android.text.TextUtils;
+import android.util.Log;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.KeyEvent;
+import android.view.View;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+
+import java.time.ZonedDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.List;
+import java.util.Locale;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Jarvis: the remote's assistant button (mapped by {@code sber-tv.sh jarvis}) opens this over whatever is playing.
+ * He chimes and listens; SpeechKit writes the phrase down; Claude answers, searching the web or using the TV's tools;
+ * SpeechKit speaks the answer in a calm male voice. The button again ends the listening early, or asks again; OK after
+ * an answer asks again; Back closes. When an answer opened an app, he steps aside once he has spoken.
+ */
+public final class JarvisActivity extends Activity {
+
+    private static final String TAG = "Jarvis";
+    /** Speak this instead of listening (the setup script's voice check). */
+    static final String EXTRA_SAY = "com.gathin.tvhome.extra.JARVIS_SAY";
+    private static final int IDLE = 0, LISTENING = 1, THINKING = 2, SPEAKING = 3, DONE = 4;
+    private static final long CLOSE_AFTER_MS = 9_000;
+
+    /** One conversation for the whole process: a follow-up question finds the last one. */
+    private static JarvisBrain brain;
+    private static String brainKey;
+
+    private final Handler main = new Handler(Looper.getMainLooper());
+    private final ExecutorService worker = Executors.newSingleThreadExecutor();
+    private final Runnable close = this::finish;
+    private JarvisConfig cfg;
+    private JarvisTools tools;
+    private JarvisMic mic;
+    private int state = IDLE;
+    /** Bumped by each new question: a reply or a sound from an earlier one, still arriving, is ignored. */
+    private int turn;
+    /** Back or Home: whatever is still on its way is dropped. */
+    private volatile boolean cancelled;
+    private AudioFocusRequest focus;
+
+    private ArcReactorView reactor;
+    private TextView status, heard, answer, hint;
+    private LinearLayout column;
+
+    @Override
+    protected void attachBaseContext(Context base) {
+        super.attachBaseContext(LauncherLocale.wrap(base));
+    }
+
+    @Override
+    protected void onCreate(Bundle saved) {
+        super.onCreate(saved);
+        cfg = JarvisConfig.load(this);
+        HeaderExtras extras = HeaderExtras.load(this);
+        Config config = Config.load(this);
+        String vpnApp = config.vpnApp.isEmpty() ? VpnControl.firstVpnApp(this) : config.vpnApp;
+        tools = new JarvisTools(this, vpnApp, extras.vpnTunnel);
+        buildViews();
+        handle(getIntent(), true);
+    }
+
+    @Override
+    protected void onNewIntent(Intent intent) {
+        super.onNewIntent(intent);
+        handle(intent, false);
+    }
+
+    /** First opening: listen. The button again: finish listening early, or listen anew. */
+    private void handle(Intent intent, boolean fresh) {
+        main.removeCallbacks(close);
+        String say = intent == null ? null : intent.getStringExtra(EXTRA_SAY);
+        if (say != null) {
+            turn++;
+            if (mic != null) mic.cancel();
+            mic = null;   // so the phrase it was waiting for is dropped (heardPhrase)
+            cancelled = false;
+            speak(say, true);
+            return;
+        }
+        if (fresh || state != LISTENING && state != THINKING) {
+            listen();
+        } else if (state == LISTENING && mic != null) {
+            mic.finish();
+        }
+    }
+
+    // ---- listening -------------------------------------------------------------------------------------
+
+    private void listen() {
+        turn++;
+        JarvisVoice.stop();
+        cancelled = false;
+        heard.setText("");
+        answer.setText("");
+        hint.setVisibility(View.INVISIBLE);
+        if (!cfg.ready()) {
+            trouble(getString(R.string.jarvis_no_keys));
+            return;
+        }
+        if (checkSelfPermission(Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {
+            trouble(getString(R.string.jarvis_no_permission));
+            return;
+        }
+        setState(LISTENING);
+        holdAudioFocus();
+        JarvisMic m = new JarvisMic();
+        mic = m;
+        JarvisVoice.chime(null);
+        worker.execute(() -> {
+            SystemClock.sleep(260);   // the chime first, so it is not heard as the start of a phrase
+            JarvisMic.Heard h = m.listen(reactor::setLevel);
+            main.post(() -> heardPhrase(m, h));
+        });
+    }
+
+    private void heardPhrase(JarvisMic m, JarvisMic.Heard h) {
+        if (cancelled || m != mic) return;
+        if (h.error != null) {
+            Log.w(TAG, "microphone: " + h.error + "; inputs " + JarvisMic.inputs(this));
+            trouble(getString(R.string.jarvis_no_mic) + "\n" + getString(R.string.jarvis_inputs, inputsText()));
+            return;
+        }
+        if (!h.speech()) {
+            if (h.peak < 30) {
+                // Not even room noise: nothing reaches this app from that microphone.
+                Log.w(TAG, "silent microphone, peak " + h.peak + "; inputs " + JarvisMic.inputs(this));
+                trouble(getString(R.string.jarvis_silent) + "\n" + getString(R.string.jarvis_inputs, inputsText()));
+            } else {
+                speak(getString(R.string.jarvis_not_heard), false);
+            }
+            return;
+        }
+        think(h.pcm);
+    }
+
+    private String inputsText() {
+        List<String> inputs = JarvisMic.inputs(this);
+        return inputs.isEmpty() ? "—" : TextUtils.join(", ", inputs);
+    }
+
+    // ---- thinking ------------------------------------------------------------------------------------
+
+    private void think(byte[] pcm) {
+        setState(THINKING);
+        worker.execute(() -> {
+            String question;
+            try {
+                question = SpeechKit.recognize(cfg.yandexKey, pcm);
+            } catch (Exception e) {
+                Log.w(TAG, "recognition: " + e.getMessage());
+                main.post(() -> trouble(getString(R.string.jarvis_err_stt, e.getMessage())));
+                return;
+            }
+            if (question.isEmpty()) {
+                main.post(() -> speak(getString(R.string.jarvis_not_heard), false));
+                return;
+            }
+            main.post(() -> heard.setText(getString(R.string.jarvis_heard, question)));
+            ensureVpn();
+            String reply;
+            try {
+                reply = brain(cfg.anthropicKey).ask(question, systemPrompt(), tools);
+            } catch (JarvisBrain.Trouble t) {
+                Log.w(TAG, "claude: " + t.kind + " " + t.getMessage());
+                main.post(() -> speak(getString(troubleText(t.kind)), false));
+                return;
+            }
+            String text = reply.isEmpty() ? getString(R.string.jarvis_refused) : reply;
+            main.post(() -> speak(text, false));
+        });
+    }
+
+    /**
+     * Anthropic does not serve requests from Russia, so the question goes through the VPN: if it is down and the VPN app
+     * can be switched from here, switch it on and give it a few seconds. Runs on the worker.
+     */
+    private void ensureVpn() {
+        if (JarvisTools.vpnUp(this)) return;
+        String vpnApp = Config.load(this).vpnApp;
+        if (vpnApp.isEmpty()) vpnApp = VpnControl.firstVpnApp(this);
+        if (vpnApp.isEmpty() || !VpnControl.send(this, vpnApp, true, HeaderExtras.load(this).vpnTunnel)) return;
+        main.post(() -> status.setText(R.string.jarvis_vpn));
+        for (int i = 0; i < 20 && !JarvisTools.vpnUp(this); i++) SystemClock.sleep(500);
+        main.post(() -> {
+            if (state == THINKING) status.setText(R.string.jarvis_thinking);
+        });
+    }
+
+    private static synchronized JarvisBrain brain(String key) {
+        if (brain == null || !key.equals(brainKey)) {
+            brain = new JarvisBrain(key);
+            brainKey = key;
+        }
+        return brain;
+    }
+
+    private static int troubleText(JarvisBrain.Trouble.Kind kind) {
+        switch (kind) {
+            case KEY: return R.string.jarvis_err_key;
+            case REGION: return R.string.jarvis_err_region;
+            case BUSY: return R.string.jarvis_err_busy;
+            case NETWORK: return R.string.jarvis_err_network;
+            default: return R.string.jarvis_err_other;
+        }
+    }
+
+    private String systemPrompt() {
+        HeaderExtras place = HeaderExtras.load(this);
+        String now = ZonedDateTime.now().format(DateTimeFormatter.ofPattern("EEEE, d MMMM yyyy, HH:mm", new Locale("ru")));
+        return "Ты — Джарвис, голосовой ИИ-ассистент в телевизоре своего владельца. Манера — как у Джарвиса из фильмов "
+                + "о Железном человеке: безупречно вежлив, невозмутим, с лёгкой британской иронией; обращаешься к "
+                + "пользователю «сэр». Отвечаешь по-русски.\n"
+                + "Твои ответы читает вслух синтезатор речи, поэтому: одно–три коротких предложения; без списков, "
+                + "разметки, эмодзи, ссылок и адресов сайтов; не называй источники; числа, даты и единицы пиши так, "
+                + "как их естественно произнести.\n"
+                + "Всё, что могло измениться — новости, курсы валют, погоду на другие дни и в других местах, "
+                + "расписания, результаты матчей, цены, — ищи в интернете (web_search), не отвечай по памяти. "
+                + "Просьбы что-то сделать с телевизором — открыть приложение, найти видео, громкость, VPN, источник "
+                + "сигнала — выполняй инструментами и коротко подтверждай сделанное.\n"
+                + "Сейчас " + now + " (Europe/Moscow). Дом владельца: "
+                + (place.weatherCity.isEmpty() ? "Московская область" : place.weatherCity + ", Московская область") + ".\n"
+                + "Установленные приложения: " + TextUtils.join(", ", tools.labels(80)) + ".";
+    }
+
+    // ---- speaking --------------------------------------------------------------------------------------
+
+    /** Shows the words and says them; closes afterwards when asked to, or when an answer opened an app. */
+    private void speak(String text, boolean closeAfter) {
+        if (cancelled) return;
+        int mine = turn;
+        String words = JarvisSpeech.clean(text);
+        answer.setText(words);
+        setState(THINKING);
+        status.setText("");
+        worker.execute(() -> {
+            byte[] pcm;
+            try {
+                pcm = SpeechKit.synthesize(cfg.yandexKey, words, cfg.voice, cfg.role, 1.0);
+            } catch (Exception e) {
+                Log.w(TAG, "synthesis: " + e.getMessage());
+                main.post(() -> {
+                    if (mine != turn) return;
+                    // Stays on screen even when asked to close after speaking: the words could not be heard.
+                    spoken(false);
+                    status.setText(getString(R.string.jarvis_err_tts, e.getMessage()));
+                    reactor.setState(ArcReactorView.ERROR);
+                });
+                return;
+            }
+            if (cancelled) return;
+            main.post(() -> {
+                if (mine != turn || cancelled) return;
+                if (!isDestroyed()) setState(SPEAKING);
+                JarvisVoice.play(pcm, cfg.effect, new JarvisVoice.Listener() {
+                    @Override
+                    public void level(float level) {
+                        reactor.setLevel(level);
+                    }
+
+                    @Override
+                    public void done() {
+                        // Also called when a new question cut this answer short: that one is not over.
+                        main.post(() -> {
+                            if (mine == turn) spoken(closeAfter);
+                        });
+                    }
+                });
+            });
+        });
+    }
+
+    private void spoken(boolean closeAfter) {
+        releaseAudioFocus();
+        if (isDestroyed() || isFinishing()) return;
+        if (closeAfter || tools.openedApp) {
+            finish();
+            return;
+        }
+        setState(DONE);
+        hint.setVisibility(View.VISIBLE);
+        main.postDelayed(close, CLOSE_AFTER_MS);
+    }
+
+    /** Something keeps Jarvis from working: shown in plain words with a red ring; closes by itself. */
+    private void trouble(String message) {
+        releaseAudioFocus();
+        setState(DONE);
+        reactor.setState(ArcReactorView.ERROR);
+        answer.setText(message);
+        main.postDelayed(close, CLOSE_AFTER_MS + 4_000);
+    }
+
+    // ---- keys and lifecycle --------------------------------------------------------------------------
+
+    @Override
+    public boolean onKeyDown(int keyCode, KeyEvent event) {
+        if ((keyCode == KeyEvent.KEYCODE_DPAD_CENTER || keyCode == KeyEvent.KEYCODE_ENTER) && state == DONE) {
+            main.removeCallbacks(close);
+            listen();
+            return true;
+        }
+        return super.onKeyDown(keyCode, event);
+    }
+
+    @Override
+    public void onBackPressed() {
+        cancel();
+        finish();
+    }
+
+    @Override
+    protected void onStop() {
+        super.onStop();
+        // Home pressed, or the TV went to standby: drop it all. An app Jarvis opened himself does not count.
+        if (!tools.openedApp && !isChangingConfigurations()) {
+            cancel();
+            finish();
+        }
+    }
+
+    private void cancel() {
+        cancelled = true;
+        if (mic != null) mic.cancel();
+        JarvisVoice.stop();
+        releaseAudioFocus();
+        main.removeCallbacks(close);
+    }
+
+    @Override
+    protected void onDestroy() {
+        main.removeCallbacks(close);
+        if (mic != null && state == LISTENING) mic.cancel();
+        worker.shutdown();
+        super.onDestroy();
+    }
+
+    private void setState(int s) {
+        state = s;
+        reactor.setState(s == LISTENING ? ArcReactorView.LISTENING : s == THINKING ? ArcReactorView.THINKING
+                : s == SPEAKING ? ArcReactorView.SPEAKING : ArcReactorView.IDLE);
+        if (s == LISTENING) status.setText(R.string.jarvis_listening);
+        else if (s == THINKING) status.setText(R.string.jarvis_thinking);
+        else status.setText("");
+    }
+
+    /** Ducks or pauses what is playing while Jarvis listens and speaks. */
+    private void holdAudioFocus() {
+        AudioManager am = getSystemService(AudioManager.class);
+        if (am == null || focus != null) return;
+        focus = new AudioFocusRequest.Builder(AudioManager.AUDIOFOCUS_GAIN_TRANSIENT)
+                .setAudioAttributes(new AudioAttributes.Builder().setUsage(AudioAttributes.USAGE_ASSISTANT)
+                        .setContentType(AudioAttributes.CONTENT_TYPE_SPEECH).build())
+                .build();
+        am.requestAudioFocus(focus);
+    }
+
+    private void releaseAudioFocus() {
+        AudioManager am = getSystemService(AudioManager.class);
+        if (am != null && focus != null) am.abandonAudioFocusRequest(focus);
+        focus = null;
+    }
+
+    // ---- the screen ------------------------------------------------------------------------------------
+
+    private void buildViews() {
+        float d = getResources().getDisplayMetrics().density;
+        FrameLayout root = new FrameLayout(this);
+        View shade = new View(this);
+        shade.setBackground(new GradientDrawable(GradientDrawable.Orientation.BOTTOM_TOP,
+                new int[]{0xF2000610, 0xA6000610, 0x00000000}));
+        root.addView(shade, new FrameLayout.LayoutParams(-1, -1));
+
+        column = new LinearLayout(this);
+        column.setOrientation(LinearLayout.VERTICAL);
+        column.setGravity(Gravity.CENTER_HORIZONTAL);
+        reactor = new ArcReactorView(this);
+        column.addView(reactor, new LinearLayout.LayoutParams(Math.round(230 * d), Math.round(230 * d)));
+        status = text(14, 0xFF4FD8FF, R.string.font_medium);
+        status.setLetterSpacing(0.25f);
+        status.setAllCaps(true);
+        column.addView(status, wrap(0));
+        heard = text(19, 0xB3FFFFFF, R.string.font_light);
+        column.addView(heard, wrap(Math.round(14 * d)));
+        answer = text(25, 0xFFFFFFFF, R.string.font_medium);
+        answer.setMaxLines(6);
+        answer.setEllipsize(TextUtils.TruncateAt.END);
+        answer.setLineSpacing(4 * d, 1f);
+        answer.setMaxWidth(Math.round(getResources().getDisplayMetrics().widthPixels * 0.66f));
+        column.addView(answer, wrap(Math.round(10 * d)));
+        hint = text(14, 0x80FFFFFF, R.string.font_light);
+        hint.setText(R.string.jarvis_hint);
+        hint.setVisibility(View.INVISIBLE);
+        column.addView(hint, wrap(Math.round(18 * d)));
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(-1, -2, Gravity.BOTTOM | Gravity.CENTER_HORIZONTAL);
+        lp.bottomMargin = Math.round(44 * d);
+        root.addView(column, lp);
+        setContentView(root);
+
+        column.setAlpha(0f);
+        column.setTranslationY(40 * d);
+        column.animate().alpha(1f).translationY(0f).setDuration(320)
+                .setInterpolator(new android.view.animation.DecelerateInterpolator(1.8f)).start();
+    }
+
+    private TextView text(int sp, int color, int font) {
+        TextView t = new TextView(this);
+        t.setTextSize(TypedValue.COMPLEX_UNIT_SP, sp);
+        t.setTextColor(color);
+        t.setGravity(Gravity.CENTER);
+        t.setTypeface(UiFont.get(this, font));
+        t.setShadowLayer(12, 0, 0, 0xCC000000);
+        return t;
+    }
+
+    private static LinearLayout.LayoutParams wrap(int top) {
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-2, -2);
+        lp.topMargin = top;
+        return lp;
+    }
+}
