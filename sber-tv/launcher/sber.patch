diff --git a/launcher/app/src/main/java/com/gathin/tvhome/AppMatch.java b/launcher/app/src/main/java/com/gathin/tvhome/AppMatch.java
new file mode 100644
index 0000000..4ec7dda
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/AppMatch.java
@@ -0,0 +1,66 @@
+package com.gathin.tvhome;
+
+import java.util.Collection;
+import java.util.Locale;
+
+/** Which installed app a spoken or typed name means: exact, then contained, then the closest spelling. */
+final class AppMatch {
+
+    private AppMatch() {
+    }
+
+    /** The label in labels that name means, or null when none is close enough. */
+    static String best(String name, Collection<String> labels) {
+        String want = normalize(name);
+        if (want.isEmpty()) return null;
+        for (String l : labels) if (normalize(l).equals(want)) return l;
+        String contained = null;
+        for (String l : labels) {
+            String have = normalize(l);
+            if (have.isEmpty()) continue;
+            // "кинопоиск" in "Кинопоиск: фильмы", or "youtube" for "YouTube for Android TV": the shortest such label.
+            if ((have.contains(want) || want.contains(have)) && (contained == null || l.length() < contained.length())) {
+                contained = l;
+            }
+        }
+        if (contained != null) return contained;
+        String closest = null;
+        double bestScore = 0;
+        for (String l : labels) {
+            String have = normalize(l);
+            int longer = Math.max(have.length(), want.length());
+            if (longer == 0) continue;
+            double score = 1.0 - (double) distance(have, want) / longer;
+            if (score > bestScore) {
+                bestScore = score;
+                closest = l;
+            }
+        }
+        return bestScore >= 0.7 ? closest : null;
+    }
+
+    /** Lower case, ё as е, letters and digits only. */
+    static String normalize(String s) {
+        StringBuilder out = new StringBuilder();
+        for (char c : s.toLowerCase(new Locale("ru")).replace('ё', 'е').toCharArray()) {
+            if (Character.isLetterOrDigit(c)) out.append(c);
+        }
+        return out.toString();
+    }
+
+    private static int distance(String a, String b) {
+        int[] prev = new int[b.length() + 1], cur = new int[b.length() + 1];
+        for (int j = 0; j <= b.length(); j++) prev[j] = j;
+        for (int i = 1; i <= a.length(); i++) {
+            cur[0] = i;
+            for (int j = 1; j <= b.length(); j++) {
+                int cost = a.charAt(i - 1) == b.charAt(j - 1) ? 0 : 1;
+                cur[j] = Math.min(Math.min(cur[j - 1] + 1, prev[j] + 1), prev[j - 1] + cost);
+            }
+            int[] t = prev;
+            prev = cur;
+            cur = t;
+        }
+        return prev[b.length()];
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/ArcReactorView.java b/launcher/app/src/main/java/com/gathin/tvhome/ArcReactorView.java
new file mode 100644
index 0000000..2fbd043
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/ArcReactorView.java
@@ -0,0 +1,142 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.graphics.RadialGradient;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.os.SystemClock;
+import android.view.View;
+
+/**
+ * Jarvis on screen: a HUD ring in the films' cyan. Rings of segments turn at their own speeds; the core swells with the
+ * voice, the owner's while listening and Jarvis's own while he speaks. Thinking spins it faster; trouble turns it red.
+ * Drawn from a few arcs and two gradients made once per size and colour: no bitmaps, no blur, cheap on a TV's GPU.
+ */
+final class ArcReactorView extends View {
+
+    static final int IDLE = 0, LISTENING = 1, THINKING = 2, SPEAKING = 3, ERROR = 4;
+    private static final int CYAN = 0x4FD8FF, RED = 0xFF6B5A;
+
+    private final Paint stroke = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF oval = new RectF();
+    private final Matrix coreScale = new Matrix();
+    /** The glow and the core at full size, for the current colour; null until laid out or after the colour changes. */
+    private RadialGradient glow, core;
+    private final float density;
+    private int state = IDLE;
+    /** 0..1, eased towards the latest level so the core breathes instead of flickering. */
+    private float level, target;
+    private float spin1, spin2, spin3;
+    private long lastFrame;
+    private int rgb = CYAN;
+
+    ArcReactorView(Context ctx) {
+        super(ctx);
+        density = ctx.getResources().getDisplayMetrics().density;
+        stroke.setStyle(Paint.Style.STROKE);
+        stroke.setStrokeCap(Paint.Cap.BUTT);
+    }
+
+    void setState(int state) {
+        this.state = state;
+        int now = state == ERROR ? RED : CYAN;
+        if (now != rgb) glow = core = null;
+        rgb = now;
+        if (state == THINKING || state == IDLE || state == ERROR) target = 0;
+        invalidate();
+    }
+
+    /** From any thread. */
+    void setLevel(float level) {
+        target = Math.max(0f, Math.min(1f, level));
+    }
+
+    @Override
+    protected void onAttachedToWindow() {
+        super.onAttachedToWindow();
+        lastFrame = SystemClock.uptimeMillis();
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        glow = core = null;
+    }
+
+    @Override
+    protected void onDraw(Canvas c) {
+        long now = SystemClock.uptimeMillis();
+        float dt = Math.min(0.05f, (now - lastFrame) / 1000f);
+        lastFrame = now;
+        float speed = state == THINKING ? 3.2f : state == IDLE || state == ERROR ? 0.4f : 1f;
+        spin1 = (spin1 + 40 * speed * dt) % 360;
+        spin2 = (spin2 - 25 * speed * dt + 360) % 360;
+        spin3 = (spin3 + 70 * speed * dt) % 360;
+        level += (target - level) * Math.min(1f, dt * 14);
+        if (state == THINKING) level = 0.18f + 0.12f * (float) Math.sin(now / 160.0);
+
+        float cx = getWidth() / 2f, cy = getHeight() / 2f;
+        float r = Math.min(cx, cy) * 0.62f;
+        if (glow == null) {
+            glow = new RadialGradient(cx, cy, r * 1.6f, new int[]{argb(0x55, rgb), argb(0x18, rgb), 0},
+                    new float[]{0f, 0.55f, 1f}, Shader.TileMode.CLAMP);
+            core = new RadialGradient(cx, cy, r, new int[]{0xFFFFFFFF, argb(0xFF, rgb), argb(0x00, rgb)},
+                    new float[]{0f, 0.45f, 1f}, Shader.TileMode.CLAMP);
+        }
+
+        // Glow behind it all.
+        fill.setShader(glow);
+        c.drawCircle(cx, cy, r * 1.6f, fill);
+
+        // Outer hairline and a ring of ticks.
+        stroke.setStrokeWidth(1.5f * density);
+        stroke.setColor(argb(0x99, rgb));
+        c.drawCircle(cx, cy, r * 1.18f, stroke);
+        stroke.setStrokeWidth(2f * density);
+        for (int i = 0; i < 60; i++) {
+            double a = Math.toRadians(i * 6 + spin2);
+            float in = i % 5 == 0 ? r * 1.04f : r * 1.08f;
+            c.drawLine(cx + (float) Math.cos(a) * in, cy + (float) Math.sin(a) * in,
+                    cx + (float) Math.cos(a) * r * 1.13f, cy + (float) Math.sin(a) * r * 1.13f, stroke);
+        }
+
+        // Three long arcs, turning one way.
+        stroke.setStrokeWidth(3f * density);
+        stroke.setColor(argb(0xDD, rgb));
+        arc(c, cx, cy, r * 0.96f, spin1, 95);
+        arc(c, cx, cy, r * 0.96f, spin1 + 140, 60);
+        arc(c, cx, cy, r * 0.96f, spin1 + 230, 80);
+
+        // A ring of segments, turning the other.
+        stroke.setStrokeWidth(7f * density);
+        stroke.setColor(argb(0xB0, rgb));
+        for (int i = 0; i < 10; i++) arc(c, cx, cy, r * 0.78f, spin2 + i * 36, 22);
+
+        // A fast inner arc pair.
+        stroke.setStrokeWidth(2f * density);
+        stroke.setColor(argb(0xEE, rgb));
+        arc(c, cx, cy, r * 0.6f, spin3, 120);
+        arc(c, cx, cy, r * 0.6f, spin3 + 180, 120);
+
+        // The core: white at the heart, the voice making it swell.
+        float scale = 0.34f + 0.22f * level;
+        coreScale.setScale(scale, scale, cx, cy);
+        core.setLocalMatrix(coreScale);
+        fill.setShader(core);
+        c.drawCircle(cx, cy, r * scale, fill);
+
+        if (isAttachedToWindow()) postInvalidateOnAnimation();
+    }
+
+    private void arc(Canvas c, float cx, float cy, float radius, float start, float sweep) {
+        oval.set(cx - radius, cy - radius, cx + radius, cy + radius);
+        c.drawArc(oval, start, sweep, false, stroke);
+    }
+
+    private static int argb(int alpha, int rgb) {
+        return alpha << 24 | rgb;
+    }
+}
