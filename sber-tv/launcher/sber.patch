+    /** White plate and dark ink while focused, as tvOS draws the focused row; a slight lift too. */
+    private void inks(LinearLayout row, TextView[] primary, TextView[] secondary) {
+        GradientDrawable plate = (GradientDrawable) row.getBackground();
+        row.setOnFocusChangeListener((v, focused) -> {
+            plate.setColor(focused ? 0xF5FFFFFF : 0x14FFFFFF);
+            for (TextView t : primary) t.setTextColor(focused ? 0xFF111114 : 0xFFFFFFFF);
+            for (TextView t : secondary) t.setTextColor(focused ? 0x99111114 : 0x99FFFFFF);
+            v.animate().scaleX(focused ? 1.03f : 1f).scaleY(focused ? 1.03f : 1f)
+                    .translationZ(focused ? dp(6) : 0).setDuration(150).start();
+        });
+        row.setOnKeyListener((v, key, event) -> event.getAction() == KeyEvent.ACTION_DOWN
+                && (key == KeyEvent.KEYCODE_DPAD_LEFT || key == KeyEvent.KEYCODE_DPAD_RIGHT));
+    }
