diff --git a/launcher/app/src/main/java/com/gathin/tvhome/SettingsTileDrawable.java b/launcher/app/src/main/java/com/gathin/tvhome/SettingsTileDrawable.java
new file mode 100644
index 0000000..4e93399
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/SettingsTileDrawable.java
@@ -0,0 +1,82 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.graphics.drawable.Drawable;
+import android.text.TextPaint;
+import android.text.TextUtils;
+
+import androidx.annotation.NonNull;
+
+/**
+ * The Launcher settings tile's artwork, drawn at the tile's size so it stays sharp at any column count: tvOS's grey
+ * Settings plate (a graphite gradient with a soft sheen at the top), a white gear and the tile's name under it.
+ */
+final class SettingsTileDrawable extends Drawable {
+
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint sheen = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final TextPaint text = new TextPaint(Paint.ANTI_ALIAS_FLAG);
+    private final Drawable gear;
+    private final String label;
+
+    SettingsTileDrawable(Context ctx, String label, Typeface font) {
+        this.label = label;
+        Drawable icon = ctx.getDrawable(R.drawable.ic_settings);
+        gear = icon == null ? null : icon.mutate();
+        if (gear != null) gear.setTint(0xFFFFFFFF);
+        text.setColor(0xF2FFFFFF);
+        text.setTextAlign(Paint.Align.CENTER);
+        if (font != null) text.setTypeface(font);
+    }
+
+    @Override
+    protected void onBoundsChange(@NonNull Rect b) {
+        fill.setShader(new LinearGradient(b.left, b.top, b.right, b.bottom, 0xFF5A5D66, 0xFF24262C, Shader.TileMode.CLAMP));
+        sheen.setShader(new LinearGradient(0, b.top, 0, b.top + b.height() * 0.5f, 0x2EFFFFFF, 0x00FFFFFF, Shader.TileMode.CLAMP));
+    }
+
+    @Override
+    public void draw(@NonNull Canvas c) {
+        Rect b = getBounds();
+        int w = b.width(), h = b.height();
+        if (w <= 0 || h <= 0) return;
+        c.drawRect(b, fill);
+        c.drawRect(b.left, b.top, b.right, b.top + h * 0.5f, sheen);
+        int size = Math.round(h * 0.34f);
+        int cx = b.centerX(), cy = b.top + Math.round(h * 0.40f);
+        if (gear != null) {
+            gear.setBounds(cx - size / 2, cy - size / 2, cx + size / 2, cy + size / 2);
+            gear.draw(c);
+        }
+        text.setTextSize(h * 0.125f);
+        CharSequence line = TextUtils.ellipsize(label, text, w * 0.9f, TextUtils.TruncateAt.END);
+        c.drawText(line, 0, line.length(), cx, b.top + h * 0.83f, text);
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+        fill.setAlpha(alpha);
+        text.setAlpha(alpha);
+        if (gear != null) gear.setAlpha(alpha);
+        invalidateSelf();
+    }
+
+    @Override
+    public void setColorFilter(ColorFilter filter) {
+        fill.setColorFilter(filter);
+        invalidateSelf();
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.OPAQUE;
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/SpeechKit.java b/launcher/app/src/main/java/com/gathin/tvhome/SpeechKit.java
new file mode 100644
index 0000000..626ad86
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/SpeechKit.java
@@ -0,0 +1,232 @@
+package com.gathin.tvhome;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Yandex SpeechKit over REST with a service account's API key ("Authorization: Api-Key ..."; the folder comes from the
+ * account, so none is sent). Recognition: API v1, a short phrase of raw 16 kHz PCM. Synthesis: API v3, which has the
+ * strict and calm male voices; API v1 with ermil if v3 refuses. Both return raw 16-bit PCM, so nothing needs decoding.
+ * Network I/O: call off the main thread.
+ */
+final class SpeechKit {
+
+    static final int STT_RATE = 16_000;
+    static final int TTS_RATE = 48_000;
+    private static final String STT_URL = "https://stt.api.cloud.yandex.net/speech/v1/stt:recognize";
+    private static final String TTS_V3_URL = "https://tts.api.cloud.yandex.net/tts/v3/utteranceSynthesis";
+    private static final String TTS_V1_URL = "https://tts.api.cloud.yandex.net/speech/v1/tts:synthesize";
+    /** The voices API v1 also has; any other falls back to ermil there. */
+    private static final List<String> V1_VOICES = Arrays.asList("ermil", "filipp", "zahar", "madi_ru", "jane", "omazh", "marina");
+
+    private SpeechKit() {
+    }
+
+    /** A failed call, with SpeechKit's own reason when it gave one. */
+    static final class Failure extends IOException {
+        final int status;
+
+        Failure(int status, String message) {
+            super(message);
+            this.status = status;
+        }
+    }
+
+    /** The text of one short phrase (up to 30 s, 1 MB), "" when SpeechKit heard no words. */
+    static String recognize(String key, byte[] pcm16k) throws IOException {
+        HttpURLConnection c = open(STT_URL + "?lang=ru-RU&format=lpcm&sampleRateHertz=" + STT_RATE, key, 20_000);
+        c.setRequestProperty("Content-Type", "application/octet-stream");
+        c.setFixedLengthStreamingMode(pcm16k.length);
+        try {
+            try (OutputStream out = c.getOutputStream()) {
+                out.write(pcm16k);
+            }
+            String body = new String(read(c), StandardCharsets.UTF_8);
+            try {
+                return new JSONObject(body).optString("result", "").trim();
+            } catch (JSONException e) {
+                throw new IOException("unreadable answer from recognition: " + body);
+            }
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    /** Speech for text as 16-bit mono PCM at TTS_RATE. */
+    static byte[] synthesize(String key, String text, String voice, String role, double speed) throws IOException {
+        try {
+            return synthesizeV3(key, text, voice, role, speed);
+        } catch (Failure e) {
+            if (e.status == 401 || e.status == 403) throw e;   // the key itself: v1 would refuse it too
+            return synthesizeV1(key, text, V1_VOICES.contains(voice) ? voice : "ermil", speed);
+        } catch (IOException e) {
+            return synthesizeV1(key, text, V1_VOICES.contains(voice) ? voice : "ermil", speed);
+        }
+    }
+
+    static String v3Request(String text, String voice, String role, double speed) {
+        try {
+            JSONArray hints = new JSONArray();
+            hints.put(new JSONObject().put("voice", voice));
+            if (role != null && !role.isEmpty()) hints.put(new JSONObject().put("role", role));
+            if (speed != 1.0) hints.put(new JSONObject().put("speed", speed));
+            return new JSONObject()
+                    .put("text", text)
+                    .put("hints", hints)
+                    .put("outputAudioSpec", new JSONObject().put("rawAudio", new JSONObject()
+                            .put("audioEncoding", "LINEAR16_PCM").put("sampleRateHertz", TTS_RATE)))
+                    .toString();
+        } catch (JSONException e) {
+            throw new IllegalArgumentException(e);
+        }
+    }
+
+    private static byte[] synthesizeV3(String key, String text, String voice, String role, double speed) throws IOException {
+        byte[] request = v3Request(text, voice, role, speed).getBytes(StandardCharsets.UTF_8);
+        HttpURLConnection c = open(TTS_V3_URL, key, 30_000);
+        c.setRequestProperty("Content-Type", "application/json");
+        c.setFixedLengthStreamingMode(request.length);
+        try {
+            try (OutputStream out = c.getOutputStream()) {
+                out.write(request);
+            }
+            byte[] audio = v3Audio(new String(read(c), StandardCharsets.UTF_8));
+            if (audio.length == 0) throw new IOException("no audio in the v3 answer");
+            return audio;
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    /**
+     * The audio of a v3 answer: a run of JSON objects, one per chunk, each {"result": {"audioChunk": {"data": base64}}}
+     * (or the chunk at the top level), one per line or simply one after another. Chunks without audio are skipped.
+     */
+    static byte[] v3Audio(String body) throws IOException {
+        ByteArrayOutputStream audio = new ByteArrayOutputStream();
+        for (String object : jsonObjects(body)) {
+            JSONObject chunk;
+            try {
+                chunk = new JSONObject(object);
+            } catch (JSONException e) {
+                continue;
+            }
+            JSONObject result = chunk.optJSONObject("result");
+            JSONObject holder = result != null ? result : chunk;
+            if (holder.has("error") || chunk.has("error")) {
+                throw new IOException("synthesis error: " + object);
+            }
+            JSONObject audioChunk = holder.optJSONObject("audioChunk");
+            String data = audioChunk == null ? "" : audioChunk.optString("data", "");
+            if (!data.isEmpty()) audio.write(Base64.getMimeDecoder().decode(data));
+        }
+        return audio.toByteArray();
+    }
+
+    /** The top-level JSON objects in text, found by their braces (outside strings). */
+    static List<String> jsonObjects(String text) {
+        List<String> objects = new ArrayList<>();
+        int depth = 0, start = -1;
+        boolean inString = false, escaped = false;
+        for (int i = 0; i < text.length(); i++) {
+            char ch = text.charAt(i);
+            if (inString) {
+                if (escaped) escaped = false;
+                else if (ch == '\\') escaped = true;
+                else if (ch == '"') inString = false;
+                continue;
+            }
+            if (ch == '"') {
+                inString = true;
+            } else if (ch == '{') {
+                if (depth++ == 0) start = i;
+            } else if (ch == '}' && depth > 0) {
+                if (--depth == 0) objects.add(text.substring(start, i + 1));
+            }
+        }
+        return objects;
+    }
+
+    private static byte[] synthesizeV1(String key, String text, String voice, double speed) throws IOException {
+        String form = "text=" + enc(text) + "&lang=ru-RU&voice=" + enc(voice) + "&format=lpcm&sampleRateHertz=" + TTS_RATE
+                + "&speed=" + String.format(Locale.ROOT, "%.2f", speed);
+        byte[] body = form.getBytes(StandardCharsets.UTF_8);
+        HttpURLConnection c = open(TTS_V1_URL, key, 30_000);
+        c.setRequestProperty("Content-Type", "application/x-www-form-urlencoded");
+        c.setFixedLengthStreamingMode(body.length);
+        try {
+            try (OutputStream out = c.getOutputStream()) {
+                out.write(body);
+            }
+            return read(c);
+        } finally {
+            c.disconnect();
+        }
+    }
+
+    private static HttpURLConnection open(String url, String key, int timeoutMs) throws IOException {
+        HttpURLConnection c = (HttpURLConnection) new URL(url).openConnection();
+        c.setRequestMethod("POST");
+        c.setDoOutput(true);
+        c.setConnectTimeout(10_000);
+        c.setReadTimeout(timeoutMs);
+        c.setRequestProperty("Authorization", "Api-Key " + key);
+        return c;
+    }
+
+    /** The body of a 200 answer; any other status becomes a Failure carrying SpeechKit's message. */
+    private static byte[] read(HttpURLConnection c) throws IOException {
+        int status = c.getResponseCode();
+        InputStream in = status == 200 ? c.getInputStream() : c.getErrorStream();
+        byte[] body = in == null ? new byte[0] : readAll(in);
+        if (status != 200) throw new Failure(status, errorMessage(status, new String(body, StandardCharsets.UTF_8)));
+        return body;
+    }
+
+    static String errorMessage(int status, String body) {
+        try {
+            JSONObject json = new JSONObject(body);
+            String message = json.optString("error_message", json.optString("message", ""));
+            if (!message.isEmpty()) return "HTTP " + status + ": " + message;
+        } catch (JSONException ignored) {
+            // not JSON: the status says enough
+        }
+        return "HTTP " + status;
+    }
+
+    private static byte[] readAll(InputStream in) throws IOException {
+        try (InputStream stream = in) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[16 * 1024];
+            int n;
+            while ((n = stream.read(buf)) > 0) {
+                out.write(buf, 0, n);
+                if (out.size() > 8 * 1024 * 1024) throw new IOException("answer larger than 8 MB");
+            }
+            return out.toByteArray();
+        }
+    }
+
+    private static String enc(String s) {
+        try {
+            return URLEncoder.encode(s, "UTF-8");
+        } catch (java.io.UnsupportedEncodingException e) {
+            throw new IllegalStateException(e);
+        }
+    }
+}
