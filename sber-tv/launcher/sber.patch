index 0000000..4498a81
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/VpnControl.java
@@ -0,0 +1,155 @@
+package com.gathin.tvhome;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ActivityInfo;
+import android.content.pm.LauncherApps;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.content.pm.ShortcutInfo;
+import android.os.Bundle;
+import android.os.Process;
+import android.util.Log;
+
+import java.util.List;
+import java.util.regex.Pattern;
+
+/**
+ * vpn_toggle: switches the VPN on or off through the VPN app's own control intent. Android gives no app a way to
+ * switch another app's VPN, so this only works for apps that accept such a command:
+ * <ul>
+ *   <li>Happ, v2rayNG and the other v2rayNG forks: their own "switch" shortcut (the one a phone shows on a long press
+ *       of the app icon), started through LauncherApps. Only the default Home may start another app's shortcut, and
+ *       this launcher is it. The shortcut flips the VPN itself, so the direction is not ours to choose.</li>
+ *   <li>WireGuard: SET_TUNNEL_UP / SET_TUNNEL_DOWN for a named tunnel (vpn_tunnel). Needs its CONTROL_TUNNELS
+ *       permission granted to this app (pm grant) and "Allow remote control apps" on in WireGuard's settings.</li>
+ *   <li>v2rayNG, and forks that kept its Tasker plugin receiver: a Locale FIRE_SETTING broadcast with an on/off switch
+ *       and "Default", the server selected in the app.</li>
+ *   <li>Last, the app's home-screen widget button ({@code <package>.action.widget.click}), which Happ and v2rayNG
+ *       also flip the VPN with.</li>
+ * </ul>
+ * Any other app gets nothing sent; the caller opens it instead.
+ */
+final class VpnControl {
+
+    private static final String TAG = "VpnControl";
+
+    static final String WIREGUARD = "com.wireguard.android";
+    static final String WIREGUARD_PERMISSION = WIREGUARD + ".permission.CONTROL_TUNNELS";
+    static final String FIRE_SETTING = "com.twofortyfouram.locale.intent.action.FIRE_SETTING";
+    private static final String EXTRA_BUNDLE = "com.twofortyfouram.locale.intent.extra.BUNDLE";
+    /** v2rayNG's id is "shortcuts_switch"; a fork may call it toggle. Matched on the whole id, any case. */
+    private static final Pattern SWITCH_SHORTCUT = Pattern.compile("(?i).*(switch|toggle).*");
+
+    private VpnControl() {
+    }
+
+    /**
+     * Asks {@code pkg} to bring its VPN up or down. True when a command went out; whether the app took it shows
+     * only in the VPN network coming or going, which the caller watches.
+     */
+    static boolean send(Context ctx, String pkg, boolean up, String tunnel) {
+        if (pkg == null || pkg.isEmpty()) return false;
+        try {
+            if (WIREGUARD.equals(pkg)) {
+                if (tunnel.isEmpty() || ctx.checkSelfPermission(WIREGUARD_PERMISSION) != PackageManager.PERMISSION_GRANTED) {
+                    return false;
+                }
+                ctx.sendBroadcast(new Intent(WIREGUARD + (up ? ".action.SET_TUNNEL_UP" : ".action.SET_TUNNEL_DOWN"))
+                        .setPackage(WIREGUARD)
+                        .putExtra("tunnel", tunnel));
+                return true;
+            }
+            ShortcutInfo shortcut = switchShortcut(ctx, pkg);
+            if (shortcut != null) {
+                ctx.getSystemService(LauncherApps.class).startShortcut(shortcut, null, null);
+                return true;
+            }
+            ComponentName receiver = taskerReceiver(ctx, pkg);
+            if (receiver != null) {
+                Bundle settings = new Bundle();
+                settings.putBoolean("tasker_extra_bundle_switch", up);
+                settings.putString("tasker_extra_bundle_guid", "Default");
+                ctx.sendBroadcast(new Intent(FIRE_SETTING).setComponent(receiver).putExtra(EXTRA_BUNDLE, settings));
+                return true;
+            }
+            ComponentName widget = widgetReceiver(ctx, pkg);
+            if (widget == null) return false;
+            ctx.sendBroadcast(new Intent(pkg + WIDGET_CLICK).setComponent(widget));
+            return true;
+        } catch (RuntimeException e) {
+            Log.w(TAG, "could not ask " + pkg + " to switch its VPN: " + e.getMessage());
+            return false;
+        }
+    }
+
+    /** True when {@link #send} has a way to reach {@code pkg}, so the pill can say "press to switch" or not. */
+    static boolean supported(Context ctx, String pkg, String tunnel) {
+        if (pkg == null || pkg.isEmpty()) return false;
+        if (WIREGUARD.equals(pkg)) {
+            return !tunnel.isEmpty() && ctx.checkSelfPermission(WIREGUARD_PERMISSION) == PackageManager.PERMISSION_GRANTED;
+        }
+        return switchShortcut(ctx, pkg) != null || taskerReceiver(ctx, pkg) != null || widgetReceiver(ctx, pkg) != null;
+    }
+
+    private static final String WIDGET_CLICK = ".action.widget.click";
+
+    /**
+     * The installed app with a VPN service that can be switched from here, else any app with one, else "". Several
+     * VPN apps on one TV are rare; with them, a theme's vpn_app picks.
+     */
+    static String firstVpnApp(Context ctx) {
+        String any = "";
+        try {
+            List<ResolveInfo> services = ctx.getPackageManager().queryIntentServices(
+                    new Intent(android.net.VpnService.SERVICE_INTERFACE), 0);
+            for (ResolveInfo r : services) {
+                if (r.serviceInfo == null) continue;
+                String pkg = r.serviceInfo.packageName;
+                if (pkg.equals(ctx.getPackageName())) continue;
+                if (supported(ctx, pkg, "")) return pkg;
+                if (any.isEmpty()) any = pkg;
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "could not list VPN apps: " + e.getMessage());
+        }
+        return any;
+    }
+
+    /** The app's switch shortcut, or null: none, or this launcher is not the default Home (no shortcut access). */
+    static ShortcutInfo switchShortcut(Context ctx, String pkg) {
+        try {
+            LauncherApps apps = ctx.getSystemService(LauncherApps.class);
+            if (apps == null || !apps.hasShortcutHostPermission()) return null;
+            LauncherApps.ShortcutQuery query = new LauncherApps.ShortcutQuery().setPackage(pkg).setQueryFlags(
+                    LauncherApps.ShortcutQuery.FLAG_MATCH_MANIFEST | LauncherApps.ShortcutQuery.FLAG_MATCH_DYNAMIC
+                            | LauncherApps.ShortcutQuery.FLAG_MATCH_PINNED);
+            List<ShortcutInfo> shortcuts = apps.getShortcuts(query, Process.myUserHandle());
+            if (shortcuts == null) return null;
+            for (ShortcutInfo s : shortcuts) {
+                if (s.isEnabled() && SWITCH_SHORTCUT.matcher(s.getId()).matches()) return s;
+            }
+        } catch (RuntimeException e) {   // SecurityException, IllegalStateException while the user is locked
+            Log.w(TAG, "no shortcuts from " + pkg + ": " + e.getMessage());
+        }
+        return null;
+    }
+
+    private static ComponentName widgetReceiver(Context ctx, String pkg) {
+        return exportedReceiver(ctx, new Intent(pkg + WIDGET_CLICK).setPackage(pkg));
+    }
+
+    private static ComponentName taskerReceiver(Context ctx, String pkg) {
+        return exportedReceiver(ctx, new Intent(FIRE_SETTING).setPackage(pkg));
+    }
+
+    private static ComponentName exportedReceiver(Context ctx, Intent intent) {
+        List<ResolveInfo> found = ctx.getPackageManager().queryBroadcastReceivers(intent, 0);
+        for (ResolveInfo r : found) {
+            ActivityInfo info = r.activityInfo;
+            if (info != null && info.exported) return new ComponentName(info.packageName, info.name);
+        }
+        return null;
+    }
+}
