+    /** A list page in the pane: its rows on rounded cards (groupRows), under the page's title. */
+    private void listPage(int title, int symbol) {
+        gridPage = false;
+        stage.removeAllViews();
+        pageTitle.setText(title);
+        ScrollView scroll = new RoomyScroll(this, dp(24));
+        scroll.setVerticalScrollBarEnabled(false);
+        scroll.setClipToPadding(false);
+        scroll.setPadding(0, dp(2), 0, dp(40));
+        rows = new LinearLayout(this);
+        rows.setOrientation(LinearLayout.VERTICAL);
+        rows.setPadding(dp(8), 0, dp(8), 0);
+        rows.setClipChildren(false);
+        scroll.addView(rows, new ScrollView.LayoutParams(-1, -2));
+        stage.addView(scroll, new FrameLayout.LayoutParams(-1, -1));
+    }
