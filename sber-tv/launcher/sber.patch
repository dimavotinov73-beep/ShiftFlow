+            view.setScaleType(ImageView.ScaleType.FIT_XY);
+            view.setImageBitmap(bitmap);
+            view.forceHasOverlappingRendering(false);
+            FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(at.width(), at.height());
+            lp.leftMargin = at.left;
+            lp.topMargin = at.top;
+            root.addView(view, lp);
+            for (Motion mo : layer.motions) motion.add(mo.animator(view, w, h));
+        }
+    }
+
+    View view() {
+        return root;
+    }
+
+    /** Home in front: the scene moves (or goes on moving from where it stopped). */
+    void start() {
+        if (!animate) return;
+        for (Animator a : motion) {
+            if (!started) a.start();
+            else a.resume();
+        }
+        started = true;
+    }
+
+    /** Home behind an app: the scene holds still and costs nothing. */
+    void stop() {
+        for (Animator a : motion) a.pause();
+    }
+
+    void release() {
+        for (Animator a : motion) a.cancel();
+        motion.clear();
+        root.removeAllViews();
+    }
+
+    /** The scene still, at any size: Launcher settings' tile, and the Launchpad's frost. */
+    static Bitmap preview(String scene, int w, int h) {
+        Bitmap bitmap = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+        Canvas c = new Canvas(bitmap);
+        for (Layer layer : layers(scene)) {
+            Rect at = layer.bounds(w, h);
+            c.save();
+            c.translate(at.left, at.top);
+            layer.painter.paint(c, at.width(), at.height(), w, h);
+            c.restore();
+        }
+        return bitmap;
+    }
