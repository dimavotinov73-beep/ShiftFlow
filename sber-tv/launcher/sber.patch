diff --git a/launcher/app/src/test/java/com/gathin/tvhome/HeaderExtrasTest.java b/launcher/app/src/test/java/com/gathin/tvhome/HeaderExtrasTest.java
new file mode 100644
index 0000000..b5a59e7
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/HeaderExtrasTest.java
@@ -0,0 +1,77 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertSame;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONException;
+import org.json.JSONObject;
+import org.junit.Test;
+
+public class HeaderExtrasTest {
+
+    @Test
+    public void noThemeHasCompactPillsAndTheVpnSwitchButNoWeather() {
+        HeaderExtras e = HeaderExtras.from(null);
+        assertTrue(e.compactPills);
+        assertTrue(e.vpnToggle);
+        assertFalse(e.weather());
+        assertEquals("", e.vpnTunnel);
+        assertEquals("", e.weatherCity);
+    }
+
+    @Test
+    public void readsEveryKey() throws JSONException {
+        HeaderExtras e = HeaderExtras.from(new JSONObject("{\"compact_pills\":true,\"vpn_toggle\":true,"
+                + "\"vpn_tunnel\":\" home \",\"weather_lat\":55.7558,\"weather_lon\":37.6173,\"weather_city\":\"Москва\"}"));
+        assertTrue(e.compactPills);
+        assertTrue(e.vpnToggle);
+        assertEquals("home", e.vpnTunnel);
+        assertTrue(e.weather());
+        assertEquals(55.7558, e.weatherLat, 1e-9);
+        assertEquals(37.6173, e.weatherLon, 1e-9);
+        assertEquals("Москва", e.weatherCity);
+    }
+
+    @Test
+    public void wrongTypesAreIgnored() throws JSONException {
+        HeaderExtras e = HeaderExtras.from(new JSONObject("{\"compact_pills\":\"no\",\"vpn_toggle\":0,"
+                + "\"weather_lat\":\"55.7\",\"weather_lon\":37.6}"));
+        assertTrue(e.compactPills);
+        assertTrue(e.vpnToggle);
+        assertFalse(e.weather());
+    }
+
+    @Test
+    public void aThemeCanTurnThePillsAndTheSwitchOff() throws JSONException {
+        HeaderExtras e = HeaderExtras.from(new JSONObject("{\"compact_pills\":false,\"vpn_toggle\":false}"));
+        assertFalse(e.compactPills);
+        assertFalse(e.vpnToggle);
+    }
+
+    @Test
+    public void choicesMadeOnTheTvLieOverTheTheme() throws JSONException {
+        JSONObject theme = new JSONObject("{\"weather_lat\":54.3,\"weather_lon\":36.0,\"weather_city\":\"Глухово\",\"columns\":5}");
+        JSONObject tv = new JSONObject("{\"weather_lat\":55.77213,\"weather_lon\":37.25268,\"columns\":7}");
+        HeaderExtras e = HeaderExtras.from(TvChoices.apply(theme, tv));
+        assertEquals(55.77213, e.weatherLat, 1e-9);
+        assertEquals(37.25268, e.weatherLon, 1e-9);
+        assertEquals("Глухово", e.weatherCity);
+        assertEquals(5, theme.getInt("columns"));   // the theme itself is left as it was
+
+        tv.put("weather_lat", JSONObject.NULL);
+        assertFalse(HeaderExtras.from(TvChoices.apply(theme, tv)).weather());
+        assertTrue(HeaderExtras.from(TvChoices.apply((JSONObject) null, new JSONObject("{\"weather_lat\":1,\"weather_lon\":2}"))).weather());
+        assertSame(theme, TvChoices.apply(theme, new JSONObject()));
+    }
+
+    @Test
+    public void bothCoordinatesInRangeOrNoWeather() throws JSONException {
+        assertFalse(HeaderExtras.from(new JSONObject("{\"weather_lat\":95,\"weather_lon\":37.6}")).weather());
+        assertFalse(HeaderExtras.from(new JSONObject("{\"weather_lat\":55.7,\"weather_lon\":-181}")).weather());
+        assertFalse(HeaderExtras.from(new JSONObject("{\"weather_lat\":55.7}")).weather());
+        assertTrue(HeaderExtras.from(new JSONObject("{\"weather_lat\":-33.9,\"weather_lon\":-180}")).weather());
+        assertTrue(HeaderExtras.from(new JSONObject("{\"weather_lat\":0,\"weather_lon\":0}")).weather());
+    }
+}
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/JarvisBrainTest.java b/launcher/app/src/test/java/com/gathin/tvhome/JarvisBrainTest.java
new file mode 100644
index 0000000..1304361
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/JarvisBrainTest.java
@@ -0,0 +1,244 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import com.anthropic.client.okhttp.AnthropicOkHttpClient;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.InetAddress;
+import java.net.ServerSocket;
+import java.net.Socket;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Deque;
+import java.util.List;
+import java.util.Locale;
+
+/** JarvisBrain's loop against a local stand-in for the Messages API: the requests it sends and the replies it reads. */
+public class JarvisBrainTest {
+
+    private ServerSocket server;
+    private final Deque<Object[]> replies = new ArrayDeque<>();   // {status, body}
+    private final List<JSONObject> requests = Collections.synchronizedList(new ArrayList<>());
+    private final List<String> betaHeaders = Collections.synchronizedList(new ArrayList<>());
+    private JarvisBrain brain;
+
+    @Before
+    public void start() throws Exception {
+        server = new ServerSocket(0, 50, InetAddress.getLoopbackAddress());
+        Thread t = new Thread(() -> {
+            while (!server.isClosed()) {
+                try (Socket s = server.accept()) {
+                    answer(s);
+                } catch (IOException ignored) {
+                    // closed by stop(), or a client that went away
+                }
+            }
+        }, "fake-messages-api");
+        t.setDaemon(true);
+        t.start();
+        brain = new JarvisBrain(AnthropicOkHttpClient.builder()
+                .baseUrl("http://127.0.0.1:" + server.getLocalPort())
+                .apiKey("sk-ant-test").maxRetries(0).build());
+    }
+
+    @After
+    public void stop() throws IOException {
+        server.close();
+    }
+
+    /** One HTTP/1.1 exchange: records the JSON body and the beta header, answers with the next queued reply. */
+    private void answer(Socket s) throws IOException {
+        InputStream in = s.getInputStream();
+        String beta = null;
+        int length = 0;
+        for (String line = line(in); !line.isEmpty(); line = line(in)) {
+            int colon = line.indexOf(':');
+            if (colon < 0) continue;
+            String name = line.substring(0, colon).trim().toLowerCase(Locale.ROOT), value = line.substring(colon + 1).trim();
+            if (name.equals("content-length")) length = Integer.parseInt(value);
+            if (name.equals("anthropic-beta")) beta = value;
+        }
+        byte[] body = in.readNBytes(length);
+        try {
+            requests.add(new JSONObject(new String(body, StandardCharsets.UTF_8)));
+        } catch (Exception e) {
+            throw new IOException(e);
+        }
+        betaHeaders.add(beta);
+        Object[] reply;
+        synchronized (replies) {
+            reply = replies.isEmpty() ? new Object[]{500, "{}"} : replies.removeFirst();
+        }
+        byte[] out = ((String) reply[1]).getBytes(StandardCharsets.UTF_8);
+        OutputStream o = s.getOutputStream();
+        o.write(("HTTP/1.1 " + reply[0] + " X\r\nContent-Type: application/json\r\nContent-Length: " + out.length
+                + "\r\nConnection: close\r\n\r\n").getBytes(StandardCharsets.US_ASCII));
+        o.write(out);
+        o.flush();
+    }
+
+    private static String line(InputStream in) throws IOException {
+        ByteArrayOutputStream b = new ByteArrayOutputStream();
+        for (int c = in.read(); c >= 0 && c != '\n'; c = in.read()) if (c != '\r') b.write(c);
+        return b.toString(StandardCharsets.US_ASCII);
+    }
+
+    private static String message(String stopReason, String contentJson) {
+        return "{\"id\":\"msg_1\",\"type\":\"message\",\"role\":\"assistant\",\"model\":\"claude-opus-5-5\","
+                + "\"content\":" + contentJson + ",\"stop_reason\":\"" + stopReason + "\",\"stop_sequence\":null,"
+                + "\"usage\":{\"input_tokens\":12,\"output_tokens\":7}}";
+    }
+
+    @Test
+    public void runsATvToolAndSpeaksTheAnswer() throws Exception {
+        replies.add(new Object[]{200, message("tool_use",
+                "[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"sig\"},"
+                        + "{\"type\":\"text\",\"text\":\"Сейчас открою.\"},"
+                        + "{\"type\":\"tool_use\",\"id\":\"toolu_1\",\"name\":\"open_app\",\"input\":{\"name\":\"YouTube\"}}]")});
+        replies.add(new Object[]{200, message("end_turn", "[{\"type\":\"text\",\"text\":\"Открываю YouTube, сэр.\"}]")});
+        List<String> calls = new ArrayList<>();
+        String answer = brain.ask("Открой ютуб", "system prompt", (name, input) -> {
+            calls.add(name + ":" + input.get("name"));
+            return "Открыто приложение YouTube.";
+        });
+        assertEquals("Открываю YouTube, сэр.", answer);
+        assertEquals(List.of("open_app:YouTube"), calls);
+
+        JSONObject first = requests.get(0);
+        assertEquals("claude-opus-5-5", first.getString("model"));
+        assertEquals("system prompt", first.getString("system"));
+        assertEquals("low", first.getJSONObject("output_config").getString("effort"));
+        assertEquals("default", first.getString("fallbacks"));
+        assertEquals("server-side-fallback-2026-07-01", betaHeaders.get(0));
+        JSONArray tools = first.getJSONArray("tools");
+        assertEquals("web_search_20260209", tools.getJSONObject(0).getString("type"));
+        assertEquals("RU", tools.getJSONObject(0).getJSONObject("user_location").getString("country"));
+        List<String> names = new ArrayList<>();
+        for (int i = 1; i < tools.length(); i++) names.add(tools.getJSONObject(i).getString("name"));
+        assertEquals(List.of("open_app", "search_in_app", "set_volume", "vpn", "tv_action", "get_weather"), names);
+        JSONObject volume = tools.getJSONObject(3).getJSONObject("input_schema");
+        assertEquals("object", volume.getString("type"));
+        assertEquals("up", volume.getJSONObject("properties").getJSONObject("action").getJSONArray("enum").getString(0));
+        assertEquals("action", volume.getJSONArray("required").getString(0));
+
+        // The second request carries the whole first reply back (thinking included) and the tool's result.
+        JSONArray messages = requests.get(1).getJSONArray("messages");
+        assertEquals(3, messages.length());
+        JSONArray assistant = messages.getJSONObject(1).getJSONArray("content");
+        assertEquals("thinking", assistant.getJSONObject(0).getString("type"));
+        assertEquals("sig", assistant.getJSONObject(0).getString("signature"));
+        JSONObject result = messages.getJSONObject(2).getJSONArray("content").getJSONObject(0);
+        assertEquals("tool_result", result.getString("type"));
+        assertEquals("toolu_1", result.getString("tool_use_id"));
+        assertEquals("Открыто приложение YouTube.", result.getString("content"));
+    }
+
+    @Test
+    public void aFailingToolIsReportedAsAnError() throws Exception {
+        replies.add(new Object[]{200, message("tool_use",
+                "[{\"type\":\"tool_use\",\"id\":\"toolu_2\",\"name\":\"vpn\",\"input\":{\"action\":\"on\"}}]")});
+        replies.add(new Object[]{200, message("end_turn", "[{\"type\":\"text\",\"text\":\"Не вышло, сэр.\"}]")});
+        brain.ask("Включи VPN", "s", (name, input) -> {
+            throw new Exception("VPN-приложение не принимает команды");
+        });
+        JSONObject result = requests.get(1).getJSONArray("messages").getJSONObject(2).getJSONArray("content").getJSONObject(0);
+        assertTrue(result.getBoolean("is_error"));
+        assertTrue(result.getString("content").contains("не принимает команды"));
+    }
+
+    @Test
+    public void aPausedSearchIsResumedAndOnlyTheWordsAreSpoken() throws Exception {
+        replies.add(new Object[]{200, message("pause_turn",
+                "[{\"type\":\"server_tool_use\",\"id\":\"srvtoolu_1\",\"name\":\"web_search\",\"input\":{\"query\":\"курс доллара\"}}]")});
+        replies.add(new Object[]{200, message("end_turn",
+                "[{\"type\":\"web_search_tool_result\",\"tool_use_id\":\"srvtoolu_1\",\"content\":[{\"type\":\"web_search_result\","
+                        + "\"url\":\"https://cbr.ru\",\"title\":\"ЦБ\",\"encrypted_content\":\"x\",\"page_age\":null}]},"
+                        + "{\"type\":\"text\",\"text\":\"Курс — восемьдесят два рубля, сэр.\",\"citations\":null}]")});
+        String answer = brain.ask("Какой курс доллара?", "s", (n, i) -> "");
+        assertEquals("Курс — восемьдесят два рубля, сэр.", answer);
+        // Resumed with the paused turn as the last message and no extra user message.
+        JSONArray messages = requests.get(1).getJSONArray("messages");
+        assertEquals(2, messages.length());
+        assertEquals("assistant", messages.getJSONObject(1).getString("role"));
+    }
+
+    @Test
+    public void aRefusalIsAnEmptyAnswer() throws Exception {
+        replies.add(new Object[]{200, message("refusal", "[]")});
+        assertEquals("", brain.ask("?", "s", (n, i) -> ""));
+    }
+
+    @Test
+    public void troublesAreNamed() {
+        replies.add(new Object[]{401, "{\"type\":\"error\",\"error\":{\"type\":\"authentication_error\",\"message\":\"invalid x-api-key\"}}"});
+        expect(JarvisBrain.Trouble.Kind.KEY);
+        replies.add(new Object[]{403, "{\"type\":\"error\",\"error\":{\"type\":\"permission_error\",\"message\":\"Request not allowed\"}}"});
+        expect(JarvisBrain.Trouble.Kind.REGION);
+        replies.add(new Object[]{429, "{\"type\":\"error\",\"error\":{\"type\":\"rate_limit_error\",\"message\":\"slow down\"}}"});
+        expect(JarvisBrain.Trouble.Kind.BUSY);
+        replies.add(new Object[]{529, "{\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}"});
+        expect(JarvisBrain.Trouble.Kind.BUSY);
+    }
+
+    @Test
+    public void aFailedQuestionIsNotCarriedIntoTheNext() throws Exception {
+        replies.add(new Object[]{200, message("end_turn", "[{\"type\":\"text\",\"text\":\"Да, сэр.\"}]")});
+        brain.ask("Первый", "s", (n, i) -> "");
+        replies.add(new Object[]{529, "{\"type\":\"error\",\"error\":{\"type\":\"overloaded_error\",\"message\":\"Overloaded\"}}"});
+        expect(JarvisBrain.Trouble.Kind.BUSY);
+        replies.add(new Object[]{200, message("end_turn", "[{\"type\":\"text\",\"text\":\"Да, сэр.\"}]")});
+        brain.ask("Третий", "s", (n, i) -> "");
+        JSONArray messages = requests.get(2).getJSONArray("messages");
+        assertEquals(1, messages.length());
+        assertEquals("Третий", messages.getJSONObject(0).getString("content"));
+    }
+
+    @Test
+    public void aBlockFromANewerApiIsSpokenAroundNotFatal() throws Exception {
+        replies.add(new Object[]{200, message("end_turn",
+                "[{\"type\":\"text\",\"text\":\"Готово, сэр.\"},{\"type\":\"block_from_the_future\",\"x\":1}]")});
+        assertEquals("Готово, сэр.", brain.ask("Первый", "s", (n, i) -> ""));
+        replies.add(new Object[]{200, message("tool_use",
+                "[{\"type\":\"block_from_the_future\"},{\"type\":\"tool_use\",\"id\":\"t\",\"name\":\"vpn\",\"input\":{}}]")});
+        expect(JarvisBrain.Trouble.Kind.OTHER);
+        // Neither reply could be sent back, so each next question starts a new conversation.
+        replies.add(new Object[]{200, message("end_turn", "[{\"type\":\"text\",\"text\":\"Да.\"}]")});
+        brain.ask("Третий", "s", (n, i) -> "");
+        assertEquals(1, requests.get(1).getJSONArray("messages").length());
+        assertEquals(1, requests.get(2).getJSONArray("messages").length());
+    }
+
+    private void expect(JarvisBrain.Trouble.Kind kind) {
+        try {
+            brain.ask("?", "s", (n, i) -> "");
+            fail("no trouble");
+        } catch (JarvisBrain.Trouble t) {
+            assertEquals(kind, t.kind);
+        }
+    }
+
+    @Test
+    public void aLongTalkStartsAfreshNotEditsTheOldOne() throws Exception {
+        for (int i = 0; i < 7; i++) {
+            replies.add(new Object[]{200, message("end_turn", "[{\"type\":\"text\",\"text\":\"Да, сэр.\"}]")});
+            brain.ask("Вопрос " + i, "s", (n, in) -> "");
+        }
+        // Questions 1-6 grow one conversation; the seventh opens a new one rather than trimming the old.
+        assertEquals(11, requests.get(5).getJSONArray("messages").length());
+        assertEquals(1, requests.get(6).getJSONArray("messages").length());
+    }
+}
diff --git a/launcher/app/src/test/java/com/gathin/tvhome/JarvisPartsTest.java b/launcher/app/src/test/java/com/gathin/tvhome/JarvisPartsTest.java
new file mode 100644
index 0000000..7dff89e
--- /dev/null
+++ b/launcher/app/src/test/java/com/gathin/tvhome/JarvisPartsTest.java
@@ -0,0 +1,111 @@
+package com.gathin.tvhome;
+
+import static org.junit.Assert.assertArrayEquals;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import org.json.JSONObject;
+import org.junit.Test;
+
+import java.util.Arrays;
+import java.util.Base64;
+import java.util.List;
+
+public class JarvisPartsTest {
+
+    @Test
+    public void v3AudioJoinsTheChunksOfAStream() throws Exception {
+        String a = Base64.getEncoder().encodeToString(new byte[]{1, 2, 3});
+        String b = Base64.getEncoder().encodeToString(new byte[]{4, 5});
+        String body = "{\"result\":{\"audioChunk\":{\"data\":\"" + a + "\"},\"textChunk\":{\"text\":\"при{вет}\"}}}\n"
+                + "{\"result\":{\"lengthMs\":\"40\"}}\n"
+                + "{\"result\":{\"audioChunk\":{\"data\":\"" + b + "\"}}}";
+        assertArrayEquals(new byte[]{1, 2, 3, 4, 5}, SpeechKit.v3Audio(body));
+        // Also without line breaks, and with the chunk at the top level.
+        assertArrayEquals(new byte[]{1, 2, 3, 4, 5},
+                SpeechKit.v3Audio("{\"audioChunk\":{\"data\":\"" + a + "\"}}{\"audioChunk\":{\"data\":\"" + b + "\"}}"));
+    }
+
+    @Test
+    public void v3RequestNamesTheVoiceRoleAndRawPcm() throws Exception {
+        JSONObject r = new JSONObject(SpeechKit.v3Request("Добрый вечер, сэр.", "kirill", "strict", 1.0));
+        assertEquals("Добрый вечер, сэр.", r.getString("text"));
+        assertEquals("kirill", r.getJSONArray("hints").getJSONObject(0).getString("voice"));
+        assertEquals("strict", r.getJSONArray("hints").getJSONObject(1).getString("role"));
+        assertEquals(2, r.getJSONArray("hints").length());   // speed 1.0 is the default and is not sent
+        JSONObject raw = r.getJSONObject("outputAudioSpec").getJSONObject("rawAudio");
+        assertEquals("LINEAR16_PCM", raw.getString("audioEncoding"));
+        assertEquals(48000, raw.getInt("sampleRateHertz"));
+        assertEquals(1, new JSONObject(SpeechKit.v3Request("x", "filipp", "", 1.0)).getJSONArray("hints").length());
+    }
+
+    @Test
+    public void jsonObjectsIgnoreBracesInStrings() {
+        List<String> found = SpeechKit.jsonObjects("{\"a\":\"}{\"}\n{\"b\":{\"c\":1}} trailing");
+        assertEquals(Arrays.asList("{\"a\":\"}{\"}", "{\"b\":{\"c\":1}}"), found);
+    }
+
+    @Test
+    public void speechKitErrorsKeepTheirMessage() {
+        assertEquals("HTTP 401: Unknown api key", SpeechKit.errorMessage(401,
+                "{\"error_code\":\"UNAUTHORIZED\",\"error_message\":\"Unknown api key\"}"));
+        assertEquals("HTTP 502", SpeechKit.errorMessage(502, "<html>"));
+    }
+
+    @Test
+    public void appNamesMatchHowPeopleSayThem() {
+        List<String> apps = Arrays.asList("YouTube", "Кинопоиск: фильмы и сериалы", "Happ", "Aurora Store", "Браузер");
+        assertEquals("YouTube", AppMatch.best("youtube", apps));
+        assertEquals("Кинопоиск: фильмы и сериалы", AppMatch.best("Кинопоиск", apps));
+        assertEquals("Happ", AppMatch.best("Hap", apps));
+        assertNull(AppMatch.best("Okko", apps));
+        assertNull(AppMatch.best("", apps));
+    }
+
+    @Test
+    public void speechIsCleanedForTheVoice() {
+        // A link keeps its words and loses its address; a bare address goes entirely.
+        assertEquals("Курс доллара 82 рубля по данным ЦБ, сэр.",
+                JarvisSpeech.clean("**Курс доллара** 82 рубля по данным [ЦБ](https://cbr.ru), сэр. 💵 https://cbr.ru/x"));
+        assertEquals("Первое. Второе.", JarvisSpeech.clean("- Первое.\n- Второе."));
+        StringBuilder longText = new StringBuilder();
+        for (int i = 0; i < 60; i++) longText.append("Это предложение номер ").append(i).append(". ");
+        String cut = JarvisSpeech.clean(longText.toString());
+        assertTrue(cut.length() <= JarvisSpeech.MAX_CHARS);
+        assertTrue(cut.endsWith("."));
+    }
+
+    @Test
+    public void vadHearsAPhraseAndItsEnd() {
+        JarvisMic.Vad vad = new JarvisMic.Vad();
+        for (int i = 0; i < 20; i++) assertEquals(JarvisMic.Vad.WAITING, vad.feed(80));    // the room
+        assertEquals(JarvisMic.Vad.WAITING, vad.feed(3000));
+        assertEquals(JarvisMic.Vad.WAITING, vad.feed(3000));
+        assertEquals(JarvisMic.Vad.SPEAKING, vad.feed(3000));
+        for (int i = 0; i < 30; i++) assertEquals(JarvisMic.Vad.SPEAKING, vad.feed(2500));
+        int state = JarvisMic.Vad.SPEAKING;
+        for (int i = 0; i < 45; i++) state = vad.feed(90);
+        assertEquals(JarvisMic.Vad.DONE, state);
+    }
+
+    @Test
+    public void vadGivesUpOnSilenceAndIgnoresAClick() {
+        JarvisMic.Vad vad = new JarvisMic.Vad();
+        int state = JarvisMic.Vad.WAITING;
+        for (int i = 0; i < 400 && state == JarvisMic.Vad.WAITING; i++) state = vad.feed(i == 100 ? 9000 : 60);
+        assertEquals(JarvisMic.Vad.TIMEOUT, state);
+        assertTrue(!vad.heardVoice());
+    }
+
+    @Test
+    public void theRoomEffectKeepsLoudnessAndLength() {
+        short[] in = new short[4800];
+        for (int i = 0; i < in.length; i++) in[i] = (short) (Math.sin(i * 2 * Math.PI * 440 / 48000) * 10000);
+        short[] out = JarvisVoice.room(in, 48000);
+        assertEquals(in.length, out.length);
+        int peak = 0;
+        for (short s : out) peak = Math.max(peak, Math.abs(s));
+        assertTrue("peak " + peak, peak >= 9000 && peak <= 10100);
+    }
+}
