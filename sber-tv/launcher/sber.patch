@@ -0,0 +1,250 @@
+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.Path;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.graphics.drawable.AdaptiveIconDrawable;
+import android.graphics.drawable.Drawable;
+import android.os.Build;
+
+import androidx.annotation.NonNull;
+
+/**
+ * Sber edition: the dock's own icons, drawn at the tile's size so they stay sharp: Launcher settings (a gear on
+ * graphite) and All apps (a grid of tiles on indigo). Each fills
+ * its square; the tile's outline rounds the corners like the apps' icons beside them. Also the full-bleed form of an
+ * app's adaptive icon, its layers filling the tile instead of sitting in the system's circle.
+ */
+final class DockIcons {
+
+    private DockIcons() {
+    }
+
+    static Drawable settings(Context ctx) {
+        Drawable gear = ctx.getDrawable(R.drawable.ic_settings);
+        return new Glyph(0xFF9A9AA1, 0xFF4A4A50) {
+            @Override
+            void glyph(Canvas c, RectF b) {
+                if (gear == null) return;
+                gear.mutate().setTint(0xFFFFFFFF);
+                int size = Math.round(b.width() * 0.6f);
+                int l = Math.round(b.centerX() - size / 2f), t = Math.round(b.centerY() - size / 2f);
+                gear.setBounds(l, t, l + size, t + size);
+                gear.draw(c);
+            }
+        };
+    }
+
+    static Drawable allApps() {
+        return new Glyph(0xFF6E6BF2, 0xFF3A2FB8) {
+            private final Paint dot = new Paint(Paint.ANTI_ALIAS_FLAG);
+            private final RectF cell = new RectF();
+            private final int[] colours = {0xFFFFFFFF, 0xFFFFD60A, 0xFFFFFFFF, 0xFF64D2FF, 0xFFFFFFFF, 0xFFFF6482,
+                    0xFFFFFFFF, 0xFF7CF29C, 0xFFFFFFFF};
+
+            @Override
+            void glyph(Canvas c, RectF b) {
+                float span = b.width() * 0.56f, gap = span * 0.12f, size = (span - 2 * gap) / 3f;
+                float left = b.centerX() - span / 2f, top = b.centerY() - span / 2f, r = size * 0.3f;
+                for (int i = 0; i < 9; i++) {
+                    float x = left + (i % 3) * (size + gap), y = top + (i / 3) * (size + gap);
+                    cell.set(x, y, x + size, y + size);
+                    dot.setColor(colours[i]);
+                    dot.setAlpha(i % 2 == 0 ? 235 : 255);
+                    c.drawRoundRect(cell, r, r, dot);
+                }
+            }
+        };
+    }
+
+    /**
+     * Any app icon as a phone's rounded square: an adaptive icon's layers filling it (fullBleed), any other icon on a
+     * plate of its own colour carried out to the edges (AppAdapter.backdrop), as the icon dock draws them. Works out
+     * the plate by drawing the icon small, so call it off the main thread where it can be.
+     */
+    static Drawable squircle(Drawable icon) {
+        Drawable full = fullBleed(icon);
+        if (full != null) return full;
+        float share = AppAdapter.DOCK_ICON_SHARE;
+        return new Plated(icon, AppAdapter.backdrop(icon, AppAdapter.dominantColor(icon), share), share);
+    }
+
+    /**
+     * An adaptive icon with its layers filling the tile, as the icons on a phone's home screen do: the layers are
+     * 108 units across with the visible 72 in the middle, so they are drawn half as big again as the tile and the
+     * tile's rounded outline cuts them. Null for any other drawable, which the tile draws on a plate of its colour.
+     */
+    static Drawable fullBleed(Drawable icon) {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.O || !(icon instanceof AdaptiveIconDrawable)) return null;
+        AdaptiveIconDrawable adaptive = (AdaptiveIconDrawable) icon;
+        Drawable back = adaptive.getBackground(), front = adaptive.getForeground();
+        if (back == null && front == null) return null;
+        return new Drawable() {
+            private final Rect layer = new Rect();
+            private final Paint white = new Paint();
+            private final Path corners = new Path();
+
+            @Override
+            public void draw(@NonNull Canvas c) {
+                Rect b = getBounds();
+                int extra = Math.round(b.width() * 0.25f);
+                layer.set(b.left - extra, b.top - extra, b.right + extra, b.bottom + extra);
+                c.save();
+                c.clipPath(rounded(corners, b));
+                // A transparent background layer reads as the white of a phone's icon.
+                white.setColor(0xFFFFFFFF);
+                c.drawRect(b, white);
+                if (back != null) {
+                    back.setBounds(layer);
+                    back.draw(c);
+                }
+                if (front != null) {
+                    front.setBounds(layer);
+                    front.draw(c);
+                }
+                c.restore();
+            }
+
+            @Override
+            public void setAlpha(int alpha) {
+            }
+
+            @Override
+            public void setColorFilter(ColorFilter filter) {
+            }
+
+            @Override
+            public int getOpacity() {
+                return PixelFormat.OPAQUE;
+            }
+        };
+    }
+
+    /** An icon centred on a rounded square plate of two colours, top and bottom. */
+    private static final class Plated extends Drawable {
+        private final Drawable icon;
+        private final int[] plate;
+        private final float share;
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Path corners = new Path();
+        private final Rect inner = new Rect();
+
+        Plated(Drawable icon, int[] plate, float share) {
+            this.icon = icon == null ? null : icon.mutate();
+            this.plate = plate;
+            this.share = share;
+        }
+
+        @Override
+        protected void onBoundsChange(@NonNull Rect b) {
+            fill.setShader(new LinearGradient(0, b.top, 0, b.bottom, plate[0], plate[1], Shader.TileMode.CLAMP));
+        }
+
+        @Override
+        public void draw(@NonNull Canvas c) {
+            Rect b = getBounds();
+            if (b.width() <= 0) return;
+            c.save();
+            c.clipPath(rounded(corners, b));
+            c.drawRect(b, fill);
+            if (icon != null) {
+                int size = Math.round(b.width() * share);
+                inner.set(b.centerX() - size / 2, b.centerY() - size / 2, b.centerX() + size / 2, b.centerY() + size / 2);
+                icon.setBounds(inner);
+                icon.draw(c);
+            }
+            c.restore();
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+        }
+
+        @Override
+        public void setColorFilter(ColorFilter filter) {
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;
+        }
+    }
+
+    /**
+     * A phone icon's rounded square in b: drawn rounded here too, not only cut by the tile's outline, which a frame
+     * drawn in software (and a scaling tile's layer) does not clip to.
+     */
+    static Path rounded(Path path, Rect b) {
+        float r = AppAdapter.squircleRadius(b.width());
+        path.reset();
+        path.addRoundRect(b.left, b.top, b.right, b.bottom, r, r, Path.Direction.CW);
+        return path;
+    }
+
+    /** A square filled with a diagonal gradient, a soft sheen across its top and a white glyph in the middle. */
+    abstract static class Glyph extends Drawable {
+        private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final Paint sheen = new Paint(Paint.ANTI_ALIAS_FLAG);
+        private final RectF box = new RectF();
+        private final Path corners = new Path();
+        private int top, bottom;
+
+        Glyph(int top, int bottom) {
+            this.top = top;
+            this.bottom = bottom;
+        }
+
+        void setColours(int top, int bottom) {
+            this.top = top;
+            this.bottom = bottom;
+            onBoundsChange(getBounds());
+            invalidateSelf();
+        }
+
+        abstract void glyph(Canvas c, RectF bounds);
+
+        @Override
+        protected void onBoundsChange(@NonNull Rect b) {
+            fill.setShader(new LinearGradient(b.left, b.top, b.right, b.bottom, top, bottom, Shader.TileMode.CLAMP));
+            sheen.setShader(new LinearGradient(0, b.top, 0, b.top + b.height() * 0.5f, 0x33FFFFFF, 0x00FFFFFF,
+                    Shader.TileMode.CLAMP));
+        }
+
+        @Override
+        public void draw(@NonNull Canvas c) {
+            Rect b = getBounds();
+            if (b.width() <= 0 || b.height() <= 0) return;
+            c.save();
+            c.clipPath(rounded(corners, b));
+            c.drawRect(b, fill);
+            c.drawRect(b.left, b.top, b.right, b.top + b.height() * 0.5f, sheen);
+            box.set(b);
+            glyph(c, box);
+            c.restore();
+        }
+
+        @Override
+        public void setAlpha(int alpha) {
+            fill.setAlpha(alpha);
+            invalidateSelf();
+        }
+
+        @Override
+        public void setColorFilter(ColorFilter filter) {
+            fill.setColorFilter(filter);
+            invalidateSelf();
+        }
+
+        @Override
+        public int getOpacity() {
+            return PixelFormat.TRANSLUCENT;   // the rounded corners
+        }
+    }
+}
