+    /** Open-Meteo's place search, off the main thread; every match is listed, since one name can be many villages. */
+    private void findPlaces(String query) {
+        String q = query.trim();
+        if (q.isEmpty()) return;
+        worker.execute(() -> {
+            List<String[]> found = new ArrayList<>();
+            boolean failed = false;
+            try {
+                String language = Locale.getDefault().getLanguage();
+                String body = get("https://geocoding-api.open-meteo.com/v1/search?count=100&format=json&language="
+                        + URLEncoder.encode(language, "UTF-8") + "&name=" + URLEncoder.encode(q, "UTF-8"));
+                JSONArray results = new JSONObject(body).optJSONArray("results");
+                for (int i = 0; results != null && i < results.length(); i++) {
+                    JSONObject p = results.getJSONObject(i);
+                    List<String> parts = new ArrayList<>();
+                    for (String key : new String[]{"admin1", "admin2", "country"}) {
+                        String part = p.optString(key, "").trim();
+                        if (!part.isEmpty() && !parts.contains(part) && !part.equals(p.optString("name"))) parts.add(part);
+                    }
+                    double lat = p.getDouble("latitude"), lon = p.getDouble("longitude");
+                    found.add(new String[]{p.optString("name", q), TextUtils.join(", ", parts)
+                            + String.format(Locale.ROOT, " · %.2f, %.2f", lat, lon), String.valueOf(lat), String.valueOf(lon)});
+                }
+            } catch (IOException | org.json.JSONException e) {
+                failed = true;
+            }
+            boolean error = failed;
+            main.post(() -> {
+                if (isFinishing()) return;
+                if (error || found.isEmpty()) {
+                    Toast.makeText(this, error ? R.string.weather_search_failed : R.string.weather_search_none,
+                            Toast.LENGTH_LONG).show();
+                    return;
+                }
+                push(() -> placesPage(found));
+            });
         });
