diff --git a/launcher/app/src/main/res/raw/phone_link.html b/launcher/app/src/main/res/raw/phone_link.html
new file mode 100644
index 0000000..a071157
--- /dev/null
+++ b/launcher/app/src/main/res/raw/phone_link.html
@@ -0,0 +1,141 @@
+<!doctype html>
+<html lang="ru">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Домашний экран ТВ</title>
+<style>
+  :root { color-scheme: dark; }
+  body { margin: 0; background: #0b0c10; color: #f2f2f7; font: 17px/1.45 -apple-system, "Segoe UI", Roboto, sans-serif; }
+  main { max-width: 560px; margin: 0 auto; padding: 28px 16px 48px; }
+  h1 { font-size: 28px; margin: 0 0 4px; letter-spacing: -0.02em; }
+  p.lead { color: #a1a1aa; margin: 0 0 24px; }
+  section { background: #17181d; border: 1px solid #25262c; border-radius: 18px; padding: 18px; margin-bottom: 18px; }
+  h2 { font-size: 19px; margin: 0 0 6px; }
+  .hint { color: #a1a1aa; font-size: 15px; margin: 0 0 14px; }
+  button, .pick { display: block; width: 100%; box-sizing: border-box; border: 0; border-radius: 14px; padding: 14px;
+    font: inherit; font-weight: 600; text-align: center; background: #f2f2f7; color: #0b0c10; cursor: pointer; }
+  button.secondary { background: #2a2b31; color: #f2f2f7; }
+  input[type=file] { display: none; }
+  input[type=text] { width: 100%; box-sizing: border-box; padding: 13px 14px; border-radius: 12px; border: 1px solid #33343b;
+    background: #0f1014; color: #f2f2f7; font: inherit; margin-bottom: 10px; }
+  ul { list-style: none; padding: 0; margin: 12px 0 0; }
+  li { padding: 10px 0; border-top: 1px solid #25262c; font-size: 15px; display: flex; justify-content: space-between; gap: 12px; }
+  li.place { cursor: pointer; }
+  li.place:active { background: #22232a; }
+  li span:last-child { text-align: right; }
+  a.muted { color: #8ab4ff; }
+  .ok { color: #7ee2a8; } .err { color: #ff8a80; } .muted { color: #a1a1aa; }
+</style>
+</head>
+<body>
+<main>
+  <h1>Домашний экран ТВ</h1>
+  <p class="lead">Телефон и телевизор должны быть в одной сети Wi-Fi. Страница работает, пока на ТВ открыт экран с QR-кодом.</p>
+
+  <section>
+    <h2>Обои</h2>
+    <p class="hint">Выберите одно или несколько фото: они станут обоями главного экрана. Лучше горизонтальные.</p>
+    <label class="pick" for="photos">Выбрать фото</label>
+    <input id="photos" type="file" accept="image/*" multiple>
+    <ul id="sent"></ul>
+  </section>
+
+  <section>
+    <h2>Погода</h2>
+    <p class="hint">Город или посёлок. Одинаковых названий бывает много: проверьте место по ссылке «на карте» и нажмите на нужное.</p>
+    <input id="city" type="text" placeholder="Например: Глухово" autocomplete="off">
+    <button class="secondary" id="find">Найти</button>
+    <ul id="places"></ul>
+  </section>
+</main>
+<script>
+const base = location.pathname.replace(/\/$/, '');
+const sent = document.getElementById('sent');
+
+function row(list, text, cls) {
+  const li = document.createElement('li');
+  const a = document.createElement('span'); a.textContent = text;
+  const b = document.createElement('span'); b.className = cls || 'muted';
+  li.append(a, b); list.append(li); return b;
+}
+
+// The picture is shrunk on the phone to a TV screen (1920x1080, cropped to fill it), so it travels in a second.
+async function shrink(file) {
+  let source;
+  try { source = await createImageBitmap(file, { imageOrientation: 'from-image' }); }
+  catch (e) {
+    source = await new Promise((ok, fail) => {
+      const img = new Image(); img.onload = () => ok(img); img.onerror = fail; img.src = URL.createObjectURL(file);
+    });
+  }
+  const W = 1920, H = 1080, sw = source.width, sh = source.height;
+  const scale = Math.max(W / sw, H / sh), w = sw * scale, h = sh * scale;
+  const canvas = document.createElement('canvas'); canvas.width = W; canvas.height = H;
+  canvas.getContext('2d').drawImage(source, (W - w) / 2, (H - h) / 2, w, h);
+  return await new Promise(ok => canvas.toBlob(ok, 'image/jpeg', 0.9));
+}
+
+document.getElementById('photos').addEventListener('change', async e => {
+  for (const file of e.target.files) {
+    const state = row(sent, file.name, 'muted');
+    state.textContent = 'отправляю…';
+    try {
+      let body;
+      try { body = await shrink(file); } catch (err) { body = file; }   // the TV shrinks it then
+      const r = await fetch(base + '/photo', { method: 'POST', body });
+      if (!r.ok) throw new Error(r.status);
+      state.textContent = 'на ТВ'; state.className = 'ok';
+    } catch (err) {
+      state.textContent = 'не получилось'; state.className = 'err';
+    }
+  }
+  e.target.value = '';
+});
+
+const places = document.getElementById('places');
+async function find() {
+  const q = document.getElementById('city').value.trim();
+  places.innerHTML = '';
+  if (!q) return;
+  const wait = row(places, 'Ищу…');
+  try {
+    const url = 'https://geocoding-api.open-meteo.com/v1/search?count=100&language=ru&format=json&name=' + encodeURIComponent(q);
+    const data = await (await fetch(url)).json();
+    places.innerHTML = '';
+    const found = data.results || [];
+    if (!found.length) { row(places, 'Ничего не нашлось. Попробуйте написать иначе.', 'err'); return; }
+    for (const p of found) {
+      const parts = [p.admin1, p.admin2, p.country].filter((x, i, all) => x && all.indexOf(x) === i && x !== p.name);
+      const li = document.createElement('li'); li.className = 'place';
+      const a = document.createElement('span'); a.textContent = p.name;
+      const b = document.createElement('span'); b.className = 'muted';
+      b.append(parts.join(', ') + ' · ');
+      const map = document.createElement('a'); map.textContent = 'на карте'; map.target = '_blank'; map.className = 'muted';
+      map.href = 'https://yandex.ru/maps/?pt=' + p.longitude + ',' + p.latitude + '&z=12&l=map';
+      map.onclick = e => e.stopPropagation();
+      b.append(map);
+      li.append(a, b);
+      li.onclick = async () => {
+        places.innerHTML = '';
+        const state = row(places, p.name + (parts.length ? ', ' + parts[0] : ''));
+        state.textContent = 'отправляю…';
+        try {
+          const r = await fetch(base + '/place', { method: 'POST',
+            body: JSON.stringify({ lat: p.latitude, lon: p.longitude, name: p.name }) });
+          if (!r.ok) throw new Error(r.status);
+          state.textContent = 'погода на ТВ'; state.className = 'ok';
+        } catch (err) { state.textContent = 'не получилось'; state.className = 'err'; }
+      };
+      places.append(li);
+    }
+  } catch (err) {
+    places.innerHTML = '';
+    row(places, 'Нет связи с поиском мест. Проверьте интернет на телефоне.', 'err');
+  }
+}
+document.getElementById('find').onclick = find;
+document.getElementById('city').addEventListener('keydown', e => { if (e.key === 'Enter') find(); });
+</script>
+</body>
+</html>
