+    private void selectSection(int index) {
+        if (index == section && !pages.isEmpty()) return;
+        stopLink();
+        section = index;
+        pages.clear();
+        Runnable build;
+        switch (index) {
+            case 0: build = this::wallpaperPage; break;
+            case 1: build = this::homePage; break;
+            case 2: build = this::weatherPage; break;
+            case 3: build = this::languagePage; break;
+            case 4: build = this::screensaverPage; break;
+            default: build = this::systemPage; break;
+        }
+        pages.push(new Page(build));
+        run(build);
+        paintSidebar();
+    }
