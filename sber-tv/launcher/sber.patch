+    static final String PREFIX = "live:";
+    static final String AURORA = "aurora", SPHERES = "spheres", SPACE = "space", SUNSET = "sunset";
+    static final String[] SCENES = {AURORA, SPHERES, SPACE, SUNSET};
+
+    static boolean isLive(String choice) {
+        if (choice == null || !choice.startsWith(PREFIX)) return false;
+        String scene = choice.substring(PREFIX.length());
+        for (String s : SCENES) if (s.equals(scene)) return true;
+        return false;
+    }
+
+    static String scene(String choice) {
+        return choice.substring(PREFIX.length());
+    }
+
+    /** The scene's name in Launcher settings. */
+    static int nameRes(String scene) {
+        switch (scene) {
+            case AURORA: return R.string.live_aurora;
+            case SPHERES: return R.string.live_spheres;
+            case SPACE: return R.string.live_space;
+            default: return R.string.live_sunset;
+        }
+    }
