+ * day, grey under cloud, deep navy at night) with the place, the temperature large, the conditions, today's highest
+ * and lowest, and the next five hours. Display only; it never takes focus.
+ */
+final class WeatherWidget extends LinearLayout {
+
+    static final int HOURS = 5;
+
+    private final float density;
+    private final TextView place, temperature, conditions, range;
+    private final ImageView icon;
+    private final LinearLayout hours;
+    private final GradientDrawable card;
+
