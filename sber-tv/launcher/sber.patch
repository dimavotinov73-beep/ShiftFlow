+package com.gathin.tvhome;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.graphics.Shader;
+import android.view.View;
+
+/**
+ * Sber edition: the icon dock's glass shelf, a view of its own behind the scrolling row of apps and the All apps icon
+ * pinned at its right end, with a thin divider between the two. MainActivity.centreDock sizes and places it. The row
+ * is clipped to its window, the shelf is not, so its rounded ends always show.
+ */
+final class DockShelf extends View {
+
+    private final Paint fill = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint edge = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint divider = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final RectF box = new RectF();
+    private final float density;
+    private float radius;
+    /** The divider's x in this view, or a negative number for none. */
+    private float dividerX = -1;
+
+    DockShelf(Context ctx) {
+        super(ctx);
+        density = ctx.getResources().getDisplayMetrics().density;
+        edge.setStyle(Paint.Style.STROKE);
+        edge.setStrokeWidth(density);
+        edge.setColor(0x47FFFFFF);
+        divider.setStyle(Paint.Style.STROKE);
+        divider.setStrokeWidth(1.5f * density);
+        divider.setStrokeCap(Paint.Cap.ROUND);
+        divider.setColor(0x59FFFFFF);
+        setImportantForAccessibility(IMPORTANT_FOR_ACCESSIBILITY_NO);
+        setFocusable(false);
+    }
+
+    /** Corners concentric with the icons': theirs plus the shelf's padding. */
+    void setRadius(float px) {
+        if (radius == px) return;
+        radius = px;
+        invalidate();
+    }
+
+    void setDivider(float x) {
+        if (dividerX == x) return;
+        dividerX = x;
+        invalidate();
+    }
+
+    @Override
+    protected void onSizeChanged(int w, int h, int oldw, int oldh) {
+        super.onSizeChanged(w, h, oldw, oldh);
+        fill.setShader(new LinearGradient(0, 0, 0, h, 0x3DFFFFFF, 0x1FFFFFFF, Shader.TileMode.CLAMP));
+    }
+
+    @Override
+    protected void onDraw(Canvas c) {
+        float half = edge.getStrokeWidth() / 2f;
+        box.set(half, half, getWidth() - half, getHeight() - half);
+        c.drawRoundRect(box, radius, radius, fill);
+        c.drawRoundRect(box, radius, radius, edge);
+        if (dividerX > 0) {
+            float inset = getHeight() * 0.24f;
+            c.drawLine(dividerX, inset, dividerX, getHeight() - inset, divider);
+        }
+    }
+}
