+
+/**
+ * remote_keys.json next to the theme: the remote's buttons this TV's owner remapped with {@code sber-tv.sh keys}, as
+ * {"app_keys": ["scan:401:none", "scan:582:com.yandex.tv.alice"]}, in the app_keys syntax (RemoteKeys). A file of its
+ * own rather than keys in config.json: writing it leaves the theme's file, and so the choices made on the TV, alone,
+ * and a theme push from the phone does not wipe the buttons. Its entries come after the theme's, so they win.
+ */
+final class RemoteKeyFile {
+
+    static final String FILE_NAME = "remote_keys.json";
+
+    private RemoteKeyFile() {
+    }
+
+    /** The theme's app_keys followed by this file's; the theme's alone when the file is missing or unreadable. */
+    static List<String> merged(Context ctx, List<String> themeKeys) {
+        List<String> all = new ArrayList<>(themeKeys);
+        File dir = Config.dir(ctx);
+        all.addAll(entries(dir == null ? null : Config.read(new File(dir, FILE_NAME))));
+        return all;
+    }
+
+    static List<String> entries(JSONObject json) {
+        List<String> found = new ArrayList<>();
+        JSONArray keys = json == null ? null : json.optJSONArray("app_keys");
+        if (keys == null) return found;
+        for (int i = 0; i < keys.length(); i++) {
+            String entry = keys.optString(i, "").trim();
+            if (!entry.isEmpty()) found.add(entry);
+        }
+        return found;
+    }
+}
